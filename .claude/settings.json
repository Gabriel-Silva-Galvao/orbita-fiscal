{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/lembrar-claude-md.py\"",
            "timeout": 15,
            "statusMessage": "Conferindo o CLAUDE.md"
          }
        ]
      }
    ]
  }
}
