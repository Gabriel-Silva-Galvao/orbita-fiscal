# Copie para .env e preencha quando cada integração existir.
# Sem estas variáveis, as páginas rodam em modo de demonstração.

# API do backend em Python/FastAPI (só no servidor, nunca vai para o navegador).
# Com ela definida, /conta, /instalar e /app ficam fechadas: o middleware chama
# GET {API_URL}/auth/sessao com o cookie da pessoa (200 = abre; 401/403 = vai para /entrar).
# Sem ela, essas rotas abrem em modo de demonstração.
# Desenvolvimento com a API local (etapa 7b): API_URL=http://localhost:8000
API_URL=

# Autenticação (Entrar): base da API de login em FastAPI, chamada pelo navegador com cookie.
# Google ou e-mail e senha, sempre com verificação em duas etapas por código no e-mail:
#   POST /cadastro {nome, email, senha, plano} | POST /login {email, senha}  -> 202 código enviado
#   POST /codigo {codigo} -> 200 sessão | POST /codigo/reenviar | POST /senha/esqueci {email}
#   GET /google?modo=&next= -> OAuth; na volta envia o código e abre /entrar?etapa=codigo
# Contrato completo no topo de src/pages/entrar.astro.
# Desenvolvimento com a API local (etapa 7b): PUBLIC_AUTH_ENDPOINT=http://localhost:8000/auth
# (e, na API, SITE_URL=http://localhost:4321 e AUTH_CODIGO_NA_RESPOSTA=true para ver o código na tela).
PUBLIC_AUTH_ENDPOINT=

# Pagamento (Checkout): nome do provedor escolhido. Com ele definido, o Checkout sai da demonstração
# e precisa ser ligado aos campos seguros e à API do provedor (ver src/pages/assinar/[plano].astro).
PUBLIC_PAYMENT_PROVIDER=

# Formulário de contato: POST JSON {nome, email, assunto, mensagem, consentimento}.
# Sem ele, o envio abre o e-mail da pessoa com a mensagem pronta.
PUBLIC_CONTACT_ENDPOINT=
