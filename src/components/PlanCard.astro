---
/**
 * Card de plano (item 25 da rodada de testes, 25/11/2026). Inspirado nas páginas de planos da Anthropic e do
 * ChatGPT: card sempre branco (também no modo escuro), texto quase preto, uma cor de destaque só no plano em
 * evidência, preço grande, botão e a lista com ✓. Itens "a definir" aparecem em cinza.
 */
import type { Plan } from '../data/plans';
import { brl } from '../data/plans';

interface Props {
  plan: Plan;
  badge?: string;
}
const { plan, badge } = Astro.props;
const preco = brl(plan.cents);
const [inteiro, centavos] = preco.replace('R$ ', '').split(',');
---

<article class:list={['plan', { 'plan-featured': plan.featured }]} aria-labelledby={`plan-${plan.slug}`}>
  {plan.featured && badge && <span class="plan-badge">{badge}</span>}
  <h3 class="plan-name" id={`plan-${plan.slug}`}>{plan.name}</h3>
  <p class="plan-tag">{plan.tagline}</p>
  <p class="plan-price" aria-label={`${preco} por mês`}>
    <span class="plan-cur" aria-hidden="true">R$</span>
    <span class="plan-value" aria-hidden="true">{inteiro}</span>
    {centavos && <span class="plan-cents" aria-hidden="true">,{centavos}</span>}
    <span class="plan-per" aria-hidden="true">/mês</span>
  </p>
  <a class="plan-cta" href={`/assinar/${plan.slug}`} aria-label={`Assinar o ${plan.name}, ${preco} por mês`}>
    Assinar o {plan.name}
  </a>
  <ul class="plan-items">
    {
      plan.items.map((it) => (
        <li class:list={{ 'is-pending': it.pending }}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>
            {it.text}
            {it.pending && <span class="plan-pend">{it.pending === 'definir' ? 'a definir' : 'a confirmar'}</span>}
          </span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  /* Paleta própria do card: sempre branco, nos dois temas do site. */
  .plan {
    --pc-bg: #ffffff;
    --pc-ink: #111827;
    --pc-mute: #6b7280;
    --pc-line: #e5e7eb;
    --pc-accent: #10634f;
    --pc-accent-ink: #ffffff;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--pc-bg);
    color: var(--pc-ink);
    border: 1px solid var(--pc-line);
    border-radius: 20px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    transition:
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 260ms;
  }
  .plan:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.16);
  }
  .plan-featured {
    border: 2px solid var(--pc-accent);
    box-shadow: 0 12px 32px rgb(16 99 79 / 0.18);
  }
  .plan-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--pc-accent);
    color: var(--pc-accent-ink);
    font: 600 0.75rem/1.4 var(--font-body, inherit);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .plan-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.2;
    color: var(--pc-ink);
  }
  .plan-tag {
    margin: 0;
    min-height: 2.6em;
    color: var(--pc-mute);
    font-size: 0.9375rem;
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin: var(--space-2) 0;
    font-variant-numeric: tabular-nums;
  }
  .plan-cur {
    font-size: 1rem;
    font-weight: 600;
    margin-right: 4px;
    align-self: flex-start;
    margin-top: 0.55em;
  }
  .plan-value {
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .plan-cents {
    font-size: 1.375rem;
    font-weight: 600;
  }
  .plan-per {
    margin-left: 6px;
    color: var(--pc-mute);
    font-size: 0.9375rem;
  }
  .plan-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    border-radius: 12px;
    border: 1.5px solid var(--pc-ink);
    color: var(--pc-ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 180ms,
      color 180ms;
  }
  .plan-cta:hover {
    background: var(--pc-ink);
    color: var(--pc-bg);
  }
  .plan-cta:focus-visible {
    outline: 3px solid var(--pc-accent);
    outline-offset: 2px;
  }
  .plan-featured .plan-cta {
    background: var(--pc-accent);
    border-color: var(--pc-accent);
    color: var(--pc-accent-ink);
  }
  .plan-featured .plan-cta:hover {
    background: #0b4a3b;
  }
  .plan-items {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--pc-line);
    display: grid;
    gap: 10px;
  }
  .plan-items li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .plan-items svg {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--pc-accent);
  }
  .plan-items li.is-pending {
    color: var(--pc-mute);
  }
  .plan-items li.is-pending svg {
    color: #9ca3af;
  }
  .plan-pend {
    display: inline-block;
    margin-left: 6px;
    padding: 0 6px;
    border: 1px dashed #9ca3af;
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--pc-mute);
    vertical-align: 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .plan,
    .plan-cta {
      transition: none;
    }
    .plan:hover {
      transform: none;
    }
  }
</style>
