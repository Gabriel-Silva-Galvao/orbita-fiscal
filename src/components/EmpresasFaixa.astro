---
/**
 * Faixa de planos empresariais (item 26), abaixo dos três planos e na página /empresas.
 * O botão abre o contato animado (ContatoEmpresarial.astro, que precisa estar na mesma página).
 */
interface Props {
  /** Na página /empresas, o link "Saiba mais" não aparece (já estamos nela). */
  saibaMais?: boolean;
}
const { saibaMais = true } = Astro.props;

const vantagens = [
  'Vários usuários numa só conta',
  'Uma cobrança e nota fiscal para a empresa',
  'Condições sob medida para o tamanho da equipe',
  'Conversa com a equipe para a implantação',
];
---

<div class="emp">
  <div class="emp-cab">
    <p class="emp-k"><span class="emp-dot" aria-hidden="true"></span>Empresarial</p>
    <h3 class="emp-t">Para escritórios, contabilidades e empresas</h3>
    <p class="emp-sub">A Órbita para a equipe inteira, com uma conta e uma cobrança.</p>
  </div>
  <ul class="emp-lista">
    {vantagens.map((v) => <li>{v}</li>)}
  </ul>
  <div class="emp-acoes">
    <p class="emp-preco">Preço sob consulta</p>
    <button type="button" class="emp-btn" data-contato-empresarial>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      Entre em contato para mais informações
    </button>
    {saibaMais && <a class="emp-link" href="/empresas">Saiba mais sobre o plano Empresarial</a>}
  </div>
</div>

<style>
  /* Item 34: no formato do Team/Enterprise do Claude: mesma família dos cards, largura toda, sem preço, contato em destaque. */
  .emp {
    position: relative;
    display: grid;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-5);
    padding: var(--space-6);
    border-radius: 20px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgb(16 99 79 / 0.1), transparent 55%),
      #ffffff;
    color: #111827;
    border: 2px solid #10634f;
    box-shadow: 0 12px 32px rgb(16 99 79 / 0.18);
  }
  @media (min-width: 1000px) {
    .emp {
      grid-template-columns: 1.1fr 1.2fr auto;
      gap: var(--space-6);
    }
  }
  .emp-k {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #10634f;
    font: 600 0.8125rem/1.4 var(--font-body, inherit);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .emp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10634f;
    box-shadow: 0 0 0 4px rgb(16 99 79 / 0.15);
  }
  .emp-t {
    margin: 6px 0 6px;
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.2;
    color: #111827;
    text-wrap: balance;
  }
  .emp-sub {
    margin: 0;
    color: #6b7280;
    font-size: 0.9375rem;
  }
  .emp-lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    color: #374151;
    font-size: 0.9375rem;
  }
  .emp-lista li {
    display: flex;
    gap: 10px;
  }
  .emp-lista li::before {
    content: '✓';
    color: #10634f;
    font-weight: 700;
  }
  .emp-acoes {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }
  .emp-preco {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: #111827;
  }
  .emp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 12px;
    background: #10634f;
    color: #ffffff;
    font: 600 1rem/1.25 var(--font-body, inherit);
    cursor: pointer;
    box-shadow: 0 8px 20px rgb(16 99 79 / 0.3);
    transition:
      transform 200ms,
      background-color 200ms,
      box-shadow 200ms;
  }
  .emp-btn svg {
    flex: none;
    width: 20px;
    height: 20px;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .emp-btn:hover {
    background: #0b4a3b;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgb(16 99 79 / 0.38);
  }
  .emp-btn:hover svg {
    transform: rotate(-12deg) scale(1.15);
  }
  .emp-btn:focus-visible {
    outline: 3px solid #10634f;
    outline-offset: 3px;
  }
  @media (max-width: 999px) {
    .emp-acoes {
      justify-items: stretch;
    }
  }
  .emp-link {
    color: #374151;
    font-size: 0.875rem;
  }
</style>
