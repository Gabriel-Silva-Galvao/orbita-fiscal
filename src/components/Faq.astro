---
/**
 * Perguntas frequentes: uma aberta por vez; a primeira começa aberta.
 * Item 30 da rodada de testes (26/11/2026): refeito para tirar o bug do "+" e deixar abrir e fechar suaves.
 * - Sem JavaScript: <details> comum, que abre e fecha na hora.
 * - Com JavaScript: os <details> ficam sempre abertos por baixo e o estado é nosso (data-estado no <details> e
 *   aria-expanded no <summary>), aplicado NO CLIQUE: o "+" gira junto com o conteúdo, nunca depois.
 * - A altura anima só em CSS (grade de 0fr para 1fr), com a mesma curva e duração para abrir e fechar.
 * - Clique durante a animação é ignorado; quando a pergunta que fecha está acima, a página compensa a rolagem
 *   para a pergunta clicada não sair do lugar.
 * - Movimento reduzido: abre e fecha sem animação.
 */
interface Props {
  name?: string;
}
const { name = 'faq' } = Astro.props;
---

<div class="faq" data-faq={name}>
  <slot />
</div>

<style>
  .faq {
    --faq-dur: 300ms;
    --faq-ease: cubic-bezier(0.22, 1, 0.36, 1);
    border-top: 1px solid var(--line);
  }
  .faq :global(details) {
    border-bottom: 1px solid var(--line);
  }
  .faq :global(summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 22px 0;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 26px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition: color 200ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .faq :global(summary:hover) {
    color: var(--brand);
  }
  .faq :global(summary:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .faq :global(summary::-webkit-details-marker) {
    display: none;
  }
  /* O "+" é desenhado com duas barras: a vertical some ao abrir e vira "−", sem girar o glifo. */
  .faq :global(summary::after) {
    content: '';
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-round);
    border: 1px solid var(--line-strong);
    background:
      linear-gradient(var(--brand), var(--brand)) center / 12px 2px no-repeat,
      linear-gradient(var(--brand), var(--brand)) center / 2px 12px no-repeat;
    transition:
      background-size var(--faq-dur) var(--faq-ease),
      background-color var(--faq-dur) var(--faq-ease),
      border-color var(--faq-dur) var(--faq-ease),
      transform var(--faq-dur) var(--faq-ease);
  }
  /* Aberta: sem JS, pelo atributo open; com JS, pelo nosso estado. */
  :global(html:not(.js)) .faq :global(details[open] summary::after),
  .faq :global(details[data-estado='aberto'] summary::after) {
    transform: rotate(180deg);
    background:
      linear-gradient(var(--on-brand), var(--on-brand)) center / 12px 2px no-repeat,
      linear-gradient(var(--on-brand), var(--on-brand)) center / 2px 0 no-repeat;
    background-color: var(--brand);
    border-color: var(--brand);
  }

  .faq :global(.faq-a p) {
    margin: 0;
    padding: 0 0 22px;
    max-width: 720px;
    font: var(--text-body);
    font-size: 15px;
    line-height: 24px;
    color: var(--mute);
  }
  .faq :global(.faq-a a) {
    color: var(--brand);
  }

  /* Com JS: a resposta é uma grade que vai de 0fr a 1fr; o conteúdo entra com fade e um leve deslize. */
  .faq :global(details[data-estado] .faq-a) {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--faq-dur) var(--faq-ease);
  }
  .faq :global(details[data-estado] .faq-a > .faq-dentro) {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity calc(var(--faq-dur) * 0.7) var(--faq-ease),
      transform var(--faq-dur) var(--faq-ease);
  }
  .faq :global(details[data-estado='aberto'] .faq-a) {
    grid-template-rows: 1fr;
  }
  .faq :global(details[data-estado='aberto'] .faq-a > .faq-dentro) {
    opacity: 1;
    transform: none;
    transition-delay: 60ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq {
      --faq-dur: 0ms;
    }
  }
</style>

<script>
  const reduzido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const itens = Array.from(root.querySelectorAll<HTMLDetailsElement>(':scope > details'));
    const dur = () => (reduzido() ? 0 : 300);
    let ocupado = false;

    // Prepara cada pergunta: conteúdo dentro de um invólucro (para a grade animar) e o estado inicial.
    itens.forEach((d) => {
      const corpo = d.querySelector<HTMLElement>('.faq-a');
      const sum = d.querySelector<HTMLElement>('summary');
      if (!corpo || !sum) return;
      const dentro = document.createElement('div');
      dentro.className = 'faq-dentro';
      dentro.append(...Array.from(corpo.childNodes));
      corpo.append(dentro);
      const aberto = d.open;
      d.dataset.estado = aberto ? 'aberto' : 'fechado';
      d.open = true; // por baixo, sempre aberto: quem mostra ou esconde é a grade
      sum.setAttribute('aria-expanded', String(aberto));
      corpo.id ||= `${root.dataset.faq}-r${itens.indexOf(d)}`;
      sum.setAttribute('aria-controls', corpo.id);
      dentro.inert = !aberto; // links da resposta fechada não recebem o foco
    });

    const definir = (d: HTMLDetailsElement, aberto: boolean) => {
      d.dataset.estado = aberto ? 'aberto' : 'fechado';
      d.querySelector('summary')!.setAttribute('aria-expanded', String(aberto));
      const dentro = d.querySelector<HTMLElement>('.faq-dentro');
      if (dentro) dentro.inert = !aberto;
    };

    itens.forEach((d) => {
      const sum = d.querySelector<HTMLElement>('summary');
      sum?.addEventListener('click', (e) => {
        e.preventDefault();
        if (ocupado) return; // clique no meio da animação: ignora
        const abrindo = d.dataset.estado !== 'aberto';
        const outra = abrindo ? itens.find((o) => o !== d && o.dataset.estado === 'aberto') : undefined;
        // A pergunta clicada não pode "fugir" quando uma aberta acima dela fecha.
        const compensar = !!outra && outra.compareDocumentPosition(d) & Node.DOCUMENT_POSITION_FOLLOWING;
        const topoAntes = sum.getBoundingClientRect().top;

        ocupado = true;
        if (outra) definir(outra, false);
        definir(d, abrindo);

        const fim = performance.now() + dur() + 40;
        const seguir = () => {
          if (compensar) {
            const desvio = sum.getBoundingClientRect().top - topoAntes;
            if (Math.abs(desvio) > 0.5) window.scrollBy({ top: desvio, behavior: 'instant' as ScrollBehavior });
          }
          if (performance.now() < fim) requestAnimationFrame(seguir);
        };
        if (compensar) requestAnimationFrame(seguir);
        window.setTimeout(() => (ocupado = false), dur() + 40);
      });
    });

    // O endereço abre a pergunta certa (/ajuda#conectar): fecha as outras e abre a do #.
    const doEndereco = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const alvo = id ? itens.find((d) => d.id === id) : undefined;
      if (!alvo) return;
      itens.forEach((d) => definir(d, d === alvo));
    };
    doEndereco();
    addEventListener('hashchange', () => {
      doEndereco();
      const id = decodeURIComponent(location.hash.slice(1));
      const alvo = id ? itens.find((d) => d.id === id) : undefined;
      if (alvo) ((window as any).__lenis?.scrollTo(alvo, { offset: -110 }) ?? alvo.scrollIntoView({ block: 'start' }));
    });
  });
</script>
