  .pt-conteudo :global(.kv > div) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font: var(--text-small);
    font-size: 0.9375rem;
  }
  .pt-conteudo :global(.kv span) {
    color: var(--mute);
  }
  .pt-conteudo :global(.kv strong) {
    font-weight: 600;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  .pt-conteudo :global(.acoes) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .pt-conteudo :global(.acoes .btn-main),
  .pt-conteudo :global(.acoes .btn-alt),
  .pt-conteudo :global(.cartao .btn-main),
  .pt-conteudo :global(.cartao .btn-alt) {
    width: auto;
  }
  .pt-conteudo :global(.vazio) {
