---
/**
 * Portal do cliente (briefing, Página 5): quatro abas, endereçáveis por #plugin, #plano,
 * #cancelar e #conta. Em modo de demonstração, lê a assinatura que o Checkout gravou neste
 * navegador. Cancelar e pedir reembolso são ações separadas, com o prazo de 7 dias à vista.
 */
import Focus from '../layouts/Focus.astro';
import Pending from '../components/Pending.astro';
import { plans, brl } from '../data/plans';

const planData = JSON.stringify(
  Object.fromEntries(Object.values(plans).map((p) => [p.slug, { name: p.name, price: brl(p.cents) }])),
);
const tabs = [
  { id: 'plugin', label: 'Plugin' },
  { id: 'plano', label: 'Plano e pagamento' },
  { id: 'cancelar', label: 'Cancelar ou reembolso' },
  { id: 'conta', label: 'Conta' },
];
---

<Focus title="Minha conta · Órbita Fiscal" description="Baixe o plugin, veja seu plano, notas fiscais, cancele ou peça reembolso.">
  <div class="wrap portal" data-portal data-plans={planData}>
    <p class="demo"><strong>Modo de demonstração.</strong> Os dados abaixo existem só neste navegador. Nada é cobrado nem devolvido de verdade.</p>

    <section class="empty-state" data-no-sub hidden>
      <h1 class="display-md">Você ainda não tem um plano ativo</h1>
      <p class="mute">Escolha o Pro ou o Max para começar. O reembolso é integral em até 7 dias.</p>
      <div class="row-actions">
        <a class="btn-main" href="/#planos">Ver planos</a>
        <a class="btn-alt" href="/entrar">Já assinei: entrar</a>
      </div>
    </section>

    <div data-has-sub hidden>
      <header class="portal-head">
        <div>
          <h1 class="display-md">Minha conta</h1>
          <p class="mute small" data-who></p>
        </div>
        <a class="small" href="/ajuda">Ajuda</a>
      </header>

      <p class="notice" data-banner role="status" hidden></p>

      <div class="tabs" role="tablist" aria-label="Seções da conta">
        {tabs.map((t, i) => (
          <a role="tab" id={`tab-${t.id}`} href={`#${t.id}`} aria-controls={`p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.label}</a>
        ))}
      </div>

      <section id="p-plugin" role="tabpanel" aria-labelledby="tab-plugin" class="panel" data-panel="plugin">
        <div class="kv">
          <div><span>Versão atual</span><strong><Pending kind="definir" /></strong></div>
          <div><span>Funciona com</span><strong>Claude</strong></div>
        </div>
        <div class="row-actions">
          <a class="btn-main" href="/instalar">Baixar e instalar de novo</a>
        </div>
        <h2 class="title">O que mudou na base</h2>
        <p class="empty small">
          Quando a base ou o plugin mudarem, a novidade aparece aqui com a data. A frequência de atualização da base<Pending kind="definir" />.
        </p>
      </section>

      <section id="p-plano" role="tabpanel" aria-labelledby="tab-plano" class="panel" data-panel="plano" hidden>
        <div class="kv">
          <div><span>Plano</span><strong data-plan></strong></div>
          <div><span>Assinante desde</span><strong data-since></strong></div>
          <div><span>Próxima cobrança</span><strong data-next></strong></div>
          <div><span>Forma de pagamento</span><strong data-method></strong></div>
        </div>
        <div class="row-actions">
          <a class="btn-alt" data-switch href="/assinar/max"></a>
        </div>
        <p class="small mute">Como fica a cobrança ao trocar de plano no meio do mês<Pending kind="definir" />.</p>
        <h2 class="title">Notas fiscais</h2>
        <p class="empty small">A nota de cada cobrança aparece aqui para baixar<Pending kind="definir" />.</p>
      </section>

      <section id="p-cancelar" role="tabpanel" aria-labelledby="tab-cancelar" class="panel" data-panel="cancelar" hidden>
        <article class="action-card">
          <h2 class="title">Pedir reembolso</h2>
          <p data-refund-text></p>
          <div data-refund-actions></div>
          <ol class="track" data-refund-track hidden>
            <li class="is-on">Pedido recebido <span data-refund-date></span></li>
            <li>Em processamento no provedor de pagamento</li>
            <li>Valor devolvido</li>
          </ol>
        </article>
        <article class="action-card">
          <h2 class="title">Cancelar a assinatura</h2>
          <p data-cancel-text></p>
          <div data-cancel-actions></div>
        </article>
        <p class="small mute">Regras completas na <a href="/reembolso">Política de reembolso</a> e nos <a href="/termos#cancelamento">Termos de uso</a>.</p>
      </section>

      <section id="p-conta" role="tabpanel" aria-labelledby="tab-conta" class="panel" data-panel="conta" hidden>
        <form class="account-form" data-name-form novalidate>
          <div class="field">
            <label for="p-nome">Nome</label>
            <input id="p-nome" name="nome" autocomplete="name" />
          </div>
          <button type="submit" class="btn-alt">Salvar nome</button>
          <p class="small mute" data-name-msg role="status"></p>
        </form>
        <div class="kv">
          <div><span>E-mail</span><strong data-email></strong></div>
          <div><span>Acesso</span><strong>Google ou link por e-mail</strong></div>
        </div>
        <p class="small mute">Para trocar o e-mail, confirmamos o novo endereço com um link<Pending kind="definir" />.</p>
        <div class="row-actions">
          <button type="button" class="btn-alt" data-logout>Sair</button>
        </div>
        <article class="action-card danger">
          <h2 class="title">Excluir conta</h2>
          <p class="small">Apaga sua conta e seus dados, menos o que a lei manda guardar (como dados fiscais). Não dá para desfazer. Se houver assinatura ativa, ela é cancelada.</p>
          <div class="field">
            <label for="p-confirm">Para confirmar, digite EXCLUIR</label>
            <input id="p-confirm" autocomplete="off" />
          </div>
          <button type="button" class="btn-alt" data-delete disabled>Excluir minha conta</button>
        </article>
      </section>
    </div>
  </div>
</Focus>

<style>
  .portal {
    max-width: 820px;
    display: grid;
    gap: var(--space-5);
  }
  /* Itens da grade podem encolher: a linha de abas rola por dentro, sem alargar a página. */
  .portal > * {
    min-width: 0;
  }
  .empty-state {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .portal-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .portal-head a {
    color: var(--brand);
  }
  .tabs {
    display: flex;
    gap: var(--space-5);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs a {
    flex: none;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font: 500 0.9375rem/1.2 var(--font-body);
    color: var(--mute);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .tabs a[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--brand);
  }
  .tabs a:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
  .panel {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
  }
  .panel .title {
    margin-top: var(--space-3);
  }
  .kv {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .kv div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font: var(--text-small);
    font-size: 0.9375rem;
  }
  .kv span {
    color: var(--mute);
  }
  .kv strong {
    font-weight: 600;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  .row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .row-actions .btn-main,
  .row-actions .btn-alt,
  .action-card .btn-main,
  .action-card .btn-alt,
  .account-form .btn-alt {
    width: auto;
  }
  .empty {
    padding: var(--space-4);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--mute);
  }
  .action-card {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .action-card .title {
    margin: 0;
  }
  .action-card > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .action-card.danger {
    border-color: var(--line-strong);
  }
  .action-card .field {
    width: min(100%, 320px);
  }
  .track {
    padding-left: 1.25rem;
    display: grid;
    gap: 6px;
    font: var(--text-small);
    color: var(--mute);
  }
  .track .is-on {
    color: var(--ink);
    font-weight: 600;
  }
  .account-form {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .account-form .field {
    width: min(100%, 420px);
  }
  .portal a:not(.btn-main):not(.btn-alt):not([role='tab']) {
    color: var(--brand);
  }
</style>

<script>
  import { getSub, saveSub, daysSince, fmtDate, nextCharge, type DemoSub } from '../scripts/demo';

  const root = document.querySelector<HTMLElement>('[data-portal]')!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const plans = JSON.parse(root.dataset.plans ?? '{}') as Record<string, { name: string; price: string }>;
  let sub = getSub();

  const btn = (text: string, cls: string, onClick: () => void) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = cls;
    b.textContent = text;
    b.addEventListener('click', onClick);
    return b;
  };
  const update = (patch: Partial<DemoSub>) => {
    sub = { ...(sub as DemoSub), ...patch };
    saveSub(sub);
    render();
  };

  // Abas com endereço (#plugin, #plano, #cancelar, #conta)
  const tabEls = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  function selectTab(id: string, focus = false) {
    if (!tabEls.some((t) => t.dataset.tab === id)) id = 'plugin';
    tabEls.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
  }
  tabEls.forEach((t, i) => {
    t.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${t.dataset.tab}`);
      selectTab(t.dataset.tab!);
    });
    t.addEventListener('keydown', (e) => {
      const n = e.key === 'ArrowRight' ? (i + 1) % tabEls.length : e.key === 'ArrowLeft' ? (i - 1 + tabEls.length) % tabEls.length : -1;
      if (n < 0) return;
      e.preventDefault();
      history.replaceState(null, '', `#${tabEls[n].dataset.tab}`);
      selectTab(tabEls[n].dataset.tab!, true);
    });
  });
  addEventListener('hashchange', () => selectTab(location.hash.slice(1)));

  function render() {
    $('[data-no-sub]').hidden = !!sub;
    $('[data-has-sub]').hidden = !sub;
    if (!sub) return;
    const plan = plans[sub.plano];
    const other = sub.plano === 'max' ? 'pro' : 'max';
    const since = new Date(sub.desde);
    const next = nextCharge(sub.desde);
    const days = daysSince(sub.desde);
    const refundUntil = new Date(since.getTime() + 7 * 86400000);

    $('[data-who]').textContent = `${sub.nome ? sub.nome + ' · ' : ''}${sub.email}`;
    $('[data-plan]').textContent = `${plan.name}, ${plan.price} por mês`;
    $('[data-since]').textContent = fmtDate(since);
    $('[data-next]').textContent = sub.cancelada || sub.reembolso ? 'Nenhuma' : fmtDate(next);
    $('[data-method]').textContent = sub.metodo === 'pix' ? 'Pix' : `Cartão final ${sub.final || '••••'}`;
    const sw = $<HTMLAnchorElement>('[data-switch]');
    sw.href = `/assinar/${other}`;
    sw.textContent = `Trocar para o ${plans[other].name} (${plans[other].price} por mês)`;
    $('[data-email]').textContent = sub.email;
    $<HTMLInputElement>('#p-nome').value = sub.nome ?? '';

    // Faixa de estado
    const banner = $('[data-banner]');
    banner.hidden = true;
    if (sub.reembolso) {
      banner.className = 'notice';
      banner.textContent = `Reembolso solicitado em ${fmtDate(new Date(sub.reembolso))}. Acompanhe na aba Cancelar ou reembolso.`;
      banner.hidden = false;
    } else if (sub.cancelada) {
      banner.className = 'notice';
      banner.textContent = `Assinatura cancelada. Seu acesso segue até ${fmtDate(next)}.`;
      banner.hidden = false;
    }

    // Reembolso
    const rText = $('[data-refund-text]');
    const rAct = $('[data-refund-actions]');
    rAct.replaceChildren();
    $('[data-refund-track]').hidden = !sub.reembolso;
    if (sub.reembolso) {
      rText.textContent = 'Recebemos seu pedido. O valor integral volta pela mesma forma de pagamento.';
      $('[data-refund-date]').textContent = `em ${fmtDate(new Date(sub.reembolso))}`;
    } else if (days <= 7) {
      const left = 7 - days;
      rText.textContent = `Você pode pedir o reembolso integral até ${fmtDate(refundUntil)} (${left === 0 ? 'último dia' : `faltam ${left} ${left === 1 ? 'dia' : 'dias'}`}). Não precisa explicar o motivo.`;
      const ask = btn('Pedir reembolso', 'btn-main', () => {
        rAct.replaceChildren(
          btn('Confirmar pedido de reembolso', 'btn-main', () => update({ reembolso: new Date().toISOString() })),
          btn('Voltar', 'btn-alt', render),
        );
        (rAct.firstElementChild as HTMLElement).focus();
      });
      rAct.append(ask);
    } else {
      rText.textContent = `O prazo de 7 dias terminou em ${fmtDate(refundUntil)}. Você ainda pode cancelar abaixo, sem multa.`;
    }

    // Cancelamento
    const cText = $('[data-cancel-text]');
    const cAct = $('[data-cancel-actions]');
    cAct.replaceChildren();
    if (sub.reembolso) {
      cText.textContent = 'Com o reembolso, a assinatura é encerrada. Não há nada a cancelar.';
    } else if (sub.cancelada) {
      cText.textContent = `Cancelada em ${fmtDate(new Date(sub.cancelada))}. O acesso segue até ${fmtDate(next)} e não haverá nova cobrança.`;
      cAct.append(btn('Reativar a assinatura', 'btn-alt', () => update({ cancelada: undefined })));
    } else {
      cText.textContent = `A assinatura para de renovar e seu acesso continua até ${fmtDate(next)}. Sem multa.`;
      cAct.append(
        btn('Cancelar assinatura', 'btn-alt', () => {
          cAct.replaceChildren(
            btn('Confirmar cancelamento', 'btn-main', () => update({ cancelada: new Date().toISOString() })),
            btn('Manter assinatura', 'btn-alt', render),
          );
          (cAct.firstElementChild as HTMLElement).focus();
        }),
      );
    }
  }

  // Conta
  $<HTMLFormElement>('[data-name-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    update({ nome: $<HTMLInputElement>('#p-nome').value.trim() });
    $('[data-name-msg]').textContent = 'Nome salvo.';
  });
  $('[data-logout]').addEventListener('click', () => {
    try {
      sessionStorage.removeItem('of-demo-email');
    } catch {}
    location.href = '/entrar';
  });
  const confirmInput = $<HTMLInputElement>('#p-confirm');
  const del = $<HTMLButtonElement>('[data-delete]');
  confirmInput.addEventListener('input', () => (del.disabled = confirmInput.value.trim().toUpperCase() !== 'EXCLUIR'));
  del.addEventListener('click', () => {
    saveSub(null);
    try {
      sessionStorage.removeItem('of-demo-email');
      localStorage.removeItem('of-demo-instalacao');
    } catch {}
    sub = null;
    render();
    $('[data-no-sub] h1').textContent = 'Sua conta foi excluída';
  });

  render();
  selectTab(location.hash.slice(1) || 'plugin');
</script>
