---
/**
 * Portal do cliente (briefing, Página 5): abas endereçáveis por #plugin, #novidades, #plano,
 * #cancelar e #conta. Em modo de demonstração, lê a assinatura que o Checkout gravou neste
 * navegador. Cancelar e pedir reembolso são ações separadas, com o prazo de 7 dias à vista.
 */
import Focus from '../layouts/Focus.astro';
import Pending from '../components/Pending.astro';
import { plans, brl } from '../data/plans';
import { novidades, ORIGENS } from '../data/novidades';
import { tutoriais } from '../data/tutoriais';
import { contact } from '../data/site';

const authEndpoint = import.meta.env.PUBLIC_AUTH_ENDPOINT ?? '';
// Com a API ligada, o middleware já conferiu a sessão e deixou o usuário aqui.
const usuario = Astro.locals.usuario;
// Etapa 7d: com PUBLIC_BILLING_ENDPOINT, o Portal lê e altera a assinatura pela API.
const billing = import.meta.env.PUBLIC_BILLING_ENDPOINT ?? '';
const dataBr = (iso: string) => iso.split('-').reverse().join('/');

// Rota do assinante: roda no servidor, atrás do middleware de sessão (src/middleware.ts).
export const prerender = false;

const planData = JSON.stringify(
  Object.fromEntries(Object.values(plans).map((p) => [p.slug, { name: p.name, price: brl(p.cents) }])),
);
const tabs = [
  { id: 'plugin', label: 'Status do plugin' },
  { id: 'novidades', label: 'Novidades' },
  { id: 'tutoriais', label: 'Tutoriais' },
  { id: 'alertas', label: 'Alertas por tema', max: true },
  { id: 'resumo', label: 'Resumo semanal', max: true },
  { id: 'plano', label: 'Plano e pagamento' },
  { id: 'cancelar', label: 'Cancelar ou reembolso' },
  { id: 'suporte', label: 'Suporte' },
  { id: 'conta', label: 'Conta' },
];
---

<Focus title="Minha conta · Órbita" description="Baixe o plugin, veja seu plano, notas fiscais, cancele ou peça reembolso.">
  <div class="wrap portal" data-portal data-plans={planData} data-auth-endpoint={authEndpoint} data-billing={billing} data-user-email={usuario?.email ?? ''} data-user-name={usuario?.nome ?? ''}>
    <p class="demo"><strong>Modo de demonstração.</strong> Os dados abaixo existem só neste navegador. Nada é cobrado nem devolvido de verdade.</p>

    <section class="empty-state" data-no-sub hidden>
      <h1 class="display-md">Você ainda não tem um plano ativo</h1>
      <p class="mute" data-no-sub-text>Escolha o Pro ou o Max para começar.</p>
      {usuario && <p class="mute small">Você entrou como <strong>{usuario.email}</strong>.</p>}
      <div class="row-actions">
        <a class="btn-main" href="/#planos" data-no-sub-cta>Ver planos</a>
        {usuario
          ? <button type="button" class="btn-alt" data-logout>Sair</button>
          : <a class="btn-alt" href="/entrar">Já assinei: entrar</a>}
      </div>
    </section>

    <div data-has-sub hidden>
      <header class="portal-head">
        <div>
          <h1 class="display-md">Minha conta</h1>
          <p class="mute small" data-who></p>
        </div>
        <a class="small" href="/ajuda">Ajuda</a>
      </header>

      <p class="notice" data-banner role="status" hidden></p>

      <div class="tabs" role="tablist" aria-label="Seções da conta">
        {tabs.map((t, i) => (
          <a role="tab" id={`tab-${t.id}`} href={`#${t.id}`} aria-controls={`p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>
            {t.label}
            {t.id === 'novidades' && <span class="badge" data-news-badge hidden></span>}
            {t.max && <>{' '}<span class="max-tag">Max</span></>}
          </a>
        ))}
      </div>

      <section id="p-plugin" role="tabpanel" aria-labelledby="tab-plugin" class="panel" data-panel="plugin">
        <div class="stats">
          <article class="stat">
            <span class="stat-k">Acesso</span>
            <strong class="stat-v" data-access></strong>
            <span class="stat-n" data-access-note></span>
          </article>
          <article class="stat">
            <span class="stat-k">Consultas neste mês</span>
            <strong class="stat-v" data-usage>0</strong>
            <span class="stat-n">Limite do plano<Pending kind="definir" /></span>
          </article>
          <article class="stat">
            <span class="stat-k">Última consulta</span>
            <strong class="stat-v" data-last>Nenhuma ainda</strong>
            <span class="stat-n">Aparece depois da primeira pergunta no Claude</span>
          </article>
          <article class="stat">
            <span class="stat-k">Versão do plugin</span>
            <strong class="stat-v"><Pending kind="definir" /></strong>
          </article>
        </div>

        <h2 class="title">Conexões</h2>
        <ul class="conn">
          <li>
            <span class="conn-ia">Claude</span>
            <span class="conn-state" data-conn-claude></span>
            <a href="/instalar" data-conn-claude-link></a>
          </li>
          {tutoriais.filter((t) => !t.disponivel).map((t) => (
            <li>
              <span class="conn-ia">{t.nome}</span>
              <span class="conn-state">Em preparação</span>
              <a href={`#tutoriais`} data-goto="tutoriais" data-ia={t.id}>Como vai funcionar</a>
            </li>
          ))}
        </ul>
        <div class="row-actions">
          <a class="btn-main" href="/instalar">Baixar e instalar de novo</a>
        </div>
        {novidades[0] && (
          <p class="small mute">
            Última novidade, em {dataBr(novidades[0].data)}: {novidades[0].titulo}.{' '}<a href="#novidades" data-goto="novidades">Ver todas</a>
          </p>
        )}
      </section>

      <section id="p-novidades" role="tabpanel" aria-labelledby="tab-novidades" class="panel" data-panel="novidades" hidden>
        <p class="mute small">
          Bases novas, melhorias do plugin e mudanças no Claude e nas outras IAs que afetam a Órbita, sempre com a data.
          A frequência de atualização da base<Pending kind="definir" />.
        </p>
        <div class="filters" role="group" aria-label="Filtrar novidades">
          <button type="button" aria-pressed="true" data-filter="todas">Todas</button>
          {Object.entries(ORIGENS).map(([k, v]) => (
            <button type="button" aria-pressed="false" data-filter={k}>{v}</button>
          ))}
        </div>
        <ol class="news" data-news>
          {novidades.map((n) => (
            <li data-origem={n.origem} data-id={n.id}>
              <p class="news-meta">
                <time datetime={n.data}>{dataBr(n.data)}</time> · {ORIGENS[n.origem]}
                {n.max && <span class="max-tag">Acesso antecipado do Max</span>}
                <span class="new-tag" data-new hidden>Nova</span>
              </p>
              <h2 class="news-title">{n.titulo}</h2>
              <p class="small">{n.texto}</p>
            </li>
          ))}
        </ol>
        <p class="empty small" data-news-empty hidden>
          Nenhuma novidade nesta categoria ainda. Quando o Claude ou outra IA mudar algo que afete plugins, aparece aqui.
        </p>
      </section>

      <section id="p-tutoriais" role="tabpanel" aria-labelledby="tab-tutoriais" class="panel" data-panel="tutoriais" hidden>
        <p class="mute small">O plugin é o mesmo em todas as IAs; muda o caminho para instalar. Escolha a sua.</p>
        <div class="filters" role="group" aria-label="Escolher a IA">
          {tutoriais.map((t, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-ia-pick={t.id}>{t.nome}</button>
          ))}
        </div>
        {tutoriais.map((t, i) => (
          <article class="tut" data-tut={t.id} hidden={i !== 0}>
            <header class="tut-head">
              <h2 class="news-title">{t.nome}</h2>
              <span class:list={['tut-state', t.disponivel ? 'is-on' : '']}>{t.disponivel ? 'Disponível' : 'Em preparação'}</span>
            </header>
            <p class="small"><strong>Quem instala:</strong> {t.quem}</p>
            <p class="small"><strong>O que precisa:</strong> {t.requisitos}</p>
            <ol class="tut-steps">
              {t.passos.map((p) => <li>{p}</li>)}
            </ol>
            <p class="small mute">{t.observacao}</p>
            {t.disponivel && <a class="btn-main" href="/instalar">Abrir o passo a passo completo</a>}
          </article>
        ))}
      </section>

      <section id="p-alertas" role="tabpanel" aria-labelledby="tab-alertas" class="panel" data-panel="alertas" hidden>
        <div class="locked" data-locked>
          <h2 class="news-title">Alertas por tema, no plano Max</h2>
          <p class="small">Salve os temas que você acompanha, como ICMS-ST ou crédito de PIS/Cofins. Quando sair julgado ou norma nova sobre eles, avisamos aqui e por e-mail.</p>
          <a class="btn-main" href="/assinar/max">Conhecer o Max</a>
        </div>
        <div class="unlocked" data-unlocked hidden>
          <p class="mute small">Salve os temas que você acompanha. Quando sair julgado ou norma nova sobre eles, avisamos aqui e por e-mail<Pending kind="confirmar" />.</p>
          <form class="theme-form" data-theme-form novalidate>
            <div class="field">
              <label for="p-tema">Novo tema</label>
              <input id="p-tema" maxlength="60" placeholder="Ex.: crédito de PIS/Cofins sobre frete" aria-describedby="p-tema-msg" />
              <p class="msg" id="p-tema-msg" aria-live="polite"></p>
            </div>
            <button type="submit" class="btn-alt">Salvar tema</button>
          </form>
          <p class="small mute">Sugestões:</p>
          <div class="filters" data-theme-suggest>
            {['ICMS-ST', 'Exclusão do ICMS do PIS/Cofins', 'Prescrição intercorrente', 'Reforma tributária (IBS e CBS)'].map((s) => (
              <button type="button" data-suggest={s}>+ {s}</button>
            ))}
          </div>
          <h2 class="title">Seus temas</h2>
          <ul class="chips" data-themes></ul>
          <p class="empty small" data-themes-empty>Nenhum tema salvo ainda.</p>
          <p class="empty small">Os alertas aparecem aqui quando houver decisão ou norma nova sobre os seus temas.</p>
        </div>
      </section>

      <section id="p-resumo" role="tabpanel" aria-labelledby="tab-resumo" class="panel" data-panel="resumo" hidden>
        <div class="locked" data-locked>
          <h2 class="news-title">Resumo semanal, no plano Max</h2>
          <p class="small">Toda semana, as decisões e normas mais relevantes das áreas que você escolher, aqui e por e-mail.</p>
          <a class="btn-main" href="/assinar/max">Conhecer o Max</a>
        </div>
        <div class="unlocked" data-unlocked hidden>
          <p class="mute small">Escolha as áreas. O resumo chega toda semana<Pending kind="confirmar" />, aqui e por e-mail.</p>
          <fieldset class="areas" data-areas>
            <legend class="sr-only">Áreas do resumo</legend>
            {['Tributário federal', 'ICMS e estaduais', 'ISS e municipais', 'Previdenciário', 'Processo tributário', 'Reforma tributária (IBS e CBS)'].map((a) => (
              <label class="area"><input type="checkbox" value={a} /> {a}</label>
            ))}
          </fieldset>
          <p class="small mute" data-areas-msg role="status"></p>
          <p class="empty small">O primeiro resumo aparece aqui na semana seguinte à escolha das áreas.</p>
        </div>
      </section>

      <section id="p-plano" role="tabpanel" aria-labelledby="tab-plano" class="panel" data-panel="plano" hidden>
        <div class="kv">
          <div><span>Plano</span><strong data-plan></strong></div>
          <div><span>Assinante desde</span><strong data-since></strong></div>
          <div><span>Próxima cobrança</span><strong data-next></strong></div>
          <div><span>Forma de pagamento</span><strong data-method></strong></div>
        </div>
        <div class="row-actions">
          <a class="btn-alt" data-switch href="/assinar/max"></a>
        </div>
        <p class="small mute">Como fica a cobrança ao trocar de plano no meio do mês<Pending kind="definir" />.</p>
        <h2 class="title">Notas fiscais</h2>
        <p class="empty small">A nota de cada cobrança aparece aqui para baixar<Pending kind="definir" />.</p>
      </section>

      <section id="p-cancelar" role="tabpanel" aria-labelledby="tab-cancelar" class="panel" data-panel="cancelar" hidden>
        <article class="action-card">
          <h2 class="title">Pedir reembolso</h2>
          <p data-refund-text></p>
          <div data-refund-actions></div>
          <ol class="track" data-refund-track hidden>
            <li class="is-on">Pedido recebido <span data-refund-date></span></li>
            <li>Em processamento no provedor de pagamento</li>
            <li>Valor devolvido</li>
          </ol>
        </article>
        <article class="action-card">
          <h2 class="title">Cancelar a assinatura</h2>
          <p data-cancel-text></p>
          <div data-cancel-actions></div>
        </article>
        <p class="small mute">Regras completas na <a href="/reembolso">Política de reembolso</a> e nos <a href="/termos#cancelamento">Termos de uso</a>.</p>
      </section>

      <section id="p-suporte" role="tabpanel" aria-labelledby="tab-suporte" class="panel" data-panel="suporte" hidden>
        <div class="kv">
          <div>
            <span>E-mail do suporte</span>
            <strong class="copy-inline">
              <span data-support-email>{contact.email}</span><Pending kind="confirmar" />
              <button type="button" class="link-btn" data-copy-email>Copiar</button>
            </strong>
          </div>
          <div><span>Prazo de resposta</span><strong data-sla></strong></div>
          <div><span>Atendimento</span><strong>Dias úteis<Pending kind="confirmar" /></strong></div>
        </div>
        <p class="small mute">Para agilizar, diga em qual IA você usa a Órbita e, se houver, a mensagem de erro que apareceu.</p>
        <div class="row-actions">
          <a class="btn-main" href="/ajuda#contato">Escrever para a equipe</a>
          <a class="btn-alt" href="/ajuda">Ver a Ajuda</a>
        </div>

        <article class="action-card" data-onboarding hidden>
          <h2 class="title">Conversa de implantação</h2>
          <p class="small">No Max, uma conversa curta com a equipe para configurar a Órbita no seu escritório e mostrar as pesquisas que mais rendem no dia a dia.</p>
          <a class="btn-alt" href="/ajuda#contato">Pedir a conversa</a>
        </article>
        <article class="locked" data-onboarding-pro hidden>
          <p class="small"><strong>No Max, o suporte é prioritário</strong> e inclui uma conversa de implantação com a equipe.</p>
          <a class="btn-alt" href="/assinar/max">Conhecer o Max</a>
        </article>
      </section>

      <section id="p-conta" role="tabpanel" aria-labelledby="tab-conta" class="panel" data-panel="conta" hidden>
        <form class="account-form" data-name-form novalidate>
          <div class="field">
            <label for="p-nome">Nome</label>
            <input id="p-nome" name="nome" autocomplete="name" />
          </div>
          <button type="submit" class="btn-alt">Salvar nome</button>
          <p class="small mute" data-name-msg role="status"></p>
        </form>
        <div class="kv">
          <div><span>E-mail</span><strong data-email></strong></div>
          <div><span>Acesso</span><strong>E-mail e senha, com código por e-mail</strong></div>
        </div>
        <p class="small mute">Para trocar o e-mail, confirmamos o novo endereço com um link<Pending kind="definir" />.</p>
        <div class="row-actions">
          <button type="button" class="btn-alt" data-logout>Sair</button>
        </div>
        <article class="action-card danger">
          <h2 class="title">Excluir conta</h2>
          <p class="small">Apaga sua conta e seus dados, menos o que a lei manda guardar (como dados fiscais). Não dá para desfazer. Se houver assinatura ativa, cancele antes na aba Cancelar ou reembolso, para não haver nova cobrança.</p>
          <div class="field">
            <label for="p-confirm">Para confirmar, digite EXCLUIR</label>
            <input id="p-confirm" autocomplete="off" />
          </div>
          <button type="button" class="btn-alt" data-delete disabled>Excluir minha conta</button>
          <p class="small" data-delete-msg role="alert"></p>
        </article>
      </section>
    </div>
  </div>
</Focus>

<style>
  .portal {
    max-width: 820px;
    display: grid;
    gap: var(--space-5);
  }
  /* Itens da grade podem encolher: a linha de abas rola por dentro, sem alargar a página. */
  .portal > * {
    min-width: 0;
  }
  .empty-state {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .portal-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .portal-head a {
    color: var(--brand);
  }
  .tabs {
    display: flex;
    gap: var(--space-5);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs a {
    flex: none;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font: 500 0.9375rem/1.2 var(--font-body);
    color: var(--mute);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .tabs a[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--brand);
  }
  .tabs a:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
  .panel {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
  }
  .panel .title {
    margin-top: var(--space-3);
  }
  .kv {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .kv div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font: var(--text-small);
    font-size: 0.9375rem;
  }
  .kv span {
    color: var(--mute);
  }
  .kv strong {
    font-weight: 600;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  /* Novidades */
  .badge {
    display: inline-block;
    min-width: 20px;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-brand);
    font: 600 0.75rem/1.4 var(--font-body);
    text-align: center;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters button {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font: 500 0.875rem/1 var(--font-body);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .filters button:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
  .news {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .news li {
    display: grid;
    gap: 6px;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font: var(--text-small);
    font-size: 0.8125rem;
    color: var(--mute);
  }
  .news-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .new-tag,
  .max-tag {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font: 600 0.75rem/1.4 var(--font-body);
  }
  .new-tag {
    background: var(--brand);
    color: var(--on-brand);
  }
  .max-tag {
    background: var(--soft);
    color: var(--ink);
  }

  /* Suporte */
  .copy-inline {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 4px 8px;
  }
  .link-btn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand);
    font: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .locked .btn-alt {
    width: auto;
  }

  /* Alertas e Resumo (Max) */
  .locked {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px dashed var(--brand);
    border-radius: var(--radius-xl);
  }
  .locked .btn-main {
    width: auto;
  }
  .unlocked {
    display: grid;
    gap: var(--space-4);
  }
  .unlocked[hidden],
  .locked[hidden] {
    display: none;
  }
  .theme-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }
  .theme-form .field {
    flex: 1 1 260px;
  }
  .theme-form .btn-alt {
    width: auto;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 4px 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--soft);
    font: var(--text-small);
  }
  .chips button {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .chips button:focus-visible {
    outline: 3px solid var(--brand);
  }
  .areas {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }
  .area {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font: var(--text-small);
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .area input {
    accent-color: var(--brand);
  }

  /* Tutoriais */
  .tut {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .tut-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .tut-state {
    padding: 2px 10px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-pill);
    font: 600 0.75rem/1.5 var(--font-body);
    color: var(--mute);
  }
  .tut-state.is-on {
    border: 1px solid var(--brand);
    color: var(--brand);
  }
  .tut-steps {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 6px;
    font: var(--text-small);
    font-size: 0.9375rem;
  }
  .tut .btn-main {
    width: auto;
  }

  /* Status do plugin */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-3);
  }
  .stat {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .stat-k {
    font: var(--text-small);
    color: var(--mute);
  }
  .stat-v {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .stat-n {
    font: var(--text-small);
    font-size: 0.8125rem;
    color: var(--mute);
  }
  .conn {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .conn li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--space-3);
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font: var(--text-small);
    font-size: 0.9375rem;
  }
  .conn-ia {
    font-weight: 600;
    flex: 1 1 160px;
  }
  .conn-state {
    color: var(--mute);
  }
  .conn a {
    font-size: 0.875rem;
  }
  .row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .row-actions .btn-main,
  .row-actions .btn-alt,
  .action-card .btn-main,
  .action-card .btn-alt,
  .account-form .btn-alt {
    width: auto;
  }
  .empty {
    padding: var(--space-4);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--mute);
  }
  .action-card {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .action-card .title {
    margin: 0;
  }
  .action-card > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .action-card.danger {
    border-color: var(--line-strong);
  }
  .action-card .field {
    width: min(100%, 320px);
  }
  .track {
    padding-left: 1.25rem;
    display: grid;
    gap: 6px;
    font: var(--text-small);
    color: var(--mute);
  }
  .track .is-on {
    color: var(--ink);
    font-weight: 600;
  }
  .account-form {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .account-form .field {
    width: min(100%, 420px);
  }
  .portal a:not(.btn-main):not(.btn-alt):not([role='tab']) {
    color: var(--brand);
  }
</style>

<script>
  import { getSub, saveSub, daysSince, fmtDate, nextCharge, type DemoSub } from '../scripts/demo';

  const root = document.querySelector<HTMLElement>('[data-portal]')!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const plans = JSON.parse(root.dataset.plans ?? '{}') as Record<string, { name: string; price: string }>;
  const billing = root.dataset.billing ?? '';
  const authEndpoint = root.dataset.authEndpoint ?? '';
  let sub: DemoSub | null = billing ? null : getSub();
  // Com a API: status_acesso (ativo, pendente, suspenso, cancelado, reembolsado) e o resumo bruto.
  let status = '';
  let apiPlano = '';
  type Resumo = {
    plano: 'pro' | 'max'; forma: DemoSub['metodo']; final_cartao: string | null; status_acesso: string;
    criada_em: string | null; primeira_paga_em: string | null; cancelada_em: string | null; reembolso_em: string | null;
  };
  const call = (base: string, path: string, method = 'GET', body?: unknown) =>
    fetch(`${base}${path}`, {
      method,
      credentials: 'include',
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
  async function carregar() {
    const r = await call(billing, '/assinatura');
    if (r.status === 401) return location.replace('/entrar?next=/conta');
    if (r.status === 404) {
      sub = null;
      status = '';
      return;
    }
    if (!r.ok) throw new Error(String(r.status));
    const a = (await r.json()) as Resumo;
    status = a.status_acesso;
    apiPlano = a.plano;
    // Pendente (Pix ou boleto sem pagar) e cancelado sem acesso não têm Portal: mostram a tela sem plano.
    if (status === 'pendente' || status === 'cancelado') {
      sub = null;
      return;
    }
    sub = {
      plano: a.plano,
      email: root.dataset.userEmail ?? '',
      nome: root.dataset.userName || undefined,
      desde: (a.primeira_paga_em ?? a.criada_em ?? new Date().toISOString().slice(0, 10)) + 'T12:00:00',
      metodo: a.forma,
      final: a.final_cartao ?? undefined,
      cancelada: a.cancelada_em ? a.cancelada_em + 'T12:00:00' : undefined,
      reembolso: a.reembolso_em ? a.reembolso_em + 'T12:00:00' : undefined,
    };
  }
  const apiFalhou = (msg: string) => {
    const banner = $('[data-banner]');
    banner.className = 'notice is-error';
    banner.textContent = msg;
    banner.hidden = false;
    banner.scrollIntoView({ block: 'nearest' });
  };

  const btn = (text: string, cls: string, onClick: () => void) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = cls;
    b.textContent = text;
    b.addEventListener('click', onClick);
    return b;
  };
  const update = async (patch: Partial<DemoSub>) => {
    if (!billing) {
      sub = { ...(sub as DemoSub), ...patch };
      saveSub(sub);
      return render();
    }
    // Com a API: cada ação vira a rota correspondente, e o Portal se redesenha com o que a API devolver.
    let r: Response;
    try {
      if ('cancelada' in patch) r = patch.cancelada ? await call(billing, '/assinatura', 'DELETE') : await call(billing, '/assinatura/reativar', 'POST');
      else if (patch.reembolso) r = await call(billing, '/assinatura/reembolso', 'POST');
      else if ('nome' in patch) {
        r = await call(authEndpoint, '/conta', 'PUT', { nome: patch.nome ?? '' });
        if (r.ok) root.dataset.userName = patch.nome ?? '';
      } else return;
      if (!r.ok) {
        const d = await r.json().catch(() => ({}));
        render();
        return apiFalhou(d.detail?.mensagem ?? d.descricao ?? 'Não conseguimos concluir agora. Tente de novo em instantes.');
      }
      await carregar();
    } catch {
      return apiFalhou('Não conseguimos falar com o servidor. Confira sua conexão e tente de novo.');
    }
    render();
  };

  // Abas com endereço (#plugin, #plano, #cancelar, #conta)
  const tabEls = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  function selectTab(id: string, focus = false) {
    if (!tabEls.some((t) => t.dataset.tab === id)) id = 'plugin';
    tabEls.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    if (id === 'novidades') markNewsSeen();
  }

  // Novidades: o que ainda não foi visto ganha o selo "Nova" e conta no número da aba.
  // Ao abrir a aba, os selos aparecem nesta visita e o número zera.
  const SEEN_KEY = 'of-demo-novidades-vistas';
  const newsItems = Array.from(root.querySelectorAll<HTMLElement>('[data-news] li'));
  const getSeen = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(SEEN_KEY) ?? '[]');
    } catch {
      return [];
    }
  };
  function paintNewsBadge() {
    const seen = getSeen();
    const unseen = newsItems.filter((li) => !seen.includes(li.dataset.id!)).length;
    const badge = $('[data-news-badge]');
    badge.hidden = unseen === 0;
    badge.textContent = String(unseen);
    badge.setAttribute('aria-label', `${unseen} ${unseen === 1 ? 'novidade nova' : 'novidades novas'}`);
  }
  function markNewsSeen() {
    const seen = getSeen();
    newsItems.forEach((li) => (li.querySelector<HTMLElement>('[data-new]')!.hidden = seen.includes(li.dataset.id!)));
    try {
      localStorage.setItem(SEEN_KEY, JSON.stringify(newsItems.map((li) => li.dataset.id)));
    } catch {}
    paintNewsBadge();
  }
  const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  filterBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      filterBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      newsItems.forEach((li) => {
        li.hidden = f !== 'todas' && li.dataset.origem !== f;
        if (!li.hidden) shown++;
      });
      $('[data-news-empty]').hidden = shown > 0;
    }),
  );
  // Alertas por tema (Max). Na demonstração, os temas ficam neste navegador; depois, na API.
  const THEMES_KEY = 'of-demo-temas';
  const getThemes = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(THEMES_KEY) ?? '[]');
    } catch {
      return [];
    }
  };
  const setThemes = (t: string[]) => {
    try {
      localStorage.setItem(THEMES_KEY, JSON.stringify(t));
    } catch {}
    renderThemes();
  };
  function renderThemes() {
    const list = $('[data-themes]');
    const themes = getThemes();
    list.replaceChildren();
    themes.forEach((t) => {
      const li = document.createElement('li');
      li.append(t);
      const x = document.createElement('button');
      x.type = 'button';
      x.textContent = '×';
      x.setAttribute('aria-label', `Remover o tema ${t}`);
      x.addEventListener('click', () => setThemes(getThemes().filter((y) => y !== t)));
      li.append(x);
      list.append(li);
    });
    $('[data-themes-empty]').hidden = themes.length > 0;
    root.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) => (b.hidden = themes.includes(b.dataset.suggest!)));
  }
  function addTheme(raw: string) {
    const t = raw.trim().replace(/\s+/g, ' ');
    const msg = $('#p-tema-msg');
    if (t.length < 3) return void (msg.textContent = 'Escreva o tema com pelo menos 3 letras.');
    const themes = getThemes();
    if (themes.some((x) => x.toLowerCase() === t.toLowerCase())) return void (msg.textContent = 'Esse tema já está salvo.');
    if (themes.length >= 20) return void (msg.textContent = 'Você chegou ao máximo de 20 temas. Remova um para salvar outro.');
    msg.textContent = '';
    setThemes([...themes, t]);
  }
  $<HTMLFormElement>('[data-theme-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('#p-tema');
    addTheme(input.value);
    if (!$('#p-tema-msg').textContent) input.value = '';
    input.focus();
  });
  root.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) => b.addEventListener('click', () => addTheme(b.dataset.suggest!)));

  // Resumo semanal (Max): áreas escolhidas.
  const AREAS_KEY = 'of-demo-areas';
  const areaInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-areas] input'));
  try {
    const saved: string[] = JSON.parse(localStorage.getItem(AREAS_KEY) ?? '[]');
    areaInputs.forEach((i) => (i.checked = saved.includes(i.value)));
  } catch {}
  areaInputs.forEach((i) =>
    i.addEventListener('change', () => {
      const chosen = areaInputs.filter((x) => x.checked).map((x) => x.value);
      try {
        localStorage.setItem(AREAS_KEY, JSON.stringify(chosen));
      } catch {}
      $('[data-areas-msg]').textContent = chosen.length
        ? `Salvo: ${chosen.length} ${chosen.length === 1 ? 'área' : 'áreas'}.`
        : 'Nenhuma área escolhida: o resumo fica pausado.';
    }),
  );

  // Suporte: copiar o e-mail (cai para seleção do texto se a área de transferência não estiver disponível).
  $('[data-copy-email]').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const email = $('[data-support-email]').textContent ?? '';
    try {
      await navigator.clipboard.writeText(email);
      b.textContent = 'Copiado';
      setTimeout(() => (b.textContent = 'Copiar'), 2000);
    } catch {
      const range = document.createRange();
      range.selectNodeContents($('[data-support-email]'));
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(range);
    }
  });

  // Tutoriais: um por vez, escolhido pela IA.
  const iaBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ia-pick]'));
  function pickIa(id: string) {
    iaBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.iaPick === id)));
    root.querySelectorAll<HTMLElement>('[data-tut]').forEach((t) => (t.hidden = t.dataset.tut !== id));
  }
  iaBtns.forEach((b) => b.addEventListener('click', () => pickIa(b.dataset.iaPick!)));

  root.querySelectorAll<HTMLAnchorElement>('[data-goto]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (a.dataset.ia) pickIa(a.dataset.ia);
      history.replaceState(null, '', `#${a.dataset.goto}`);
      selectTab(a.dataset.goto!, true);
    }),
  );
  tabEls.forEach((t, i) => {
    t.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${t.dataset.tab}`);
      selectTab(t.dataset.tab!);
    });
    t.addEventListener('keydown', (e) => {
      const n = e.key === 'ArrowRight' ? (i + 1) % tabEls.length : e.key === 'ArrowLeft' ? (i - 1 + tabEls.length) % tabEls.length : -1;
      if (n < 0) return;
      e.preventDefault();
      history.replaceState(null, '', `#${tabEls[n].dataset.tab}`);
      selectTab(tabEls[n].dataset.tab!, true);
    });
  });
  addEventListener('hashchange', () => selectTab(location.hash.slice(1)));

  function render() {
    $('[data-no-sub]').hidden = !!sub;
    $('[data-has-sub]').hidden = !sub;
    if (!sub) {
      const cta = $<HTMLAnchorElement>('[data-no-sub-cta]');
      if (status === 'pendente') {
        $('[data-no-sub] h1').textContent = 'Seu pagamento ainda não foi confirmado';
        $('[data-no-sub-text]').textContent = 'O acesso começa quando o Pix ou o boleto for confirmado. Se ainda não pagou, gere o pagamento de novo.';
        cta.textContent = 'Ir para o pagamento';
        cta.href = `/assinar/${apiPlano || 'pro'}`;
      } else if (status === 'cancelado') {
        $('[data-no-sub] h1').textContent = 'Sua assinatura terminou';
        $('[data-no-sub-text]').textContent = 'Para voltar a usar a Órbita, escolha um plano.';
      }
      return;
    }
    const plan = plans[sub.plano];
    const other = sub.plano === 'max' ? 'pro' : 'max';
    const since = new Date(sub.desde);
    const next = nextCharge(sub.desde);
    const days = daysSince(sub.desde);
    const refundUntil = new Date(since.getTime() + 7 * 86400000);

    $('[data-who]').textContent = `${sub.nome ? sub.nome + ' · ' : ''}${sub.email}`;
    $('[data-plan]').textContent = `${plan.name}, ${plan.price} por mês`;
    $('[data-since]').textContent = fmtDate(since);
    $('[data-next]').textContent = sub.cancelada || sub.reembolso ? 'Nenhuma' : fmtDate(next);
    $('[data-method]').textContent =
      sub.metodo === 'pix' ? 'Pix' : sub.metodo === 'boleto' ? 'Boleto' : `Cartão final ${sub.final || '••••'}`;
    const sw = $<HTMLAnchorElement>('[data-switch]');
    sw.href = `/assinar/${other}`;
    sw.textContent = `Trocar para o ${plans[other].name} (${plans[other].price} por mês)`;
    $('[data-email]').textContent = sub.email;
    $<HTMLInputElement>('#p-nome').value = sub.nome ?? '';

    // Seções do Max: no Pro, bloqueadas com convite.
    const isMax = sub.plano === 'max';
    root.querySelectorAll<HTMLElement>('[data-locked]').forEach((el) => (el.hidden = isMax));
    root.querySelectorAll<HTMLElement>('[data-unlocked]').forEach((el) => (el.hidden = !isMax));
    renderThemes();

    // Suporte: prazos ainda a confirmar; o Max é prioritário e tem conversa de implantação.
    $('[data-sla]').textContent = isMax ? 'Prioritário: no mesmo dia útil (a confirmar)' : 'Até 2 dias úteis (a confirmar)';
    $('[data-onboarding]').hidden = !isMax;
    $('[data-onboarding-pro]').hidden = isMax;

    // Status do plugin. Consultas e última consulta virão da API; na demonstração, ainda não há nenhuma.
    $('[data-access]').textContent = sub.reembolso ? 'Encerrado' : status === 'suspenso' ? 'Suspenso' : 'Ativo';
    $('[data-access-note]').textContent = sub.reembolso
      ? 'O reembolso encerrou a assinatura.'
      : status === 'suspenso'
        ? 'Pagamento em atraso. O acesso volta assim que o pagamento for confirmado.'
        : sub.cancelada
        ? `Cancelada: o acesso segue até ${fmtDate(next)}.`
        : `Renova em ${fmtDate(next)}.`;
    let passos: string[] = [];
    try {
      passos = JSON.parse(localStorage.getItem('of-demo-instalacao') ?? '[]');
    } catch {}
    const conectado = passos.includes('3');
    $('[data-conn-claude]').textContent = conectado
      ? 'Conectado'
      : passos.length
        ? `Instalação em andamento (${passos.length} de 4 passos)`
        : 'Não conectado';
    $('[data-conn-claude-link]').textContent = conectado ? 'Ver o passo a passo' : passos.length ? 'Continuar a instalação' : 'Instalar e conectar';

    // Faixa de estado
    const banner = $('[data-banner]');
    banner.hidden = true;
    if (sub.reembolso) {
      banner.className = 'notice';
      banner.textContent = `Reembolso solicitado em ${fmtDate(new Date(sub.reembolso))}. Acompanhe na aba Cancelar ou reembolso.`;
      banner.hidden = false;
    } else if (sub.cancelada) {
      banner.className = 'notice';
      banner.textContent = `Assinatura cancelada. Seu acesso segue até ${fmtDate(next)}.`;
      banner.hidden = false;
    } else if (status === 'suspenso') {
      banner.className = 'notice is-error';
      banner.textContent = 'Pagamento em atraso: o acesso está suspenso até o pagamento ser confirmado.';
      banner.hidden = false;
    }

    // Reembolso
    const rText = $('[data-refund-text]');
    const rAct = $('[data-refund-actions]');
    rAct.replaceChildren();
    $('[data-refund-track]').hidden = !sub.reembolso;
    if (sub.reembolso) {
      rText.textContent = 'Recebemos seu pedido. O valor integral volta pela mesma forma de pagamento.';
      $('[data-refund-date]').textContent = `em ${fmtDate(new Date(sub.reembolso))}`;
    } else if (days <= 7) {
      const left = 7 - days;
      rText.textContent = `Você pode pedir o reembolso integral até ${fmtDate(refundUntil)} (${left === 0 ? 'último dia' : `faltam ${left} ${left === 1 ? 'dia' : 'dias'}`}). Não precisa explicar o motivo.`;
      const ask = btn('Pedir reembolso', 'btn-main', () => {
        rAct.replaceChildren(
          btn('Confirmar pedido de reembolso', 'btn-main', () => update({ reembolso: new Date().toISOString() })),
          btn('Voltar', 'btn-alt', render),
        );
        (rAct.firstElementChild as HTMLElement).focus();
      });
      rAct.append(ask);
    } else {
      rText.textContent = `O prazo de 7 dias terminou em ${fmtDate(refundUntil)}. Você ainda pode cancelar abaixo, sem multa.`;
    }

    // Cancelamento
    const cText = $('[data-cancel-text]');
    const cAct = $('[data-cancel-actions]');
    cAct.replaceChildren();
    if (sub.reembolso) {
      cText.textContent = 'Com o reembolso, a assinatura é encerrada. Não há nada a cancelar.';
    } else if (sub.cancelada) {
      cText.textContent = `Cancelada em ${fmtDate(new Date(sub.cancelada))}. O acesso segue até ${fmtDate(next)} e não haverá nova cobrança.`;
      cAct.append(btn('Reativar a assinatura', 'btn-alt', () => update({ cancelada: undefined })));
    } else {
      cText.textContent = `A assinatura para de renovar e seu acesso continua até ${fmtDate(next)}. Sem multa.`;
      cAct.append(
        btn('Cancelar assinatura', 'btn-alt', () => {
          cAct.replaceChildren(
            btn('Confirmar cancelamento', 'btn-main', () => update({ cancelada: new Date().toISOString() })),
            btn('Manter assinatura', 'btn-alt', render),
          );
          (cAct.firstElementChild as HTMLElement).focus();
        }),
      );
    }
  }

  // Conta
  $<HTMLFormElement>('[data-name-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    update({ nome: $<HTMLInputElement>('#p-nome').value.trim() }).then(() => {
      if ($('[data-banner]').classList.contains('is-error')) return;
      $('[data-name-msg]').textContent = 'Nome salvo.';
    });
  });
  const logout = async () => {
    // Com a API ligada, encerra a sessão no servidor (apaga o cookie); sem ela, só a demonstração.
    const authEndpoint = root.dataset.authEndpoint;
    if (authEndpoint) {
      try {
        await fetch(`${authEndpoint}/sair`, { method: 'POST', credentials: 'include' });
      } catch {}
    }
    try {
      sessionStorage.removeItem('of-demo-email');
    } catch {}
    location.href = '/entrar';
  };
  root.querySelectorAll('[data-logout]').forEach((b) => b.addEventListener('click', logout));
  const confirmInput = $<HTMLInputElement>('#p-confirm');
  const del = $<HTMLButtonElement>('[data-delete]');
  confirmInput.addEventListener('input', () => (del.disabled = confirmInput.value.trim().toUpperCase() !== 'EXCLUIR'));
  del.addEventListener('click', async () => {
    $('[data-delete-msg]').textContent = '';
    if (billing) {
      try {
        const r = await call(authEndpoint, '/conta', 'DELETE');
        if (!r.ok) {
          const d = await r.json().catch(() => ({}));
          $('[data-delete-msg]').textContent = d.descricao ?? 'Não conseguimos excluir agora. Tente de novo em instantes.';
          return;
        }
      } catch {
        $('[data-delete-msg]').textContent = 'Não conseguimos falar com o servidor. Tente de novo em instantes.';
        return;
      }
    }
    saveSub(null);
    try {
      sessionStorage.removeItem('of-demo-email');
      localStorage.removeItem('of-demo-instalacao');
    } catch {}
    sub = null;
    render();
    $('[data-no-sub] h1').textContent = 'Sua conta foi excluída';
    $('[data-no-sub-text]').textContent = 'Seus dados de acesso foram apagados.';
    root.querySelectorAll<HTMLElement>('[data-no-sub] .row-actions [data-logout], [data-no-sub] .small').forEach((e) => (e.hidden = true));
  });

  if (billing) {
    // Até a API responder, nada aparece (evita mostrar "sem plano" por um instante).
    $('[data-no-sub]').hidden = true;
    carregar()
      .catch(() => apiFalhou('Não conseguimos carregar sua assinatura. Atualize a página em instantes.'))
      .finally(render);
  } else render();
  paintNewsBadge();
  selectTab(location.hash.slice(1) || 'plugin');
</script>
