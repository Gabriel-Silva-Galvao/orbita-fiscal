---
import Button from './Button.astro';
import { comparacoes } from '../data/comparacao';

// Título de venda (etapa 10f-1, plano da landing): nomeia o resultado que o advogado quer.
const title = 'A lei e o julgado certos, com a fonte, na IA que você já usa';

// Ao lado do título (etapa 10f-2): um trecho real da resposta do Claude Opus 5.5 com a Órbita, a da
// pergunta de crime tributário do comparativo (src/data/comparacao.ts). O trecho é o primeiro parágrafo
// da resposta, sem mudar nada; as fontes listadas aparecem todas, com esses nomes, no texto da resposta.
// Item 19 (25/11/2026): sai o átomo de lítio do topo; o cartão de resposta fica sozinho ao lado do título.
const exemplo = comparacoes.find((c) => c.id === 'crime')!;
const trecho = exemplo.com.texto.split('\n')[0];
const fontes = [
  'Súmula Vinculante 24 do STF',
  'Lei 8.137/1990, art. 1º',
  'Lei 9.430/1996, art. 83',
  'ARE 1.618.979 AgR (STF, 13/10/2026)',
  'LC 225/2026',
];
---

<!-- Etapa 10f-2: trecho real de resposta com a fonte, gerado ao vivo (10g). Item 19: sem o átomo e com o fundo parado. -->
<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- Fundo: órbitas largas que atravessam a página, com um ponto viajando. -->
  <svg class="hero-bg" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g transform="rotate(-28 980 380)" fill="none" stroke="var(--line)" stroke-width="1.2">
      <ellipse cx="980" cy="380" rx="760" ry="300"></ellipse>
      <ellipse cx="980" cy="380" rx="520" ry="200" stroke-dasharray="2 10"></ellipse>
      <ellipse id="hero-path" cx="980" cy="380" rx="980" ry="420"></ellipse>
    </g>
    <!-- Item 19: os pontos ficam parados sobre as órbitas (o fundo não se mexe mais). -->
    <g transform="rotate(-28 980 380)">
      <circle cx="266" cy="277" r="5" fill="var(--brand)"></circle>
      <circle cx="1240" cy="553" r="3.5" fill="var(--brand)" opacity=".6"></circle>
    </g>
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="overline">Plugin para Claude</p>
      <!-- SEO (etapa 8d): o título é o maior elemento da primeira tela (LCP). Aparece já pintado, sem entrada animada. -->
      <h1 id="hero-title" class="display-xl hero-title">
        {title}
      </h1>
      <p class="lead">
        Pergunte no Claude como sempre. A Órbita busca na base de legislação e jurisprudência brasileira e
        devolve a resposta com a norma, a súmula ou o julgado para você conferir.
      </p>
      <div class="hero-actions">
        <Button href="#planos">Assinar a partir de R$ 50/mês</Button>
        <Button href="#exemplo" variant="secondary">Ver com e sem a Órbita</Button>
      </div>
      <p class="small mute">Cartão, Pix ou boleto · cancele quando quiser · funciona no Claude</p>
    </div>

    <div class="hero-art">
      <figure class="hero-answer" aria-label="Exemplo de resposta com a Órbita" data-gerar>
        <p class="ha-q" data-g-q>
          <span class="ha-label">Pergunta no Claude</span>
          {exemplo.pergunta}
        </p>
        <div class="ha-a">
          <p class="ha-who">Claude Opus 5.5 com a Órbita<span class="ha-status" data-g-status aria-hidden="true"></span></p>
          <p class="ha-text" data-g-text>{trecho}</p>
          <p class="ha-label">Fontes citadas na resposta</p>
          <ul class="ha-sources" data-g-chips>
            {fontes.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <figcaption class="small">
          Resposta real, com {exemplo.com.fontes} fontes citadas. <a href="#exemplo">Compare com a resposta sem a Órbita</a>
        </figcaption>
      </figure>
    </div>
  </div>

  <a class="hero-cue" href="#a-base">
    <span>Role para conhecer</span>
    <span class="hero-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-8) var(--space-9);
      min-height: min(860px, calc(100svh - 84px));
      display: grid;
      align-content: center;
    }
  }
  .hero-bg {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    pointer-events: none;
    opacity: 0.9;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hero-title {
    max-width: 620px;
    text-wrap: balance;
  }
  .hero-copy .lead {
    max-width: 540px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero-art {
    position: relative;
    display: grid;
  }
  /* Cartão de resposta real (etapa 10f-2). */
  .hero-answer {
    margin: 0;
    justify-self: end;
    display: grid;
    gap: var(--space-3);
    width: 100%;
    max-width: 480px;
    position: relative;
    z-index: 1;
  }
  .ha-q {
    margin: 0;
    justify-self: end;
    max-width: 92%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-lg);
    background: var(--soft);
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .ha-a {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--brand);
    background: var(--surface);
  }
  .ha-label {
    display: block;
    margin: 0;
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .ha-q .ha-label {
    color: var(--ink);
    opacity: 0.75;
    margin-bottom: 4px;
  }
  .ha-who {
    margin: 0;
    font-weight: 600;
    color: var(--brand);
    font-size: 0.875rem;
  }
  .ha-text {
    margin: 0 0 var(--space-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .ha-sources {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ha-sources li {
    font-size: 0.8125rem;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
  }
  .ha-who {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ha-status {
    font-weight: 400;
    color: var(--mute);
  }
  .ha-status:not(:empty)::before {
    content: ' · ';
  }
  .ha-a {
    transition: box-shadow 0.5s;
  }
  .hero-answer.is-live .ha-a {
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--brand) 20%, transparent);
  }
  .hero-answer figcaption {
    justify-self: start;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--mute);
  }
  .hero-answer figcaption a {
    color: var(--brand);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
    .hero-answer {
      justify-self: end;
      margin-block: var(--space-6);
    }
  }

  /* Convite para rolar. */
  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
    text-decoration: none;
  }
  .hero-cue-line {
    width: 1.5px;
    height: 40px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform: translateY(-100%);
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (min-width: 900px) and (min-height: 760px) {
    .hero-cue {
      display: flex;
    }
  }
</style>

<script>
  import { gerarNoTopo } from '../scripts/gerar';
  gerarNoTopo();
</script>
