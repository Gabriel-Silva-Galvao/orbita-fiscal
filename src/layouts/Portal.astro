  }
  .pt-conteudo :global(.selo) {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--soft);
    color: var(--ink);
    font: 600 0.75rem/1.4 var(--font-body);
  }
  .pt-conteudo :global(.selo.is-brand) {
    background: var(--brand);
    color: var(--on-brand);
  }
  .pt-conteudo :global(a:not(.btn-main):not(.btn-alt)) {
    color: var(--brand);
  }
  .pt-conteudo :global(.filtros) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pt-conteudo :global(.filtros button) {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font: 500 0.875rem/1 var(--font-body);
    cursor: pointer;
  }
  .pt-conteudo :global(.filtros button[aria-pressed='true']) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .pt-conteudo :global(.filtros button:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
</style>

<script>
  import { aoCarregar, plans, usuario, sair, novidadesVistas, apiBase, $ } from '../scripts/portal';

  const root = $('[data-portal]');
  const aceita = (root.dataset.aceita ?? 'ativo').split(' ');

  // Estado vazio para cada situação em que a página não abre.
  const VAZIO: Record<string, { titulo: string; texto: string; cta?: { href: string; label: string } }> = {
    sem: { titulo: 'Você ainda não tem um plano ativo', texto: 'Escolha o Bronze, o Prata ou o Ouro para começar.', cta: { href: '/planos', label: 'Ver planos' } },
    pendente: {
      titulo: 'Seu pagamento ainda não foi confirmado',
      texto: 'O acesso começa quando o Pix ou o boleto for confirmado. Veja o pagamento em Plano e pagamento.',
      cta: { href: '/conta/plano', label: 'Ver o pagamento' },
    },
    encerrado: { titulo: 'Sua assinatura terminou', texto: 'Para voltar a usar a Órbita, escolha um plano.', cta: { href: '/planos', label: 'Ver planos' } },
    erro: { titulo: 'Não conseguimos carregar sua assinatura', texto: 'Pode ser a conexão ou o servidor. Atualize a página em instantes.', cta: { href: location.pathname, label: 'Tentar de novo' } },
  };

  const iniciais = (nome: string) =>
    nome.trim().split(/[\s@.]+/).filter(Boolean).map((p) => p[0]).slice(0, 2).join('').toUpperCase() || '?';

  let primeira = true;
  aoCarregar((ctx) => {
    $('[data-portal-carregando]').hidden = true;
    const abre = aceita.includes(ctx.estado);
    $('[data-portal-conteudo]').hidden = !abre;
    // O conteúdo só aparece depois de carregar: a âncora do endereço (ex.: #cancelar) é levada em conta agora.
    if (abre && primeira && location.hash.length > 1) {
      requestAnimationFrame(() => document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView());
    }
    if (primeira) {
      const alvo = $(abre ? '[data-portal-conteudo]' : '[data-portal-vazio]');
      if (abre) Array.from(alvo.children).forEach((el, i) => (el as HTMLElement).style.setProperty('--i', String(Math.min(i, 8))));
      alvo.classList.add('is-entrando');
      setTimeout(() => alvo.classList.remove('is-entrando'), 1400);
    }
    primeira = false;
    const vazio = $('[data-portal-vazio]');
    vazio.hidden = abre;
    if (!abre) {
      const v = VAZIO[ctx.estado] ?? VAZIO.sem;
      $('[data-vazio-titulo]').textContent = v.titulo;
      $('[data-vazio-texto]').textContent = v.texto;
      const cta = $<HTMLAnchorElement>('[data-vazio-cta]');
      cta.hidden = !v.cta;
      if (v.cta) {
        cta.href = v.cta.href;
        cta.textContent = v.cta.label;
      }
      $('[data-vazio-conta]').hidden = root.dataset.pagina === 'configuracoes';
    }

    // Bloco G, ideia 7: o selo "Ouro" do menu só aparece para quem ainda não é Ouro.
    document.querySelectorAll<HTMLElement>('.pt-tag').forEach((t) => (t.hidden = ctx.ouro));

    // Item 40: status do plugin embaixo da logo (some na demonstração, sem API).
    if (apiBase) {
      fetch(`${apiBase}/plugin/status`, { credentials: 'include' })
        .then((r) => (r.ok ? r.json() : null))
        .then((st: { ativo: boolean; plano_ativo: boolean; conectado: boolean; ultima: number | null } | null) => {
          if (!st) return;
          const estado = st.ativo ? 'ativo' : 'inativo';
          const texto = st.ativo ? 'Plugin ativo' : 'Plugin inativo';
          const dica = st.ativo
            ? `Plugin conectado. Último uso: ${new Date((st.ultima ?? 0) * 1000).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}.`
            : st.plano_ativo
              ? 'Instale o plugin e faça a primeira pergunta para ativar.'
              : 'O plugin fica ativo com o plano em dia e a primeira pergunta feita.';
          const selo = $('[data-plugin-status]');
          selo.dataset.estado = estado;
          selo.title = dica;
          selo.setAttribute('aria-label', `${texto}. ${dica}`);
          $('[data-plugin-texto]').textContent = texto;
          selo.hidden = false;
          const mini = $('[data-plugin-mini]');
          mini.dataset.estado = estado;
          mini.title = `${texto}. ${dica}`;
          mini.setAttribute('role', 'img');
          mini.setAttribute('aria-label', texto);
          mini.hidden = false;
        })
        .catch(() => {});
    }

    // Plano no menu lateral.
    const plano = $('[data-portal-plano]');
    const nome = ctx.plano ? plans[ctx.plano]?.name : '';
    const situacao =
      ctx.estado === 'pendente' ? 'pagamento pendente'
      : ctx.estado === 'encerrado' ? 'encerrado'
      : ctx.sub?.reembolso ? 'reembolsado'
      : ctx.status === 'suspenso' ? 'suspenso'
      : ctx.sub?.cancelada ? 'cancelamento agendado'
      : ctx.estado === 'ativo' ? 'ativo' : '';
    plano.replaceChildren();
    if (nome) {
      const s = document.createElement('strong');
      s.textContent = `Plano ${nome}`;
      plano.append(s, ` · ${situacao}`);
    } else plano.textContent = ctx.estado === 'erro' ? '' : 'Sem plano';

    // Avatar: nome do servidor (sessão) ou, na demonstração, o que o Checkout gravou.
    const quem = usuario.nome || ctx.sub?.nome || '';
    const email = usuario.email || ctx.sub?.email || '';
    $('[data-pt-iniciais]').textContent = iniciais(quem || email);
    $('[data-pt-nome]').textContent = quem || 'Sua conta';
    $('[data-pt-email]').textContent = email;
  });

  // Novidades ainda não vistas: número no menu lateral e ponto na barra inferior.
  {
    const ids = (root.dataset.novidades ?? '').split(' ').filter(Boolean);
    const vistas = novidadesVistas();
    const n = root.dataset.pagina === 'novidades' ? 0 : ids.filter((i) => !vistas.includes(i)).length;
    const badge = document.querySelector<HTMLElement>('[data-portal-novas]');
    if (badge) {
      badge.hidden = n === 0;
      badge.textContent = String(n);
      badge.setAttribute('aria-label', `${n} ${n === 1 ? 'novidade nova' : 'novidades novas'}`);
    }
    const ponto = document.querySelector<HTMLElement>('[data-portal-novas-ponto]');
    if (ponto) ponto.hidden = n === 0;
  }

  // Menu do avatar: clique ou Enter abre, Esc e clique fora fecham, setas navegam.
  const user = $('[data-pt-user]');
  const avatar = $<HTMLButtonElement>('[data-pt-avatar]');
  const menu = $('[data-pt-menu]');
  const fechar = (foco = false) => {
    menu.hidden = true;
    avatar.setAttribute('aria-expanded', 'false');
    if (foco) avatar.focus();
  };
  avatar.addEventListener('click', () => {
    const abre = menu.hidden;
    menu.hidden = !abre;
    avatar.setAttribute('aria-expanded', String(abre));
    if (abre) menu.querySelector<HTMLElement>('[role^="menuitem"]')?.focus();
  });
  menu.addEventListener('keydown', (e) => {
    const itens = Array.from(menu.querySelectorAll<HTMLElement>('[role^="menuitem"]'));
    const i = itens.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      itens[(i + (e.key === 'ArrowDown' ? 1 : -1) + itens.length) % itens.length].focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!user.contains(e.target as Node)) fechar();
  });
  $('[data-pt-sair]').addEventListener('click', () => sair('/'));

  // Bloco G, ideia 1: tema no menu do avatar (mesma chave do seletor do rodapé do site).
  const temas = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tema]'));
  const marcarTema = () => {
    const atual = document.documentElement.getAttribute('data-theme') ?? 'auto';
    temas.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.tema === atual)));
  };
  temas.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.tema!;
      if (t === 'auto') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', t);
      try {
        if (t === 'auto') localStorage.removeItem('of-theme');
        else localStorage.setItem('of-theme', t);
      } catch {}
      marcarTema();
    }),
  );
  marcarTema();

  // Folha "Mais" no celular.
  const maisBtn = $<HTMLButtonElement>('[data-pt-mais-btn]');
  const mais = $('[data-pt-mais]');
  const abrirMais = (abre: boolean) => {
    mais.hidden = !abre;
    maisBtn.setAttribute('aria-expanded', String(abre));
    if (abre) mais.querySelector<HTMLElement>('a')?.focus();
    else maisBtn.focus();
  };
  maisBtn.addEventListener('click', () => abrirMais(mais.hidden));
  mais.querySelector('[data-pt-mais-fechar]')?.addEventListener('click', () => abrirMais(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!menu.hidden) fechar(true);
    if (!mais.hidden) abrirMais(false);
  });

  // Busca na Ajuda: filtra os artigos enquanto digita; Enter abre o primeiro; setas percorrem a lista.
  const busca = $<HTMLFormElement>('[data-busca]');
  const campo = $<HTMLInputElement>('#pt-busca');
  const lista = $('#pt-busca-lista');
  const itens = Array.from(lista.querySelectorAll<HTMLLIElement>('li[data-termos]'));
  const semAcento = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const visiveis = () => itens.filter((li) => !li.hidden).map((li) => li.querySelector('a')!);
  const filtrar = () => {
    const q = semAcento(campo.value.trim());
    const palavras = q.split(/\s+/).filter(Boolean);
    itens.forEach((li) => (li.hidden = !palavras.every((p) => semAcento(li.dataset.termos!).includes(p))));
    $('[data-busca-vazio]').hidden = visiveis().length > 0;
    const abre = q.length > 0;
    lista.hidden = !abre;
    campo.setAttribute('aria-expanded', String(abre));
  };
  campo.addEventListener('input', filtrar);
  campo.addEventListener('focus', () => campo.value && filtrar());
  busca.addEventListener('submit', (e) => {
    e.preventDefault();
    const primeiro = visiveis()[0];
    location.href = primeiro ? primeiro.href : '/ajuda';
  });
  busca.addEventListener('keydown', (e) => {
    const links = visiveis();
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === 'ArrowDown' && links.length) {
      e.preventDefault();
      links[Math.min(i + 1, links.length - 1)].focus();
    } else if (e.key === 'ArrowUp' && i >= 0) {
      e.preventDefault();
      if (i === 0) campo.focus();
      else links[i - 1].focus();
    } else if (e.key === 'Escape' && !lista.hidden) {
      e.stopPropagation();
      lista.hidden = true;
      campo.setAttribute('aria-expanded', 'false');
      campo.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!busca.contains(e.target as Node)) {
      lista.hidden = true;
      campo.setAttribute('aria-expanded', 'false');
    }
  });
</script>
