---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import BaseFontes from '../components/BaseFontes.astro';
import Pending from '../components/Pending.astro';
import Comparativo from '../components/Comparativo.astro';
import Button from '../components/Button.astro';
import PlanCard from '../components/PlanCard.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import AiConnections from '../components/AiConnections.astro';
import StructuredData from '../components/StructuredData.astro';

const steps = [
  {
    n: '1',
    title: 'Assine',
    text: 'Escolha o Pro ou o Max e pague. Você recebe o plugin logo depois.',
  },
  {
    n: '2',
    title: 'Instale no Claude',
    text: 'Baixe o arquivo e envie no menu de plugins do Claude.',
  },
  {
    n: '3',
    title: 'Conecte e pergunte',
    text: 'Entre com sua conta Órbita e pergunte como sempre perguntou.',
  },
];

---

<Base
  title="Órbita: pesquise o direito brasileiro na IA que você já usa"
  description="Plugin para o Claude que liga a base de legislação e jurisprudência brasileira à sua pesquisa e às suas peças. A partir de R$ 50 por mês."
>
  <div class="page-sheet">
  <StructuredData />
  <Nav
    links={[
      { href: '#a-base', label: 'O que consulta' },
      { href: '#exemplo', label: 'Com e sem a Órbita' },
      { href: '#como-funciona', label: 'Como funciona' },
      { href: '#ias', label: 'Funciona com' },
      { href: '#planos', label: 'Planos' },
      { href: '#duvidas', label: 'Dúvidas' },
    ]}
    signIn="/entrar"
    cta={{ href: '#planos', label: 'Assinar' }}
  />

  <main id="conteudo">
    <Hero />

    <BaseFontes />

    <!-- Exemplo -->
    <section id="exemplo" class="section" aria-labelledby="exemplo-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="exemplo-title" class="display-lg" data-split>A mesma pergunta, com e sem a Órbita</h2>
          <p class="lead">Cinco perguntas tributárias reais feitas ao Claude Opus 5.5, primeiro sozinho e depois com a Órbita. Compare as fontes.</p>
        </div>
        <div data-reveal>
          <Comparativo />
          <p class="cmp-cta"><Button href="#planos">Assinar a partir de R$ 50/mês</Button></p>
        </div>
      </div>
    </section>

    <!-- Como funciona -->
    <section id="como-funciona" class="section section-alt" aria-labelledby="como-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="como-title" class="display-lg" data-split>Três passos, sem treinamento</h2>
          <p class="lead">Em poucos minutos você faz a primeira pergunta à base.</p>
        </div>
        <div class="steps-wrap" data-steps>
          <div class="steps-track" aria-hidden="true"><span class="steps-fill"></span></div>
          <ol class="steps">
            {
              steps.map((s) => (
                <li class="step" data-reveal>
                  <div class="step-top">
                    <span class="step-n" aria-hidden="true">
                      {s.n}
                    </span>
                  </div>
                  <h3 class="title">{s.title}</h3>
                  <p class="small mute">{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- IAs: onde a Órbita funciona -->
    <section id="ias" class="section" aria-labelledby="ias-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="ias-title" class="display-lg" data-split>Na IA que você já usa</h2>
          <p class="lead">O plugin é o mesmo em todas; muda só o caminho para instalar. Hoje funciona no Claude. ChatGPT, Copilot e Gemini estão em preparação.</p>
        </div>
        <AiConnections />
      </div>
    </section>

    <!-- Planos -->
    <section id="planos" class="section" aria-labelledby="planos-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2 id="planos-title" class="display-lg" data-split>Dois planos: escolha pelo trabalho que você faz</h2>
        </div>
        <div class="plans" data-reveal>
          <PlanCard
            name="Pro"
            price="R$ 50"
            count={50}
            href="/assinar/pro"
            cta="Assinar o Pro"
            items={[
              { text: 'Pesquisa de legislação e jurisprudência na base atualizada' },
              { text: 'Fonte para conferir em cada resultado', pending: 'confirmar' },
              { text: 'Funciona dentro do Claude' },
            ]}
          />
          <PlanCard
            name="Max"
            price="R$ 75,90"
            count={75.9}
            href="/assinar/max"
            cta="Assinar o Max"
            featured
            badge="Mais completo"
            items={[
              { text: 'Tudo do Pro' },
              { text: 'Conferência de processos: o que ainda falta reunir' },
              { text: 'Preparação de peças com citações marcadas para conferência' },
              { text: 'Limite de uso', pending: 'definir' },
            ]}
          />
        </div>
        <ul class="plans-foot small mute" data-reveal>
          <li>Cobrança mensal</li>
          <li>Cartão, Pix ou boleto</li>
        </ul>
        <p class="fine-print mute">
          Reembolso integral em até 7 dias da compra (CDC, art. 49). Veja a <a href="/reembolso">política de reembolso</a>.
        </p>
      </div>
    </section>

    <!-- Dúvidas -->
    <section id="duvidas" class="section section-alt" aria-labelledby="duvidas-title">
      <div class="wrap faq-grid">
        <div class="section-head" data-reveal>
          <h2 id="duvidas-title" class="display-lg" data-split>Antes de assinar</h2>
          <p class="lead">Outras perguntas estão na <a href="/ajuda">Ajuda</a>.</p>
        </div>
        <div data-reveal>
          <Faq>
            <details open>
              <summary>E se a IA errar?</summary>
              <div class="faq-a">
                <p>
                  Cada resposta traz a norma, a súmula ou o julgado de onde saiu, para você abrir e conferir antes
                  de usar. A Órbita entrega um rascunho fundamentado; a análise e a decisão continuam com você.
                </p>
              </div>
            </details>
            <details>
              <summary>Posso cancelar quando quiser?</summary>
              <div class="faq-a">
                <p>
                  Sim, no seu Portal, sem multa. A assinatura para de renovar e o acesso continua até o fim do
                  período já pago. Veja os <a href="/termos">Termos de uso</a>.
                </p>
              </div>
            </details>
            <details>
              <summary>Qual a diferença entre o Pro e o Max?</summary>
              <div class="faq-a">
                <p>
                  O Pro pesquisa legislação e jurisprudência com a fonte de cada resultado. O Max inclui tudo do Pro
                  e soma a conferência de processos, a preparação de peças com citações marcadas, alertas por tema,
                  resumo semanal e suporte prioritário.
                </p>
              </div>
            </details>
            <details>
              <summary>Funciona com qual IA?</summary>
              <div class="faq-a">
                <p>
                  Com o Claude, da Anthropic. Você instala o plugin no Claude que já usa. Os planos do Claude que
                  aceitam plugins estão em confirmação<Pending kind="confirmar" />, e outras IAs ainda não têm
                  data<Pending kind="definir" />.
                </p>
              </div>
            </details>
            <details>
              <summary>O que a base cobre?</summary>
              <div class="faq-a">
                <p>
                  Legislação e jurisprudência brasileira. A lista de tribunais, o período coberto e a frequência de
                  atualização serão publicados com data e critério<Pending kind="definir" />.
                </p>
              </div>
            </details>
            <details>
              <summary>O que acontece com meus dados?</summary>
              <div class="faq-a">
                <p>
                  Tratamos os dados da conta e das consultas conforme a LGPD. O que guardamos, por quanto tempo e se
                  as consultas treinam modelos estará na <a href="/privacidade">política de privacidade</a
                  ><Pending kind="definir" />.
                </p>
              </div>
            </details>
          </Faq>
        </div>
      </div>
    </section>
    <!-- Chamada final (etapa 10f-1): terceira chance de compra, com os dois planos. -->
    <section class="section final-cta" aria-labelledby="final-title">
      <div class="wrap final" data-reveal>
        <h2 id="final-title" class="display-lg" data-split>Comece hoje</h2>
        <p class="lead">Leva poucos minutos para fazer a primeira pergunta.</p>
        <div class="final-actions">
          <Button href="/assinar/pro" variant="secondary">Assinar o Pro · R$ 50/mês</Button>
          <Button href="/assinar/max">Assinar o Max · R$ 75,90/mês</Button>
        </div>
        <p class="small mute">Cartão, Pix ou boleto · cancele quando quiser</p>
      </div>
    </section>

    <!-- Prévia da Ajuda: o formulário completo fica em /ajuda#contato (etapa 10f-4). -->
    <section class="section help-peek" aria-labelledby="ajuda-title">
      <div class="wrap peek" data-reveal>
        <div>
          <h2 id="ajuda-title" class="display-md">Ficou alguma dúvida?</h2>
          <p class="mute">Na Ajuda estão as respostas sobre instalação, cobrança, reembolso e dados. E, se faltar alguma, uma pessoa da equipe responde pelo formulário.</p>
        </div>
        <div class="peek-actions">
          <Button href="/ajuda" variant="secondary">Ver a Ajuda</Button>
          <Button href="/ajuda#contato">Escrever para a equipe</Button>
        </div>
      </div>
    </section>
  </main>
  </div>

  <Footer />
</Base>

<style>
  .peek {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--soft);
  }
  .peek > div:first-child {
    max-width: 60ch;
  }
  .peek h2 {
    margin: 0 0 var(--space-2);
  }
  .peek p {
    margin: 0;
  }
  .peek-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .final {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .final .lead {
    margin: 0;
  }
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .cmp-cta {
    margin: var(--space-6) 0 0;
  }
  .section-alt {
    background: var(--surface);
  }

  /* Passos com linha de progresso */
  .steps-wrap {
    position: relative;
    --p: 0;
  }
  .steps {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .steps-track {
    position: absolute;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .steps-fill {
    position: absolute;
    inset: 0;
    background: var(--brand);
  }
  /* Celular: linha vertical à esquerda dos cartões. */
  .steps-track {
    left: 44px;
    top: 24px;
    bottom: 24px;
    width: 2px;
  }
  .steps-fill {
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  :global(html:not(.anim)) .steps-fill {
    transform: none;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .steps-track {
      left: 0;
      right: 0;
      top: 46px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .steps-fill {
      transform-origin: left;
      transform: scaleX(var(--p));
    }
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 500ms ease-out;
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-round);
    border: 1.5px solid var(--line-strong);
    background: var(--bg);
    font: var(--text-display-md);
    font-size: 22px;
    color: var(--brand);
    transition:
      background-color 500ms ease-out,
      color 500ms ease-out,
      border-color 500ms ease-out,
      transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  :global(html:not(.anim)) .step-n,
  .step.is-lit .step-n {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
  }
  .step.is-lit .step-n {
    transform: scale(1.12);
  }
  .step.is-lit {
    border-color: var(--brand);
  }

  /* Planos */
  .plans {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .plans {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
  .plans-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }
  .fine-print {
    margin-top: var(--space-3);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  /* Dúvidas */
  .faq-grid {
    display: grid;
    gap: var(--space-2);
  }
  .faq-grid .lead a {
    color: var(--brand);
  }
  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
