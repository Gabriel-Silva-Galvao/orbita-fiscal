---
/**
 * Instalar (briefing, Página 4; item 41 da rodada de testes, 26/11/2026): a instalação é pela loja de cada IA.
 * Primeiro a pessoa escolhe a IA (Claude, ChatGPT, Microsoft Copilot ou Gemini); a página mostra o vídeo e os
 * passos daquela IA (src/data/tutoriais.ts), marcados como feitos e lembrados neste navegador, por IA.
 * O último passo, a pergunta de teste, é o mesmo em todas. A escolha fica no endereço (?ia=chatgpt).
 * Nomes das lojas e dos menus e os vídeos ficam "a confirmar" até a Órbita ser publicada em cada loja.
 */
import Focus from '../layouts/Focus.astro';
import Pending from '../components/Pending.astro';
import { plans, brl } from '../data/plans';
import { tutoriais } from '../data/tutoriais';

// Rota do assinante: roda no servidor, atrás do middleware de sessão (src/middleware.ts).
export const prerender = false;

const planData = JSON.stringify(Object.fromEntries(Object.values(plans).map((p) => [p.slug, `${p.name}, ${brl(p.cents)} por mês`])));
const billing = import.meta.env.PUBLIC_BILLING_ENDPOINT ?? '';
const userEmail = Astro.locals.usuario?.email ?? '';
const testQuestion =
  'Execução fiscal parada sem bens localizados. Quando começa a correr a prescrição intercorrente? Traga o fundamento.';
---

<Focus caminho={[{ label: 'Órbita', href: '/' }, { label: 'Minha conta', href: '/conta' }, { label: 'Instalar o plugin' }]} title="Instalar o plugin · Órbita" description="Instale o plugin da Órbita no Claude, conecte sua conta e faça a primeira pergunta.">
  <div class="wrap install" data-install data-plans={planData} data-billing={billing} data-user-email={userEmail}>
    <header class="install-head">
      <h1 class="display-lg">Instale a Órbita na sua IA</h1>
      <p class="lead" data-plan-line>A instalação é pela loja da própria IA, sem baixar arquivo. Escolha a sua para ver o passo a passo.</p>
    </header>

    <!-- 1. Escolha da IA -->
    <fieldset class="escolha">
      <legend class="escolha-t">Em qual IA você vai instalar?</legend>
      <div class="escolha-op">
        {
          tutoriais.map((t, i) => (
            <label class="ia-op">
              <input type="radio" name="ia" value={t.id} checked={i === 0} data-ia-radio />
              <span class="ia-op-nome">{t.nome}</span>
              <span class="ia-op-quem small">{t.loja.quemInstala === 'admin' ? 'Instalado pelo TI da empresa' : 'Você mesmo instala'}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    {
      tutoriais.map((t, i) => (
        <section class="ia-bloco" data-ia-bloco={t.id} hidden={i !== 0} aria-label={`Instalar no ${t.nome}`}>
          {/* 2. Vídeo da IA escolhida */}
          <figure class="video">
            {t.video ? (
              <video controls preload="metadata" src={t.video} />
            ) : (
              <div class="video-vazio" role="img" aria-label={`Vídeo do passo a passo no ${t.nome}, em produção`}>
                <span class="video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                </span>
                <span class="video-t">Vídeo: instalando a Órbita no {t.nome}</span>
                <span class="small mute">Em produção<Pending kind="definir" /></span>
              </div>
            )}
          </figure>

          {/* 3. Onde fica a loja */}
          <div class="loja">
            <p class="small mute">
              Onde fica: <strong>{t.loja.nome}</strong><Pending kind="confirmar" />
            </p>
            <p class="path" aria-label={`Caminho no ${t.nome}`}>
              {t.loja.caminho.map((c) => <span>{c}</span>)}
            </p>
            {t.loja.url ? (
              <a class="btn-main" href={t.loja.url} target="_blank" rel="noopener">Abrir a Órbita na loja</a>
            ) : (
              <p class="small mute">O link direto para a Órbita na loja aparece aqui quando a publicação for aprovada.</p>
            )}
            {t.loja.quemInstala === 'admin' && (
              <p class="notice">No {t.nome}, quem instala é o administrador da empresa. Envie esta página para o TI.</p>
            )}
          </div>

          <div class="meter" aria-hidden="true"><span data-meter></span></div>
          <p class="small mute" data-meter-text>0 de {t.instalacao.length + 1} passos feitos</p>

          {/* 4. Passos da IA escolhida */}
          <ol class="steps">
            {t.instalacao.map((p, n) => (
              <li class="step">
                <div class="step-head">
                  <span class="n">{n + 1}</span>
                  <h2 class="title">{p.titulo}</h2>
                </div>
                <div class="step-body">
                  <p>{p.texto}</p>
                  <label class="done"><input type="checkbox" data-done={String(n + 1)} /> Feito</label>
                </div>
              </li>
            ))}
            <li class="step">
              <div class="step-head">
                <span class="n">{t.instalacao.length + 1}</span>
                <h2 class="title">Faça a primeira pergunta</h2>
              </div>
              <div class="step-body">
                <p>Cole esta pergunta no {t.nome}. A resposta deve trazer as fontes consultadas na base.</p>
                <div class="copy-row">
                  <p class="question" data-question>{testQuestion}</p>
                  <button type="button" class="btn-alt copy" data-copy>Copiar pergunta</button>
                </div>
                <label class="done"><input type="checkbox" data-done={String(t.instalacao.length + 1)} /> Recebi a resposta com as fontes</label>
              </div>
            </li>
          </ol>
        </section>
      ))
    }

    <section class="closing" aria-labelledby="ok-t">
      <h2 id="ok-t" class="display-md">Deu certo?</h2>
      <div class="closing-actions">
        <a class="btn-main" href="/conta">Sim, ir para minha conta</a>
        <a class="btn-alt" href="/ajuda#instalar" data-help>Não, preciso de ajuda</a>
      </div>
    </section>
  </div>
</Focus>

<style>
  .install {
    max-width: 760px;
    display: grid;
    gap: var(--space-7);
  }
  .install-head {
    display: grid;
    gap: var(--space-3);
  }
  .meter {
    height: 6px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
    margin-top: var(--space-2);
  }
  .meter span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--brand);
    transition: width 400ms var(--ease-out);
  }
  /* Item 41: escolha da IA. */
  .escolha {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--space-3);
  }
  .escolha-t {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--ink);
  }
  .escolha-op {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
  }
  .ia-op {
    position: relative;
    display: grid;
    gap: 4px;
    padding: var(--space-4);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    cursor: pointer;
    transition: border-color 200ms, background-color 200ms;
  }
  .ia-op:hover {
    border-color: var(--line-strong);
  }
  .ia-op input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .ia-op:has(input:checked) {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 10%, var(--surface));
  }
  .ia-op:has(input:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  .ia-op-nome {
    font-weight: 600;
    color: var(--ink);
  }
  .ia-op-quem {
    color: var(--mute);
  }
  .ia-bloco {
    display: grid;
    gap: var(--space-4);
  }
  .ia-bloco[hidden] {
    display: none;
  }
  /* Vídeo 16:9 (ou o espaço reservado enquanto o vídeo é gravado). */
  .video {
    margin: 0;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .video video {
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
  }
  .video-vazio {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    text-align: center;
  }
  .video-play {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
  }
  .video-play svg {
    width: 28px;
    height: 28px;
    margin-left: 3px;
  }
  .video-t {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--ink);
  }
  .loja {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .loja .notice {
    width: 100%;
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .step {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--brand);
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }
  .step.is-done .n {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--on-brand);
  }
  .step.is-done .title {
    color: var(--mute);
  }
  .step-body {
    display: grid;
    gap: var(--space-3);
    padding-left: calc(36px + var(--space-3));
    justify-items: start;
  }
  .step-body .btn-main,
  .step-body .btn-alt {
    width: auto;
  }
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font: var(--text-small);
  }
  .path span:not(.pending) {
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .path span:not(.pending) + span:not(.pending)::before {
    content: '›';
    margin: 0 10px 0 -2px;
    color: var(--mute);
  }
  .aside summary {
    cursor: pointer;
    font: var(--text-small);
    color: var(--brand);
  }
  .aside p {
    margin-top: var(--space-2);
    font: var(--text-small);
    color: var(--mute);
  }
  .aside a {
    color: var(--brand);
  }
  .done {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: var(--text-small);
    font-weight: 500;
    cursor: pointer;
  }
  .done input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--brand);
  }
  .copy-row {
    width: 100%;
    display: grid;
    gap: var(--space-2);
  }
  .question {
    padding: 14px 16px;
    border-radius: var(--radius-lg);
    border-bottom-right-radius: 4px;
    background: var(--soft);
    color: var(--ink);
    font-size: 0.9375rem;
  }
  .copy {
    justify-self: start;
  }
  .closing {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .closing-actions {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 600px) {
    .closing-actions {
      grid-template-columns: 1fr 1fr;
    }
    .step-body .notice {
      width: 100%;
    }
  }
  @media (max-width: 480px) {
    .step-body {
      padding-left: 0;
    }
  }
</style>

<script>
  import { getSub } from '../scripts/demo';

  const root = document.querySelector<HTMLElement>('[data-install]')!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const plans = JSON.parse(root.dataset.plans ?? '{}') as Record<string, string>;
  const showPlan = (plano: string, email: string) => {
    $('[data-plan-line]').textContent = `Plano ${plans[plano]}. A instalação é pela loja da própria IA, sem baixar arquivo. Escolha a sua para ver o passo a passo.`;
  };
  const billing = root.dataset.billing ?? '';
  if (billing) {
    // Etapa 7d: com a API, o plano vem da assinatura real.
    fetch(`${billing}/assinatura`, { credentials: 'include' })
      .then((r) => (r.ok ? r.json() : null))
      .then((a) => a?.tem_acesso && showPlan(a.plano, root.dataset.userEmail ?? ''))
      .catch(() => {});
  } else {
    const sub = getSub();
    if (sub) showPlan(sub.plano, sub.email);
  }

  // Item 41: escolha da IA (no endereço, ?ia=…, e lembrada neste navegador) e passos marcados por IA.
  const IA_KEY = 'of-instalar-ia';
  const radios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-ia-radio]'));
  const blocos = Array.from(root.querySelectorAll<HTMLElement>('[data-ia-bloco]'));
  // O Claude continua na chave antiga: o Portal lê esse progresso (passosInstalacao).
  const chave = (ia: string) => (ia === 'claude' ? 'of-demo-instalacao' : `of-demo-instalacao-${ia}`);
  const ajuda: Record<string, string> = { '1': 'instalar', '2': 'nao-aparece', '3': 'conectar', '4': 'conectar' };

  function pintar(bloco: HTMLElement) {
    const ia = bloco.dataset.iaBloco!;
    const boxes = Array.from(bloco.querySelectorAll<HTMLInputElement>('[data-done]'));
    let feitos: string[] = [];
    try {
      feitos = JSON.parse(localStorage.getItem(chave(ia)) ?? '[]');
    } catch {}
    boxes.forEach((b) => {
      b.checked = feitos.includes(b.dataset.done!);
      b.closest('.step')!.classList.toggle('is-done', b.checked);
    });
    const total = boxes.length;
    const n = boxes.filter((b) => b.checked).length;
    bloco.querySelector<HTMLElement>('[data-meter]')!.style.width = `${(n / total) * 100}%`;
    bloco.querySelector<HTMLElement>('[data-meter-text]')!.textContent = `${n} de ${total} passos feitos`;
    const primeiro = boxes.find((b) => !b.checked)?.dataset.done ?? String(total);
    $<HTMLAnchorElement>('[data-help]').href = `/ajuda#${ajuda[primeiro] ?? 'conectar'}`;
  }

  function mostrar(ia: string, gravar = true) {
    if (!blocos.some((b) => b.dataset.iaBloco === ia)) ia = 'claude';
    radios.forEach((r) => (r.checked = r.value === ia));
    blocos.forEach((b) => (b.hidden = b.dataset.iaBloco !== ia));
    pintar(blocos.find((b) => b.dataset.iaBloco === ia)!);
    if (!gravar) return;
    try {
      localStorage.setItem(IA_KEY, ia);
    } catch {}
    const url = new URL(location.href);
    url.searchParams.set('ia', ia);
    history.replaceState(null, '', url);
  }

  blocos.forEach((bloco) => {
    const ia = bloco.dataset.iaBloco!;
    bloco.querySelectorAll<HTMLInputElement>('[data-done]').forEach((b) =>
      b.addEventListener('change', () => {
        let feitos: string[] = [];
        try {
          feitos = JSON.parse(localStorage.getItem(chave(ia)) ?? '[]');
        } catch {}
        feitos = b.checked ? [...new Set([...feitos, b.dataset.done!])] : feitos.filter((d) => d !== b.dataset.done);
        try {
          localStorage.setItem(chave(ia), JSON.stringify(feitos));
        } catch {}
        pintar(bloco);
      }),
    );
  });
  radios.forEach((r) => r.addEventListener('change', () => r.checked && mostrar(r.value)));
  let inicial = new URLSearchParams(location.search).get('ia') ?? '';
  if (!inicial) {
    try {
      inicial = localStorage.getItem(IA_KEY) ?? '';
    } catch {}
  }
  mostrar(inicial || 'claude', false);

  // Copiar a pergunta de teste
  root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const q = btn.closest('.copy-row')!.querySelector<HTMLElement>('[data-question]')!;
      try {
        await navigator.clipboard.writeText(q.textContent ?? '');
        btn.textContent = 'Copiada';
        setTimeout(() => (btn.textContent = 'Copiar pergunta'), 2000);
      } catch {
        const r = document.createRange();
        r.selectNodeContents(q);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(r);
      }
    }),
  );
</script>
