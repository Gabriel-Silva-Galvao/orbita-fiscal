---
/**
 * Página não encontrada (SEO, etapa 8a): responde com status 404 de verdade e fica fora do Google.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Página não encontrada · Órbita" description="O endereço que você abriu não existe na Órbita." noindex>
  <Nav
    signIn="/entrar"
    cta={{ href: '/#planos', label: 'Assinar' }}
  />
  <main id="conteudo" class="section">
    <div class="wrap nf">
      <p class="overline">Erro 404</p>
      <h1 class="display-lg">Esta página não existe</h1>
      <p class="lead">O endereço pode ter mudado ou ter sido digitado com algum erro.</p>
      <div class="row">
        <a class="btn-main" href="/">Ir para o início</a>
        <a class="btn-alt" href="/ajuda">Ver a Ajuda</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: var(--space-8);
  }
  .nf .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
