---
import Button from './Button.astro';
import { aPartirDe } from '../data/plans';

// Título de venda (etapa 10f-1, plano da landing): nomeia o resultado que o advogado quer.
const title = 'A lei e o julgado certos, com a fonte, na IA que você já usa';

// Item 39 (26/11/2026): o cartão com o exemplo de resposta saiu do topo, porque a seção "Com e sem a Órbita",
// logo abaixo, já mostra respostas reais. O texto ficou centralizado, com as órbitas do fundo centradas também.
---

<!-- Item 19: sem o átomo e com o fundo parado. Item 39: sem o exemplo e com o texto centralizado. -->
<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- Fundo: órbitas largas que atravessam a página, com um ponto viajando. -->
  <svg class="hero-bg" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g transform="rotate(-18 720 380)" fill="none" stroke="var(--line)" stroke-width="1.2">
      <ellipse cx="720" cy="380" rx="760" ry="300"></ellipse>
      <ellipse cx="720" cy="380" rx="520" ry="200" stroke-dasharray="2 10"></ellipse>
      <ellipse id="hero-path" cx="720" cy="380" rx="980" ry="420"></ellipse>
    </g>
    <!-- Item 19: os pontos ficam parados sobre as órbitas (o fundo não se mexe mais). -->
    <g transform="rotate(-18 720 380)">
      <circle cx="6" cy="277" r="5" fill="var(--brand)"></circle>
      <circle cx="980" cy="553" r="3.5" fill="var(--brand)" opacity=".6"></circle>
    </g>
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="overline">Para advogados, contadores e empresários</p>
      <!-- SEO (etapa 8d): o título é o maior elemento da primeira tela (LCP). Aparece já pintado, sem entrada animada. -->
      <h1 id="hero-title" class="display-xl hero-title">
        {title}
      </h1>
      <p class="lead">
        Pergunte no Claude como sempre. A Órbita busca na base de legislação e jurisprudência brasileira e
        devolve a resposta com a norma, a súmula ou o julgado para você conferir.
      </p>
      <div class="hero-actions">
        <Button href="#planos">Assinar a partir de {aPartirDe}/mês</Button>
        <Button href="#exemplo" variant="secondary">Ver com e sem a Órbita</Button>
      </div>
      <p class="small mute">Cartão, Pix ou boleto · cancele quando quiser · funciona no Claude</p>
    </div>
  </div>

  <a class="hero-cue" href="#a-base">
    <span>Role para conhecer</span>
    <span class="hero-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-8) var(--space-9);
      min-height: min(860px, calc(100svh - 84px));
      display: grid;
      align-content: center;
    }
  }
  .hero-bg {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    pointer-events: none;
    opacity: 0.9;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
    max-width: 880px;
    margin-inline: auto;
  }
  .hero-title {
    max-width: 840px;
    text-wrap: balance;
  }
  .hero-copy .lead {
    max-width: 620px;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Convite para rolar. */
  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
    text-decoration: none;
  }
  .hero-cue-line {
    width: 1.5px;
    height: 40px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform: translateY(-100%);
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (min-width: 900px) and (min-height: 760px) {
    .hero-cue {
      display: flex;
    }
  }
</style>
