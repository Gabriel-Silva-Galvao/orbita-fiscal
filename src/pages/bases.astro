---
/**
 * O que a Órbita cobre (item 20 da rodada de testes, 25/11/2026).
 * Página de venda com tudo o que o plugin consulta: totais, mapa do Brasil por estado, filtros por tipo,
 * busca e um cartão por base com quantidade, período e documento mais recente.
 * Os números vêm de src/data/cobertura.json, gerado por scripts/cobertura (levantar.py + montar.py) com os
 * comandos documentados de cada base; a página não consulta o servidor ao vivo.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import cobertura from '../data/cobertura.json';
import { aPartirDe } from '../data/plans';
// Mapa do Brasil por estado: @svg-maps/brazil (Victor Cazanave, CC BY 4.0). Crédito na nota final e no rodapé.
import brasil from '@svg-maps/brazil';

type BaseInfo = (typeof cobertura.bases)[number];

const num = (n: number) => n.toLocaleString('pt-BR');
const data = (d: string | null) => (!d ? null : d.length === 4 ? d : `${d.slice(8, 10)}/${d.slice(5, 7)}/${d.slice(0, 4)}`);
const ano = (d: string | null) => (d ? d.slice(0, 4) : null);
const tipoNome = Object.fromEntries(cobertura.tipos.map((t) => [t.id, t.nome]));
const NOMES_UF: Record<string, string> = {
  AC: 'Acre', AL: 'Alagoas', AP: 'Amapá', AM: 'Amazonas', BA: 'Bahia', CE: 'Ceará', DF: 'Distrito Federal',
  ES: 'Espírito Santo', GO: 'Goiás', MA: 'Maranhão', MT: 'Mato Grosso', MS: 'Mato Grosso do Sul', MG: 'Minas Gerais',
  PA: 'Pará', PB: 'Paraíba', PR: 'Paraná', PE: 'Pernambuco', PI: 'Piauí', RJ: 'Rio de Janeiro',
  RN: 'Rio Grande do Norte', RS: 'Rio Grande do Sul', RO: 'Rondônia', RR: 'Roraima', SC: 'Santa Catarina',
  SP: 'São Paulo', SE: 'Sergipe', TO: 'Tocantins',
};

const bases = cobertura.bases as BaseInfo[];
const porTipo = cobertura.tipos
  .map((t) => ({ ...t, bases: bases.filter((b) => b.tipo === t.id) }))
  .filter((t) => t.bases.length)
  .map((t) => ({ ...t, docs: t.bases.reduce((s, b) => s + (b.total ?? 0), 0) }));

const tribunais = bases.filter((b) => ['superiores', 'federal', 'estadual'].includes(b.tipo)).reduce((s, b) => s + (b.total ?? 0), 0);
const ufsCobertas = new Set(bases.map((b) => b.uf).filter(Boolean));
const levantado = data(cobertura.levantado_em);

// Cada estado do mapa com a intensidade da cor pelo número de documentos (raiz quadrada, para os pequenos aparecerem).
const docsUf = (uf: string) => bases.filter((b) => b.uf === uf).reduce((s, b) => s + (b.total ?? 0), 0);
const estados = brasil.locations.map((l) => ({ uf: l.id.toUpperCase(), nome: l.name, path: l.path }));
const maxUf = Math.max(...estados.map((e) => docsUf(e.uf)));
---

<Base
  title="O que a Órbita cobre: as bases de legislação e jurisprudência · Órbita"
  description={`${num(cobertura.total_documentos)} documentos em ${cobertura.total_bases} bases: STF, STJ, TRFs, TJs, CARF, conselhos estaduais, Receita Federal, PGFN e legislação. Veja o que a Órbita consulta.`}
>
  <div class="page-sheet">
    <Nav
      links={[
        { href: '#tipos', label: 'Por tipo' },
        { href: '#mapa', label: 'Mapa' },
        { href: '#todas', label: 'Todas as bases' },
      ]}
      signIn="/entrar"
      cta={{ href: '/#planos', label: 'Assinar' }}
    />

    <main id="conteudo">
      <!-- Topo de venda: os totais -->
      <section class="section cb-top" aria-labelledby="cb-title">
        <div class="wrap">
          <p class="overline">O que a Órbita cobre</p>
          <h1 id="cb-title" class="display-xl cb-h1">
            <span data-count={cobertura.total_documentos}>{num(cobertura.total_documentos)}</span> documentos para a sua IA citar
          </h1>
          <p class="lead cb-lead">
            Lei, súmula, acórdão e consulta da Receita: tudo o que a Órbita pesquisa quando você pergunta no Claude.
            Cada resposta sai daqui, com a fonte para conferir.
          </p>
          <ul class="cb-stats">
            <li><strong data-count={cobertura.total_bases}>{cobertura.total_bases}</strong><span>bases</span></li>
            <li><strong data-count={tribunais}>{num(tribunais)}</strong><span>decisões de tribunais</span></li>
            <li><strong data-count={ufsCobertas.size}>{ufsCobertas.size}</strong><span>estados com base própria</span></li>
          </ul>
          <div class="cb-actions">
            <Button href="/#planos">Assinar a partir de {aPartirDe}/mês</Button>
            <Button href="#todas" variant="secondary">Ver todas as bases</Button>
          </div>
        </div>
      </section>

      <!-- Por tipo -->
      <section id="tipos" class="section section-alt" aria-labelledby="tipos-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="tipos-title" class="display-lg">Do STF ao conselho do seu estado</h2>
            <p class="lead">Clique num grupo para ver as bases dele.</p>
          </div>
          <ul class="cb-tipos">
            {
              porTipo.map((t) => (
                <li>
                  <button type="button" class="cb-tipo" data-pick-tipo={t.id}>
                    <strong>{num(t.docs)}</strong>
                    <span class="cb-tipo-n">{t.nome}</span>
                    <span class="small mute">{t.bases.length === 1 ? '1 base' : `${t.bases.length} bases`}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Mapa -->
      <section id="mapa" class="section" aria-labelledby="mapa-title">
        <div class="wrap cb-mapa-grid">
          <div>
            <div class="section-head">
              <h2 id="mapa-title" class="display-lg">O direito do seu estado também</h2>
              <p class="lead">
                Tribunal de Justiça, conselho de contribuintes, consultas da Fazenda e legislação tributária, estado por estado.
                Clique num estado.
              </p>
            </div>
          </div>
          <div class="cb-uf-painel" data-uf-painel aria-live="polite">
            <p class="mute">Escolha um estado no mapa para ver as bases dele.</p>
          </div>
          <div class="cb-mapa">
            <div class="cb-tip" data-tip aria-hidden="true" hidden></div>
            <svg viewBox={brasil.viewBox} role="group" aria-label="Mapa do Brasil por estado">
              {
                estados.map((e, k) => {
                  const d = docsUf(e.uf);
                  const nivel = d ? 0.25 + 0.75 * Math.sqrt(d / maxUf) : 0;
                  return (
                    <path
                      d={e.path}
                      class:list={['cb-uf', { 'is-vazio': !d }]}
                      style={`--n:${nivel.toFixed(2)};--k:${k}`}
                      data-uf={e.uf}
                      data-nome={e.nome}
                      tabindex="0"
                      role="button"
                      aria-label={d ? `${e.nome}: ${num(d)} documentos` : `${e.nome}: coberto pelos tribunais superiores e federais`}
                    >
                      <title>{d ? `${e.nome}: ${num(d)} documentos` : e.nome}</title>
                    </path>
                  );
                })
              }
            </svg>
            <p class="small mute cb-legenda"><span class="cb-leg-bar" aria-hidden="true"></span> Cor mais forte, mais documentos</p>
          </div>
        </div>
      </section>

      <!-- Faixa de venda -->
      <section class="section section-alt cb-faixa">
        <div class="wrap cb-faixa-in">
          <p class="display-md">Sem a base, a IA responde de memória. Com a Órbita, ela cita a fonte.</p>
          <Button href="/#exemplo" variant="secondary">Ver a mesma pergunta com e sem a Órbita</Button>
        </div>
      </section>

      <!-- Todas as bases -->
      <section id="todas" class="section" aria-labelledby="todas-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="todas-title" class="display-lg">Todas as bases</h2>
            <p class="lead">Procure por tribunal, órgão ou estado.</p>
          </div>
          <div class="cb-ctrl">
            <label class="cb-busca">
              <span class="sr-only">Buscar base</span>
              <input type="search" placeholder="Ex.: CARF, Bahia, PGFN, súmula" data-busca autocomplete="off" />
            </label>
            <div class="cb-chips" role="group" aria-label="Filtrar por tipo">
              <button type="button" class="cb-chip" aria-pressed="true" data-tipo="">Todas</button>
              {porTipo.map((t) => <button type="button" class="cb-chip" aria-pressed="false" data-tipo={t.id}>{t.nome}</button>)}
            </div>
            <div class="cb-filtro-linha">
              <p class="small mute" data-contagem aria-live="polite">{bases.length} bases</p>
              <button type="button" class="cb-uf-filtro" data-uf-filtro hidden></button>
            </div>
          </div>
          <ul class="cb-lista">
            {
              bases.map((b) => (
                <li
                  class="cb-card"
                  data-card
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                  data-tipo={b.tipo}
                  data-uf={b.uf ?? ''}
                  data-texto={`${b.titulo} ${b.id} ${b.uf ?? 'nacional'} ${b.uf ? NOMES_UF[b.uf] : ''} ${tipoNome[b.tipo] ?? ''}`.toLowerCase()}
                  data-fonte={b.fonte ?? ''}
                  data-periodo={b.inicio && b.fim ? `De ${data(b.inicio)} a ${data(b.fim)}` : b.fim ? `Mais recente: ${data(b.fim)}` : 'Período a confirmar'}
                  data-carga={b.ultima_carga ? data(b.ultima_carga) : ''}
                  data-area={b.plugin === 'orbita-juridica' ? 'Jurídico' : 'Tributário'}
                  data-tipo-nome={tipoNome[b.tipo]}
                >
                  <p class="cb-card-k small">
                    {tipoNome[b.tipo]} · {b.uf ?? 'Nacional'} · {b.plugin === 'orbita-juridica' ? 'Jurídico' : 'Tributário'}
                  </p>
                  <h3 class="cb-card-t">{b.titulo}</h3>
                  <p class="cb-card-n">
                    {b.total !== null ? <><strong>{num(b.total)}</strong> {b.unidade === 'documentos' ? 'documentos' : b.unidade}</> : <span class="mute">quantidade a confirmar</span>}
                  </p>
                  <p class="small mute">
                    {b.inicio && b.fim ? `De ${ano(b.inicio)} a ${data(b.fim)}` : b.fim ? `Mais recente: ${data(b.fim)}` : 'Período a confirmar'}
                    {b.ultima_carga && ` · atualizada em ${data(b.ultima_carga)}`}
                  </p>
                  <span class="cb-card-abrir small" aria-hidden="true">Ver detalhes</span>
                  <dl class="cb-card-mais" hidden>
                    {b.fonte && (<><dt>O que é</dt><dd>{b.fonte}</dd></>)}
                    <dt>Área</dt>
                    <dd>{b.plugin === 'orbita-juridica' ? 'Jurídico (plugin Órbita Jurídica)' : 'Tributário (plugin Órbita Fiscal)'}</dd>
                    <dt>Período</dt>
                    <dd>{b.inicio && b.fim ? `De ${data(b.inicio)} a ${data(b.fim)}` : b.fim ? `Mais recente: ${data(b.fim)}` : 'a confirmar'}</dd>
                    {b.ultima_carga && (<><dt>Atualizada em</dt><dd>{data(b.ultima_carga)}</dd></>)}
                  </dl>
                </li>
              ))
            }
          </ul>
          <nav class="cb-pager" aria-label="Páginas da lista de bases" data-pager></nav>
          <p class="cb-vazio mute" data-vazio hidden>Nenhuma base com esse nome. Tente o tribunal, o órgão ou o estado.</p>
        </div>
      </section>

      <!-- CTA final -->
      <section class="section section-alt final-cta">
        <div class="wrap cb-final">
          <h2 class="display-lg">Tudo isso dentro do Claude, a partir de {aPartirDe}/mês</h2>
          <p class="lead">Reembolso integral em até 7 dias. Cancele quando quiser.</p>
          <div class="cb-actions">
            <Button href="/#planos">Ver os três planos</Button>
            <Button href="/empresas" variant="secondary">Planos empresariais</Button>
          </div>
          <p class="small mute">
            Números levantados em {levantado} nas próprias bases da Órbita. "Documentos" são acórdãos, decisões, consultas,
            pareceres e normas, conforme a base; o período vai do documento mais antigo ao mais recente com data. Mapa: @svg-maps/brazil, de Victor Cazanave (CC BY 4.0).
          </p>
        </div>
      </section>
    </main>
  </div>
  <Footer />
</Base>

<script>
  /* Contadores, mapa, filtros e busca. Sem JavaScript, a página mostra tudo e os números finais. */
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number) => Math.round(n).toLocaleString('pt-BR');

  if (!reduzido) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const alvo = Number(el.dataset.count);
        const t0 = performance.now();
        const passo = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = fmt(alvo * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      });
    });
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));
  }

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tipo]')).filter((b) => b.tagName === 'BUTTON');
  const busca = document.querySelector<HTMLInputElement>('[data-busca]')!;
  const contagem = document.querySelector<HTMLElement>('[data-contagem]')!;
  const vazio = document.querySelector<HTMLElement>('[data-vazio]')!;
  const estado = { tipo: '', uf: '', q: '' };
  const semAcento = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  // A lista mostra 12 bases por página: menos cartões na tela de uma vez, página mais leve.
  const POR_PAGINA = 12;
  const pager = document.querySelector<HTMLElement>('[data-pager]')!;
  const filtroUf = document.querySelector<HTMLButtonElement>('[data-uf-filtro]')!;
  let pagina = 1;
  let achadas: HTMLElement[] = cards;

  function mostrar(rolar = false) {
    const paginas = Math.max(1, Math.ceil(achadas.length / POR_PAGINA));
    pagina = Math.min(pagina, paginas);
    const ini = (pagina - 1) * POR_PAGINA;
    const visiveis = new Set(achadas.slice(ini, ini + POR_PAGINA));
    cards.forEach((c) => {
      const v = visiveis.has(c);
      c.hidden = !v;
      c.classList.toggle('is-new', v && !reduzido);
    });
    pager.replaceChildren();
    if (paginas > 1) {
      const botao = (rotulo: string, alvo: number, opts: { atual?: boolean; off?: boolean; aria?: string } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cb-pg';
        b.textContent = rotulo;
        if (opts.aria) b.setAttribute('aria-label', opts.aria);
        if (opts.atual) b.setAttribute('aria-current', 'page');
        b.disabled = !!opts.off;
        b.addEventListener('click', () => {
          pagina = alvo;
          mostrar(true);
        });
        pager.append(b);
      };
      botao('‹', pagina - 1, { off: pagina === 1, aria: 'Página anterior' });
      for (let i = 1; i <= paginas; i++) {
        if (i === 1 || i === paginas || Math.abs(i - pagina) <= 1) {
          botao(String(i), i, { atual: i === pagina, aria: `Página ${i}` });
        } else if (Math.abs(i - pagina) === 2) {
          const r = document.createElement('span');
          r.className = 'cb-pg-gap';
          r.textContent = '…';
          pager.append(r);
        }
      }
      botao('›', pagina + 1, { off: pagina === paginas, aria: 'Próxima página' });
    }
    if (rolar) document.getElementById('todas-title')?.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth', block: 'start' });
  }

  function filtrar() {
    const q = semAcento(estado.q.trim());
    achadas = cards.filter(
      (c) =>
        (!estado.tipo || estado.tipo.split(',').includes(c.dataset.tipo ?? '')) &&
        (!estado.uf || c.dataset.uf === estado.uf) &&
        (!q || q.split(/\s+/).every((p) => semAcento(c.dataset.texto ?? '').includes(p))),
    );
    const n = achadas.length;
    pagina = 1;
    contagem.textContent = `${n} ${n === 1 ? 'base' : 'bases'}`;
    filtroUf.hidden = !estado.uf;
    filtroUf.textContent = estado.uf ? `Estado: ${estado.uf} ✕` : '';
    filtroUf.setAttribute('aria-label', estado.uf ? `Tirar o filtro do estado ${estado.uf} e mostrar todas as bases` : '');
    vazio.hidden = n > 0;
    mostrar();
  }
  // Item 15: os cards da landing chegam com ?tipo=... (um ou mais tipos, separados por vírgula).
  {
    const pedido = new URLSearchParams(location.search).get('tipo');
    if (pedido) {
      estado.tipo = pedido;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tipo === pedido)));
    }
  }
  filtrar();
  function escolherTipo(tipo: string) {
    estado.tipo = tipo;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tipo === tipo)));
    filtrar();
  }
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      if (!c.dataset.tipo) estado.uf = '';
      escolherTipo(c.dataset.tipo ?? '');
    }),
  );
  filtroUf.addEventListener('click', () => {
    estado.uf = '';
    limparMapa();
    filtrar();
  });

  // Cartões: clique (ou Enter) abre e fecha os detalhes da base.
  cards.forEach((c) => {
    const alternar = () => {
      const abre = c.getAttribute('aria-expanded') !== 'true';
      c.setAttribute('aria-expanded', String(abre));
      c.querySelector<HTMLElement>('.cb-card-mais')!.hidden = !abre;
      const rot = c.querySelector<HTMLElement>('.cb-card-abrir');
      if (rot) rot.textContent = abre ? 'Fechar detalhes' : 'Ver detalhes';
    };
    c.addEventListener('click', alternar);
    c.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        alternar();
      }
    });
  });
  busca.addEventListener('input', () => {
    estado.q = busca.value;
    filtrar();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-pick-tipo]').forEach((b) =>
    b.addEventListener('click', () => {
      estado.uf = '';
      escolherTipo(b.dataset.pickTipo ?? '');
      document.getElementById('todas')?.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth' });
    }),
  );

  // Mapa: o painel lista as bases do estado e um botão filtra a lista completa.
  const painel = document.querySelector<HTMLElement>('[data-uf-painel]')!;
  const ufs = Array.from(document.querySelectorAll<SVGPathElement>('.cb-uf'));
  const mapa = document.querySelector<HTMLElement>('.cb-mapa')!;
  new IntersectionObserver((es, io) => {
    if (es.some((e) => e.isIntersecting)) {
      mapa.classList.add('is-in');
      io.disconnect();
    }
  }, { threshold: 0.3 }).observe(mapa);
  const svg = mapa.querySelector('svg')!;
  const tip = mapa.querySelector<HTMLElement>('[data-tip]')!;
  const doEstado = (uf: string) => cards.filter((c) => c.dataset.uf === uf);
  const fmtN = (n: number) => n.toLocaleString('pt-BR');
  const docs = (lista: HTMLElement[]) =>
    lista.reduce((s, c) => s + Number((c.querySelector('.cb-card-n strong')?.textContent ?? '0').replace(/\./g, '')), 0);
  let fixo: SVGPathElement | null = null;

  // Sigla no hover (e no foco do teclado): a etiqueta fica no centro do estado.
  // No estado escolhido, a etiqueta mostra a sigla e o total, um pouco acima dele.
  function etiqueta(b: SVGPathElement, detalhe = false) {
    const r = b.getBoundingClientRect();
    const m = mapa.getBoundingClientRect();
    const uf = b.dataset.uf!;
    const lista = doEstado(uf);
    tip.textContent = detalhe && lista.length ? `${uf} · ${fmtN(docs(lista))} documentos` : uf;
    tip.style.left = `${r.left - m.left + r.width / 2}px`;
    tip.style.top = `${r.top - m.top + r.height / 2}px`;
    tip.classList.toggle('is-fixo', detalhe);
    tip.hidden = false;
  }
  const soltar = () => {
    if (fixo) etiqueta(fixo, true);
    else tip.hidden = true;
  };

  const vazioPainel = painel.innerHTML;
  // Volta o mapa ao início: nenhum estado escolhido, painel com a instrução.
  function limparMapa() {
    fixo = null;
    ufs.forEach((x) => x.classList.remove('is-on'));
    tip.hidden = true;
    painel.innerHTML = vazioPainel;
  }

  const abrir = (b: SVGPathElement) => {
    const uf = b.dataset.uf!;
    if (fixo === b) {
      // Clicar no estado já escolhido desmarca e, se a lista estava filtrada por ele, volta a mostrar tudo.
      limparMapa();
      if (estado.uf === uf) {
        estado.uf = '';
        filtrar();
      }
      return;
    }
    fixo = b;
    ufs.forEach((x) => x.classList.toggle('is-on', x === b));
    svg.append(b); // o escolhido vai para a frente e sobe por cima dos vizinhos
    etiqueta(b, true);
    setTimeout(() => fixo === b && etiqueta(b, true), 450); // reposiciona depois que o estado termina de subir
    const doUf = doEstado(uf);
    painel.replaceChildren();
    painel.classList.remove('is-novo');
    void painel.offsetWidth;
    painel.classList.add('is-novo');

    const h = document.createElement('h3');
    h.className = 'title';
    h.textContent = b.dataset.nome ?? uf;
    painel.append(h);
    if (!doUf.length) {
      const p = document.createElement('p');
      p.className = 'mute';
      p.textContent = 'Ainda sem base própria deste estado. As causas daqui chegam ao STF, ao STJ e ao TRF da região, que a Órbita cobre.';
      painel.append(p);
      return;
    }

    // Resumo do estado: documentos, bases e o maior acervo.
    const resumo = document.createElement('div');
    resumo.className = 'cb-uf-resumo';
    const item = (n: string, k: string) => {
      const d = document.createElement('div');
      const st = document.createElement('strong');
      st.textContent = n;
      const sp = document.createElement('span');
      sp.textContent = k;
      d.append(st, sp);
      return d;
    };
    resumo.append(item(fmtN(docs(doUf)), 'documentos'), item(String(doUf.length), doUf.length === 1 ? 'base' : 'bases'));
    const maior = document.createElement('p');
    maior.className = 'small cb-uf-maior';
    maior.textContent = `Maior acervo: ${doUf[0]?.querySelector('.cb-card-t')?.textContent ?? ''}`;
    painel.append(resumo, maior);

    // Cada base do estado: hover com destaque e, no clique, mais sobre a documentação.
    const ul = document.createElement('ul');
    ul.className = 'cb-uf-lista';
    doUf.forEach((c, k) => {
      const li = document.createElement('li');
      li.style.setProperty('--k', String(k));
      const bt = document.createElement('button');
      bt.type = 'button';
      bt.className = 'cb-uf-item';
      bt.setAttribute('aria-expanded', 'false');
      const t = document.createElement('span');
      t.textContent = c.querySelector('.cb-card-t')?.textContent ?? '';
      const n = document.createElement('strong');
      n.textContent = c.querySelector('.cb-card-n strong')?.textContent ?? 'a confirmar';
      bt.append(t, n);
      const mais = document.createElement('div');
      mais.className = 'cb-uf-mais';
      mais.hidden = true;
      const dl = document.createElement('dl');
      const linhas: [string, string | undefined][] = [
        ['O que é', c.dataset.fonte],
        ['Tipo', `${c.dataset.tipoNome} · ${c.dataset.area}`],
        ['Período', c.dataset.periodo],
        ['Atualizada em', c.dataset.carga],
      ];
      linhas
        .filter(([, v]) => v)
        .forEach(([rot, v]) => {
          const dt = document.createElement('dt');
          dt.textContent = rot;
          const dd = document.createElement('dd');
          dd.textContent = v!;
          dl.append(dt, dd);
        });
      mais.append(dl);
      bt.addEventListener('click', () => {
        const abre = bt.getAttribute('aria-expanded') !== 'true';
        bt.setAttribute('aria-expanded', String(abre));
        mais.hidden = !abre;
        li.classList.toggle('is-aberto', abre);
      });
      li.append(bt, mais);
      ul.append(li);
    });
    const ver = document.createElement('button');
    ver.type = 'button';
    ver.className = 'link-btn';
    ver.textContent = `Ver as ${doUf.length} bases de ${uf} na lista`;
    ver.addEventListener('click', () => {
      estado.uf = uf;
      escolherTipo('');
      document.getElementById('todas')?.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth' });
    });
    painel.append(ul, ver);
  };
  ufs.forEach((b) => {
    b.addEventListener('pointerenter', () => etiqueta(b, b === fixo));
    b.addEventListener('pointerleave', soltar);
    b.addEventListener('focus', () => etiqueta(b, b === fixo));
    b.addEventListener('blur', soltar);
  });
  ufs.forEach((b) => {
    b.addEventListener('click', () => abrir(b));
    b.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        abrir(b);
      }
    });
  });
