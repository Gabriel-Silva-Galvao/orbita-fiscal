---
/**
 * Cena "Direito brasileiro": foto real do Congresso Nacional, em Brasília.
 * Ao entrar na tela a foto acende devagar (sai do desfoque e assenta) e depois segue respirando,
 * num zoom lento, enquanto desce em parallax. Sem movimento reduzido, aparece parada.
 */
import Photo from './Photo.astro';
---

<div class="br" data-parallax data-br>
  <div class="br-photo" data-speed="-0.35">
    <Photo name="congresso" sizes="(min-width: 1180px) 1100px, 100vw" />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-br]').forEach((el) => {
    if (!document.documentElement.classList.contains('anim')) return;
    const io = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          el.classList.add('is-in');
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  });
</script>

<style>
  .br {
    position: relative;
    height: clamp(300px, 44vw, 520px);
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--soft);
    margin-bottom: var(--space-7);
  }
  .br-photo {
    position: absolute;
    left: 0;
    width: 100%;
    top: -14%;
    height: 128%;
    will-change: transform;
  }
  .br-photo :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Entrada sutil: a foto sai do desfoque e assenta; depois respira num zoom lento. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.anim) .br-photo :global(.photo) {
      opacity: 0;
      filter: blur(14px) saturate(0.6);
      transform: scale(1.12);
    }
    :global(.anim) .br.is-in .br-photo :global(.photo) {
      animation:
        br-in 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards,
        br-breathe 16s ease-in-out 1.8s infinite alternate;
    }
  }
  @keyframes br-in {
    to {
      opacity: 1;
      filter: none;
      transform: scale(1.03);
    }
  }
  @keyframes br-breathe {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1.09) translateX(-1.5%);
    }
  }
</style>
