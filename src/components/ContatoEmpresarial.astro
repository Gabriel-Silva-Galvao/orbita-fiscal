---
/**
 * Contato para planos empresariais (item 26 da rodada de testes, 25/11/2026).
 * Qualquer botão com [data-contato-empresarial] abre esta janela. A animação:
 *  1. um envelope fechado sobe até o centro, com o fundo escurecendo;
 *  2. a aba abre (giro 3D) e a carta desliza para fora;
 *  3. a carta cresce e vira a janela de e-mail, já endereçada à Órbita;
 *  4. ao enviar, a carta encolhe de volta, a aba fecha e o envelope voa para fora; aparece a confirmação.
 * Fechar (X, Esc, clique fora) faz o caminho inverso, sem enviar. Com movimento reduzido, a janela aparece direto.
 * O envio vai para a API (POST /contato/empresarial), que manda para o e-mail da Órbita.
 */
import { contact } from '../data/site';

const authEndpoint = import.meta.env.PUBLIC_AUTH_ENDPOINT ?? '';
const api = authEndpoint.replace(/\/auth\/?$/, '');
---

<dialog class="ce" data-ce data-api={api} aria-labelledby="ce-titulo">
  <div class="ce-palco" data-ce-palco>
    <div class="ce-envelope" aria-hidden="true">
      <div class="ce-fundo"></div>
      <div class="ce-aba"></div>
      <div class="ce-frente"></div>
    </div>

    <div class="ce-carta" data-ce-carta>
      <div class="ce-barra">
        <span class="ce-bolinhas" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2 id="ce-titulo">Escrever para a equipe da Órbita</h2>
        <button type="button" class="ce-x" data-ce-fechar aria-label="Fechar sem enviar">×</button>
      </div>

      <form method="post" class="ce-form" data-ce-form novalidate>
        <p class="ce-linha"><span>Para</span><strong>Equipe Órbita &lt;{contact.email}&gt;</strong></p>
        <p class="ce-linha"><span>Assunto</span><strong>Plano empresarial</strong></p>
        <div class="ce-campos">
          <label>Seu nome<input name="nome" autocomplete="name" required maxlength="120" /></label>
          <label>Empresa ou escritório<input name="empresa" autocomplete="organization" required maxlength="160" /></label>
          <label>Seu e-mail<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
          <label>
            Quantas pessoas vão usar
            <select name="usuarios">
              <option value="">Prefiro não dizer</option>
              <option>2 a 5</option>
              <option>6 a 20</option>
              <option>21 a 50</option>
              <option>Mais de 50</option>
            </select>
          </label>
          <label class="ce-msg">
            Mensagem
            <textarea name="mensagem" rows="5" required maxlength="4000" placeholder="Conte um pouco do que vocês precisam: área, volume de pesquisa, se querem uma conversa."></textarea>
          </label>
          <!-- Isca para robôs: pessoas não veem este campo. -->
          <label class="ce-isca" aria-hidden="true">Site<input name="site" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="ce-erro" data-ce-erro role="alert" hidden></p>
        <div class="ce-acoes">
          <button type="button" class="ce-sec" data-ce-fechar>Cancelar</button>
          <button type="submit" class="ce-enviar" data-ce-enviar>Enviar</button>
        </div>
      </form>
    </div>

    <div class="ce-ok" data-ce-ok role="status" hidden>
      <p class="ce-ok-t">Mensagem enviada</p>
      <p data-ce-ok-txt>Uma pessoa da equipe responde pelo seu e-mail.</p>
      <button type="button" class="ce-enviar" data-ce-fechar>Fechar</button>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-ce]');
  if (dlg) {
    const palco = dlg.querySelector<HTMLElement>('[data-ce-palco]')!;
    const form = dlg.querySelector<HTMLFormElement>('[data-ce-form]')!;
    const erro = dlg.querySelector<HTMLElement>('[data-ce-erro]')!;
    const ok = dlg.querySelector<HTMLElement>('[data-ce-ok]')!;
    const enviar = dlg.querySelector<HTMLButtonElement>('[data-ce-enviar]')!;
    const api = dlg.dataset.api ?? '';
    const reduzido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const esperar = (ms: number) => new Promise((r) => setTimeout(r, reduzido() ? 0 : ms));
    let ocupado = false;
    let origem: HTMLElement | null = null;

    const fase = (f: string) => (palco.dataset.fase = f);

    async function abrir(botao: HTMLElement) {
      if (ocupado || dlg!.open) return;
      ocupado = true;
      origem = botao;
      ok.hidden = true;
      form.hidden = false;
      erro.hidden = true;
      // Preenche com a conta, se a pessoa estiver logada (cópia do header, item 1).
      try {
        const u = JSON.parse(sessionStorage.getItem('orbita:sessao') ?? 'null');
        if (u) {
          (form.elements.namedItem('nome') as HTMLInputElement).value ||= u.nome ?? '';
          (form.elements.namedItem('email') as HTMLInputElement).value ||= u.email ?? '';
        }
      } catch {
        /* sem cópia da sessão */
      }
      fase('inicio');
      dlg!.showModal();
      if (!reduzido()) {
        await esperar(30);
        fase('sobe'); // envelope sobe até o centro
        await esperar(520);
        fase('abre'); // a aba gira e abre
        await esperar(420);
        fase('carta'); // a carta desliza para fora
        await esperar(420);
      }
      fase('janela'); // a carta vira a janela de e-mail
      await esperar(360);
      (form.elements.namedItem((form.elements.namedItem('nome') as HTMLInputElement).value ? 'mensagem' : 'nome') as HTMLElement).focus();
      ocupado = false;
    }

    async function fechar() {
      if (ocupado) return;
      ocupado = true;
      if (!reduzido() && palco.dataset.fase === 'janela') {
        fase('carta');
        await esperar(320);
        fase('abre');
        await esperar(320);
        fase('sobe');
        await esperar(280);
        fase('inicio');
        await esperar(360);
      }
      dlg!.close();
      ocupado = false;
      origem?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-contato-empresarial]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        abrir(b);
      }),
    );
    dlg.querySelectorAll('[data-ce-fechar]').forEach((b) => b.addEventListener('click', fechar));
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault(); // Esc: fecha com a animação
      fechar();
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) fechar();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (ocupado) return;
      const dados = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const faltando =
        (dados.nome ?? '').trim().length < 2 ||
        (dados.empresa ?? '').trim().length < 2 ||
        !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(dados.email ?? '') ||
        (dados.mensagem ?? '').trim().length < 10;
      if (faltando) {
        erro.textContent = 'Preencha nome, empresa, um e-mail válido e uma mensagem (pelo menos 10 caracteres).';
        erro.hidden = false;
        return;
      }
      ocupado = true;
      enviar.disabled = true;
      enviar.textContent = 'Enviando…';
      erro.hidden = true;
      let texto = 'Uma pessoa da equipe responde pelo seu e-mail.';
      try {
        if (api) {
          const r = await fetch(`${api}/contato/empresarial`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dados),
          });
          if (!r.ok) {
            const j = await r.json().catch(() => ({}));
            throw new Error(j.descricao || 'Não deu para enviar agora. Tente de novo em instantes.');
          }
          const j = await r.json();
          if (!j.enviado) texto = 'Demonstração: a mensagem ficou registrada, mas o e-mail só sai com o servidor de e-mail configurado.';
        } else {
          texto = 'Demonstração: no site publicado, a mensagem vai para o e-mail da Órbita.';
        }
      } catch (err) {
        erro.textContent = (err as Error).message;
        erro.hidden = false;
        ocupado = false;
        enviar.disabled = false;
        enviar.textContent = 'Enviar';
        return;
      }
      // A carta volta para o envelope, a aba fecha e o envelope voa.
      if (!reduzido()) {
        fase('carta');
        await esperar(320);
        fase('abre');
        await esperar(300);
        fase('fechado');
        await esperar(380);
        fase('voa');
        await esperar(650);
      }
      form.reset();
      form.hidden = true;
      dlg.querySelector('[data-ce-ok-txt]')!.textContent = texto;
      ok.hidden = false;
      fase('enviado');
      enviar.disabled = false;
      enviar.textContent = 'Enviar';
      ocupado = false;
      ok.querySelector<HTMLElement>('[data-ce-fechar]')!.focus();
    });
  }
</script>

<style>
  .ce {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .ce::backdrop {
    background: rgb(5 15 13 / 0.55);
    backdrop-filter: blur(3px);
    animation: ce-escurece 300ms ease-out;
  }
  @keyframes ce-escurece {
    from {
      opacity: 0;
    }
  }
  .ce-palco {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1000px;
    pointer-events: none;
  }
  .ce-palco > * {
    grid-area: 1 / 1;
  }

  /* Envelope, desenhado em CSS. */
  .ce-envelope {
    position: relative;
    width: min(360px, 80vw);
    aspect-ratio: 3 / 2;
    transform-style: preserve-3d;
    transform: translateY(70vh) scale(0.45) rotate(-6deg);
    opacity: 0;
    transition:
      transform 520ms cubic-bezier(0.2, 0.9, 0.3, 1.15),
      opacity 300ms;
  }
  .ce-fundo,
  .ce-frente,
  .ce-aba {
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }
  .ce-fundo {
    background: #dfe8e0;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.35);
  }
  .ce-frente {
    z-index: 3;
    background:
      linear-gradient(to top right, #f4f7f2 50%, transparent 50.5%) left bottom / 50% 100% no-repeat,
      linear-gradient(to top left, #eef3ec 50%, transparent 50.5%) right bottom / 50% 100% no-repeat;
  }
  .ce-aba {
    z-index: 4;
    height: 62%;
    background: linear-gradient(to bottom, #e8efe6, #d6e2d6);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: top;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    backface-visibility: hidden;
  }

  /* Carta: dentro do envelope no começo; depois cresce e vira a janela de e-mail. */
  .ce-carta {
    position: relative;
    z-index: 2;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow: auto;
    border-radius: 14px;
    background: #ffffff;
    color: #111827;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.4);
    transform: translateY(70vh) scale(0.3);
    opacity: 0;
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 260ms;
    pointer-events: auto;
  }

  /* Fases (data-fase no palco). */
  [data-fase='sobe'] .ce-envelope,
  [data-fase='abre'] .ce-envelope,
  [data-fase='carta'] .ce-envelope,
  [data-fase='fechado'] .ce-envelope {
    transform: none;
    opacity: 1;
  }
  [data-fase='abre'] .ce-aba,
  [data-fase='carta'] .ce-aba {
    transform: rotateX(180deg);
  }
  [data-fase='abre'] .ce-carta {
    transform: translateY(10%) scale(0.5);
    opacity: 0;
  }
  [data-fase='carta'] .ce-carta {
    transform: translateY(-38%) scale(0.52);
    opacity: 1;
  }
  [data-fase='janela'] .ce-envelope {
    transform: translateY(40vh) scale(0.8);
    opacity: 0;
  }
  [data-fase='janela'] .ce-carta {
    transform: none;
    opacity: 1;
  }
  [data-fase='voa'] .ce-envelope {
    transform: translate(70vw, -80vh) rotate(18deg) scale(0.4);
    opacity: 0;
    transition:
      transform 650ms cubic-bezier(0.5, 0, 0.75, 0),
      opacity 650ms ease-in;
  }
  [data-fase='voa'] .ce-carta,
  [data-fase='fechado'] .ce-carta,
  [data-fase='enviado'] .ce-carta {
    opacity: 0;
    transform: translateY(10%) scale(0.4);
  }
  [data-fase='enviado'] .ce-carta {
    display: none;
  }

  /* Janela de e-mail. */
  .ce-barra {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    background: #f9fafb;
  }
  .ce-bolinhas {
    display: flex;
    gap: 6px;
  }
  .ce-bolinhas i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d1d5db;
  }
  .ce-barra h2 {
    flex: 1;
    margin: 0;
    font: 600 0.9375rem/1.3 var(--font-body, inherit);
    color: #111827;
  }
  .ce-x {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #374151;
    font-size: 1.375rem;
    line-height: 1;
    cursor: pointer;
  }
  .ce-x:hover {
    background: #e5e7eb;
  }
  .ce-form {
    display: grid;
    gap: 12px;
    padding: 16px 20px 20px;
  }
  .ce-linha {
    display: flex;
    gap: 12px;
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid #f0f1f3;
    font-size: 0.875rem;
  }
  .ce-linha span {
    width: 64px;
    color: #6b7280;
  }
  .ce-linha strong {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .ce-campos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .ce-campos label {
    display: grid;
    gap: 4px;
    font-size: 0.8125rem;
    color: #374151;
  }
  .ce-msg {
    grid-column: 1 / -1;
  }
  .ce-campos input,
  .ce-campos select,
  .ce-campos textarea {
    width: 100%;
    padding: 9px 11px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #ffffff;
    color: #111827;
    font: inherit;
    font-size: 0.9375rem;
  }
  .ce-campos textarea {
    resize: vertical;
  }
  .ce-campos :focus {
    outline: 2px solid #10634f;
    outline-offset: 1px;
    border-color: #10634f;
  }
  .ce-isca {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .ce-erro {
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: #fef2f2;
    color: #991b1b;
    font-size: 0.875rem;
  }
  .ce-acoes {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .ce-enviar,
  .ce-sec {
    min-height: 42px;
    padding: 0 18px;
    border-radius: 10px;
    font: 600 0.9375rem/1 var(--font-body, inherit);
    cursor: pointer;
  }
  .ce-enviar {
    border: 0;
    background: #10634f;
    color: #ffffff;
  }
  .ce-enviar:hover {
    background: #0b4a3b;
  }
  .ce-enviar:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .ce-sec {
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #111827;
  }
  .ce-ok {
    z-index: 5;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: min(420px, calc(100vw - 32px));
    padding: 28px 24px;
    border-radius: 14px;
    background: #ffffff;
    color: #111827;
    text-align: center;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.4);
    pointer-events: auto;
    animation: ce-ok 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ce-ok[hidden] {
    display: none;
  }
  .ce-ok p {
    margin: 0;
    color: #4b5563;
  }
  .ce-ok .ce-ok-t {
    color: #10634f;
    font: 600 1.25rem/1.3 var(--font-display, inherit);
  }
  @keyframes ce-ok {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }
  @media (max-width: 560px) {
    .ce-campos {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ce-envelope {
      display: none;
    }
    .ce-carta,
    .ce-ok {
      transition: none;
      animation: none;
    }
  }
</style>
