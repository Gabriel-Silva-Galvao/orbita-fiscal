---
/**
 * “O dia a dia”: quatro momentos, do papel à peça revisada.
 * Desktop com movimento: o texto rola à esquerda e uma única moldura fica parada à direita
 * (position: sticky), trocando de foto com um esmaecer suave quando cada momento fica ativo.
 * Uma linha com pontos de órbita liga os momentos e se preenche com a rolagem.
 * Celular ou sem movimento: cada momento mostra a própria foto, em lista.
 */
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/photos';

const steps: { n: string; photo: PhotoKey; title: string; text: string }[] = [
  {
    n: '01',
    photo: 'pilha',
    title: 'A pilha de sempre',
    text: 'Processos, normas e julgados espalhados em várias bases, e a mesma busca refeita a cada caso.',
  },
  {
    n: '02',
    photo: 'laptop',
    title: 'A pergunta no Claude',
    text: 'Você pergunta do jeito que já faz. O plugin leva a pergunta até a base jurídica.',
  },
  {
    n: '03',
    photo: 'livros',
    title: 'A fonte ao lado',
    text: 'A resposta chega com a norma, a súmula ou o julgado de onde saiu, pronta para conferir.',
  },
  {
    n: '04',
    photo: 'assinatura',
    title: 'Sua revisão, sua assinatura',
    text: 'O rascunho é ponto de partida. A decisão e a assinatura continuam com você.',
  },
];
---

<section id="dia-a-dia" class="section story" aria-labelledby="story-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2 id="story-title" class="display-lg" data-split>Do monte de papel à peça revisada.</h2>
      <p class="lead">Quatro momentos de uma pesquisa, antes e depois do plugin.</p>
    </div>

    <div class="story-grid" data-story>
      <ol class="story-steps">
        {
          steps.map((s, i) => (
            <li class:list={['story-step', { 'is-active': i === 0 }]} data-step={i}>
              <span class="story-dot" aria-hidden="true" />
              <div class="story-text">
                <span class="story-n">{s.n}</span>
                <h3 class="display-md">{s.title}</h3>
                <p class="mute">{s.text}</p>
              </div>
              <figure class="story-inline">
                <Photo name={s.photo} sizes="(min-width: 900px) 45vw, 100vw" />
              </figure>
            </li>
          ))
        }
      </ol>

      <div class="story-frame" aria-hidden="true">
        {
          steps.map((s, i) => (
            <div class:list={['story-shot', { 'is-active': i === 0 }]} data-shot={i}>
              <Photo name={s.photo} sizes="(min-width: 900px) 45vw, 100vw" decorative />
            </div>
          ))
        }
        <span class="story-badge">
          <span data-story-n>01</span> de 04
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    background: var(--surface);
  }
  .story-grid {
    position: relative;
  }
  .story-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 36px;
    display: grid;
    gap: var(--space-7);
  }
  /* Linha da órbita que liga os momentos: trilho e preenchimento. */
  .story-steps::before,
  .story-steps::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }
  .story-steps::after {
    background: var(--brand);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }
  .story-step {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }
  .story-dot {
    position: absolute;
    left: -36px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-round);
    border: 2px solid var(--brand);
    background: var(--brand);
    transition:
      background-color 300ms var(--ease-out),
      scale 300ms var(--ease-out);
  }
  .story-text {
    display: grid;
    gap: var(--space-2);
    max-width: 440px;
  }
  .story-n {
    font: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--brand);
  }
  .story-inline {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--soft);
  }
  .story-inline :global(.photo),
  .story-shot :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .story-frame {
    display: none;
  }

  /* Desktop com movimento: moldura fixa à direita. */
  @media (min-width: 900px) {
    :global(.anim) .story-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-8);
      align-items: start;
    }
    :global(.anim) .story-steps {
      gap: 0;
    }
    :global(.anim) .story-step {
      min-height: 48vh;
      align-content: center;
      padding-block: var(--space-6);
    }
    :global(.anim) .story-step:first-of-type {
      min-height: 40vh;
      align-content: start;
      padding-top: var(--space-4);
    }
    :global(.anim) .story-step:last-of-type {
      min-height: 52vh;
    }
    :global(.anim) .story-inline {
      display: none;
    }
    :global(.anim) .story-text {
      opacity: 0.55;
      transition: opacity 400ms var(--ease-out);
    }
    :global(.anim) .story-step.is-active .story-text {
      opacity: 1;
    }
    :global(.anim) .story-dot {
      top: calc(50% - 8px);
      background: var(--surface);
    }
    :global(.anim) .story-step:first-of-type .story-dot {
      top: calc(var(--space-4) + 6px);
    }
    :global(.anim) .story-step.is-active .story-dot {
      background: var(--brand);
      scale: 1.25;
    }
    :global(.anim) .story-steps::after {
      transform: scaleY(var(--p, 0));
    }
    :global(.anim) .story-frame {
      display: block;
      position: sticky;
      top: calc(50vh - min(32vw, 300px));
      aspect-ratio: 4 / 4.4;
      max-height: min(64vw, 600px);
      width: 100%;
      overflow: hidden;
      border-radius: var(--radius-xl);
      background: var(--soft);
    }
    .story-shot {
      position: absolute;
      inset: 0;
      opacity: 0;
      scale: 1.06;
      filter: blur(6px);
      transition:
        opacity 700ms var(--ease-out),
        scale 1200ms var(--ease-out),
        filter 700ms var(--ease-out);
    }
    .story-shot.is-active {
      opacity: 1;
      scale: 1;
      filter: blur(0);
    }
    .story-badge {
      position: absolute;
      left: var(--space-4);
      bottom: var(--space-4);
      padding: 6px 12px;
      border-radius: var(--radius-pill);
      background: var(--bg);
      color: var(--ink);
      font: var(--text-label);
      font-size: 12px;
      letter-spacing: 0.06em;
    }
  }
</style>
