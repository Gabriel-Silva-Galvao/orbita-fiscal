---
/**
 * Conta e segurança (itens 5, 8 e 9): perfil (nome e troca de e-mail com código), senha (com código; as outras
 * sessões caem), aparelhos conectados, preferências de e-mail, dados da nota fiscal, sair e excluir a conta.
 * Abre em qualquer estado da assinatura. Sem a API (demonstração), só nome, sair e excluir funcionam.
 */
import Portal from '../../layouts/Portal.astro';
import Pending from '../../components/Pending.astro';
import FormaPagamento from '../../components/FormaPagamento.astro';

export const prerender = false;
---

<Portal titulo="Conta e segurança" descricao="Seus dados de acesso, sair da conta e excluir a conta." pagina="configuracoes" aceita={['ativo', 'pendente', 'encerrado', 'sem', 'erro']}>
  <div data-conta>
    <section class="pt-secao" aria-labelledby="perfil-t">
      <h2 id="perfil-t">Perfil</h2>
      <form class="form-nome" data-nome-form novalidate>
        <div class="field">
          <label for="nome">Nome</label>
          <input id="nome" name="nome" autocomplete="name" maxlength="80" />
        </div>
        <button type="submit" class="btn-alt">Salvar nome</button>
        <p class="small mute" data-nome-msg role="status"></p>
      </form>
      <div class="kv">
        <div><span>E-mail</span><strong data-email></strong></div>
        <div><span>Acesso</span><strong>E-mail e senha, com código por e-mail</strong></div>
      </div>
      <form class="form-linha" data-email-form novalidate data-so-api>
        <div class="field">
          <label for="email-novo">Trocar o e-mail</label>
          <input id="email-novo" type="email" autocomplete="email" placeholder="novo@exemplo.com" />
        </div>
        <div class="field">
          <label for="email-senha">Sua senha atual</label>
          <input id="email-senha" type="password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn-alt">Enviar código ao novo e-mail</button>
      </form>
      <div class="codigo" data-codigo="email" hidden>
        <label for="cod-email">Código enviado para <strong data-codigo-para></strong></label>
        <div class="codigo-linha">
          <input id="cod-email" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
          <button type="button" class="btn-main" data-confirmar>Confirmar</button>
        </div>
      </div>
      <p class="small" data-email-msg role="status"></p>
    </section>

    <section class="pt-secao" aria-labelledby="senha-t" data-so-api>
      <h2 id="senha-t">Senha</h2>
      <form class="form-senha" data-senha-form novalidate>
        <div class="field">
          <label for="senha-atual">Senha atual</label>
          <input id="senha-atual" type="password" autocomplete="current-password" />
        </div>
        <div class="field">
          <label for="senha-nova">Senha nova</label>
          <input id="senha-nova" type="password" autocomplete="new-password" aria-describedby="senha-dica" />
          <p class="small mute" id="senha-dica">Pelo menos 8 caracteres, diferente da atual.</p>
        </div>
        <button type="submit" class="btn-alt">Trocar a senha</button>
      </form>
      <div class="codigo" data-codigo="senha" hidden>
        <label for="cod-senha">Para confirmar, digite o código enviado para <strong data-codigo-para></strong></label>
        <div class="codigo-linha">
          <input id="cod-senha" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
          <button type="button" class="btn-main" data-confirmar>Confirmar</button>
        </div>
      </div>
      <p class="small" data-senha-msg role="status"></p>
      <p class="small mute">Ao trocar a senha, os outros aparelhos saem da conta; este continua conectado.</p>
    </section>

    <section class="pt-secao" aria-labelledby="aparelhos-t" data-so-api>
      <h2 id="aparelhos-t">Aparelhos conectados</h2>
      <!-- Item 47: o aparelho que você está usando vem num cartão próprio, separado dos outros. -->
      <div class="ap-atual" data-ap-atual aria-live="polite"></div>
      <h3 class="ap-sub" data-ap-outros-t hidden>Outros aparelhos</h3>
      <ul class="aparelhos" data-aparelhos aria-live="polite"></ul>
      <p class="small mute" data-ap-vazio hidden>Nenhum outro aparelho está conectado à sua conta.</p>
      <div class="acoes">
        <button type="button" class="btn-alt" data-sair-outros hidden>Sair dos outros aparelhos</button>
        <button type="button" class="btn-alt" data-sair-todos>Sair de todos os aparelhos</button>
        <button type="button" class="btn-alt" data-sair>Sair deste aparelho</button>
      </div>
      <p class="small" data-ap-msg role="status"></p>
    </section>

    <section class="pt-secao" aria-labelledby="pref-t" data-so-api>
      <h2 id="pref-t">E-mails da Órbita</h2>
      <form class="prefs" data-prefs>
        <label><input type="checkbox" name="novidades" /> Novidades da base (o que entrou de novo)</label>
        <label data-pref-resumo><input type="checkbox" name="resumo_semanal" /> Resumo semanal por área <span class="selo-ouro">Ouro</span></label>
        <label class="mute"><input type="checkbox" checked disabled /> Avisos de cobrança e de segurança (sempre enviados)</label>
      </form>
      <p class="small" data-prefs-msg role="status"></p>
    </section>

    <!-- Item 48: pagamento reforçado, com a troca da forma de pagamento. -->
    <FormaPagamento titulo="Pagamento" id="pagamento" />
    <ul class="seg-pag small mute" aria-label="Como protegemos o seu pagamento">
      <li>O pagamento é processado pelo Asaas, instituição de pagamento autorizada pelo Banco Central.</li>
      <li>Não guardamos o número do cartão: só os 4 últimos dígitos, para você reconhecer qual é.</li>
      <li>Faturas, cancelamento e reembolso ficam em <a href="/conta/plano">Plano e pagamento</a>.</li>
    </ul>

    <section class="pt-secao" aria-labelledby="nota-t" data-so-api>
      <h2 id="nota-t">Dados da nota fiscal</h2>
      <p class="small mute" data-nota-vazia hidden>Os dados da nota são informados na primeira compra.</p>
      <form class="form-nota" data-nota-form novalidate hidden>
        <div class="field">
          <label for="nota-nome">Nome ou razão social</label>
          <input id="nota-nome" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="nota-doc">CPF ou CNPJ</label>
          <input id="nota-doc" inputmode="numeric" />
        </div>
        <div class="field nota-end">
          <label for="nota-end">Endereço (opcional)</label>
          <input id="nota-end" autocomplete="street-address" />
        </div>
        <button type="submit" class="btn-alt">Salvar dados da nota</button>
      </form>
      <p class="small" data-nota-msg role="status"></p>
    </section>

    <section class="pt-secao" aria-labelledby="sessao-t" data-so-demo hidden>
      <h2 id="sessao-t">Sessão</h2>
      <div class="acoes">
        <button type="button" class="btn-alt" data-sair>Sair</button>
      </div>
    </section>

    <section class="cartao perigo" aria-labelledby="excluir-t">
      <h2 class="h2" id="excluir-t">Excluir conta</h2>
      <p class="small">Apaga sua conta e seus dados, menos o que a lei manda guardar (como dados fiscais). Não dá para desfazer. Se houver assinatura ativa, cancele antes em <a href="/conta/plano#cancelar">Plano e pagamento</a>, para não haver nova cobrança.</p>
      <div class="field">
        <label for="confirmar">Para confirmar, digite EXCLUIR</label>
        <input id="confirmar" autocomplete="off" />
      </div>
      <button type="button" class="btn-alt" data-excluir disabled>Excluir minha conta</button>
      <p class="small" data-excluir-msg role="alert"></p>
    </section>
  </div>

  <section class="cartao" data-excluida hidden>
    <h2 class="h2">Sua conta foi excluída</h2>
    <p class="small">Seus dados de acesso foram apagados.</p>
    <a class="btn-main" href="/">Ir para o site</a>
  </section>
</Portal>

<style>
  [data-conta] {
    display: grid;
    gap: var(--space-6);
  }
  .h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
  }
  .cartao p {
    margin: 0;
  }
  .form-nome {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .form-nome .field,
  .perigo .field {
    width: min(100%, 420px);
  }
  .form-nome .btn-alt {
    width: auto;
  }
  .form-nome p {
    margin: 0;
  }
  .perigo {
    border-color: var(--line-strong);
  }
  /* Item 9 */
  .form-linha,
  .form-senha,
  .form-nota {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .form-linha .field,
  .form-senha .field,
  .form-nota .field {
    width: min(100%, 420px);
  }
  .form-nota {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: end;
  }
  .form-nota .nota-end {
    grid-column: 1 / -1;
    width: 100%;
  }
  .codigo {
    display: grid;
    gap: 6px;
    padding: var(--space-4);
    border: 1px solid var(--brand);
    border-radius: var(--radius-lg);
    animation: cf-entra 260ms ease-out;
  }
  .codigo-linha {
    display: flex;
    gap: var(--space-2);
  }
  .codigo-linha input {
    width: 9ch;
    letter-spacing: 0.3em;
    font-variant-numeric: tabular-nums;
  }
  @keyframes cf-entra {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .seg-pag {
    margin: calc(-1 * var(--space-2)) 0 var(--space-5);
    padding-left: 1.25rem;
    display: grid;
    gap: 4px;
  }
  /* Sem assinatura em dia, o bloco de pagamento some e a lista vai junto. */
  :global([data-fp][hidden]) + .seg-pag {
    display: none;
  }
  .seg-pag a {
    color: var(--brand);
  }
  .aparelhos {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .aparelhos :global(li),
  .ap-atual:not(:empty) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  /* O aparelho em uso: borda da marca e fundo levemente tingido. */
  .ap-atual:not(:empty) {
    margin-bottom: var(--space-4);
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 8%, transparent);
  }
  .aparelhos :global(li.is-mesmo) {
    border-style: dashed;
  }
  .ap-atual :global(.ap-icone),
  .aparelhos :global(.ap-icone) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--soft);
    color: var(--brand);
  }
  .ap-atual :global(svg),
  .aparelhos :global(svg) {
    width: 22px;
    height: 22px;
  }
  .ap-atual :global(.ap-info),
  .aparelhos :global(.ap-info) {
    min-width: 0;
  }
  .ap-atual :global(.ap-nome),
  .aparelhos :global(.ap-nome) {
    font-weight: 600;
  }
  .ap-atual :global(.ap-quando),
  .aparelhos :global(.ap-quando) {
    margin: 2px 0 0;
  }
  .ap-atual :global(.ap-este),
  .aparelhos :global(.ap-tag) {
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .ap-atual :global(.ap-este) {
    background: var(--brand);
    color: var(--on-brand);
    font-weight: 600;
  }
  .aparelhos :global(.ap-tag) {
    margin-left: 8px;
    border: 1px solid var(--line-strong);
    color: var(--mute);
  }
  .ap-sub {
    margin: 0 0 var(--space-2);
    font: 600 0.875rem/1.4 var(--font-body);
    color: var(--mute);
  }
  @media (max-width: 560px) {
    .aparelhos :global(li),
    .ap-atual:not(:empty) {
      grid-template-columns: auto 1fr;
    }
    .aparelhos :global(li > button),
    .ap-atual :global(.ap-este) {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  .prefs {
    display: grid;
    gap: var(--space-2);
  }
  .prefs label {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .prefs input {
    width: 18px;
    height: 18px;
    accent-color: var(--brand);
  }
  .selo-ouro {
    padding: 0 6px;
    border-radius: 6px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .codigo {
      animation: none;
    }
  }
</style>

<script>
  import { aoCarregar, billing, authEndpoint, call, usuario, sair, $ } from '../../scripts/portal';
  import { getSub, saveSub } from '../../scripts/demo';

  aoCarregar((ctx) => {
    $('[data-email]').textContent = usuario.email || ctx.sub?.email || '—';
    const campo = $<HTMLInputElement>('#nome');
    if (!campo.value) campo.value = usuario.nome || ctx.sub?.nome || '';
  });

  $<HTMLFormElement>('[data-nome-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nome = $<HTMLInputElement>('#nome').value.trim();
    const msg = $('[data-nome-msg]');
    if (nome.length < 2) return void (msg.textContent = 'Escreva o nome com pelo menos 2 letras.');
    if (billing) {
      try {
        const r = await call(authEndpoint, '/conta', 'PUT', { nome });
        if (!r.ok) {
          const d = await r.json().catch(() => ({}));
          return void (msg.textContent = d.detail?.mensagem ?? d.descricao ?? 'Não conseguimos salvar agora. Tente de novo em instantes.');
        }
      } catch {
        return void (msg.textContent = 'Não conseguimos falar com o servidor. Tente de novo em instantes.');
      }
      try {
        sessionStorage.removeItem('orbita:sessao'); // o avatar do site busca o nome novo
      } catch {}
    } else {
      const sub = getSub();
      if (sub) saveSub({ ...sub, nome });
    }
    usuario.nome = nome;
    msg.textContent = 'Nome salvo.';
  });

  document.querySelectorAll<HTMLElement>('[data-sair]').forEach((b) => b.addEventListener('click', () => sair()));

  /* ---------- Item 9 ---------- */
  const erroDe = async (r: Response, padrao: string) => {
    const d = await r.json().catch(() => ({}));
    return d.detail?.mensagem ?? d.descricao ?? padrao;
  };
  const SEM_SERVIDOR = 'Não conseguimos falar com o servidor. Tente de novo em instantes.';

  // Sem a API (demonstração), as seções que dependem dela ficam escondidas.
  document.querySelectorAll<HTMLElement>('[data-so-api]').forEach((el) => (el.hidden = !billing));
  document.querySelectorAll<HTMLElement>('[data-so-demo]').forEach((el) => (el.hidden = !!billing));

  // Código de confirmação (senha ou e-mail): mostra a caixa e confirma em POST /auth/confirmar.
  function pedirCodigo(qual: 'senha' | 'email', para: string, msg: HTMLElement, aoConfirmar: (d: any) => void, dev?: string) {
    const caixa = $(`[data-codigo="${qual}"]`);
    caixa.hidden = false;
    caixa.querySelector('[data-codigo-para]')!.textContent = para;
    const campo = caixa.querySelector<HTMLInputElement>('input')!;
    campo.value = '';
    campo.focus();
    msg.textContent = dev ? `Demonstração: o código é ${dev}.` : '';
    const botao = caixa.querySelector<HTMLButtonElement>('[data-confirmar]')!;
    botao.onclick = async () => {
      botao.disabled = true;
      try {
        const r = await call(authEndpoint, '/confirmar', 'POST', { codigo: campo.value.trim() });
        if (!r.ok) {
          msg.textContent = await erroDe(r, 'Código incorreto.');
          return;
        }
        caixa.hidden = true;
        aoConfirmar(await r.json());
      } catch {
        msg.textContent = SEM_SERVIDOR;
      } finally {
        botao.disabled = false;
      }
    };
  }

  $<HTMLFormElement>('[data-email-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-email-msg]');
    const email = $<HTMLInputElement>('#email-novo').value.trim();
    const senha = $<HTMLInputElement>('#email-senha').value;
    if (!senha) return void (msg.textContent = 'Digite sua senha atual para trocar o e-mail.');
    try {
      const r = await call(authEndpoint, '/email/trocar', 'POST', { email, senha });
      if (!r.ok) return void (msg.textContent = await erroDe(r, 'Não conseguimos trocar o e-mail agora.'));
      const d = await r.json();
      pedirCodigo('email', d.enviado_para, msg, (res) => {
        usuario.email = res.email;
        $('[data-email]').textContent = res.email;
        $<HTMLInputElement>('#email-novo').value = '';
        $<HTMLInputElement>('#email-senha').value = '';
        msg.textContent = 'E-mail trocado. A partir de agora, entre com o e-mail novo. Os outros aparelhos saíram da conta.';
        carregarAparelhos();
        try {
          sessionStorage.removeItem('orbita:sessao');
        } catch {}
      }, d.codigo_dev);
    } catch {
      msg.textContent = SEM_SERVIDOR;
    }
  });

  $<HTMLFormElement>('[data-senha-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-senha-msg]');
    const atual = $<HTMLInputElement>('#senha-atual').value;
    const nova = $<HTMLInputElement>('#senha-nova').value;
    if (nova.length < 8) return void (msg.textContent = 'A senha nova precisa ter pelo menos 8 caracteres.');
    try {
      const r = await call(authEndpoint, '/senha/trocar', 'POST', { atual, nova });
      if (!r.ok) return void (msg.textContent = await erroDe(r, 'Não conseguimos trocar a senha agora.'));
      const d = await r.json();
      pedirCodigo('senha', d.enviado_para, msg, () => {
        $<HTMLFormElement>('[data-senha-form]').reset();
        msg.textContent = 'Senha trocada. Os outros aparelhos saíram da conta.';
        carregarAparelhos();
      }, d.codigo_dev);
    } catch {
      msg.textContent = SEM_SERVIDOR;
    }
  });

  // Aparelhos conectados
  const dataHora = (seg: number) =>
    new Date(seg * 1000).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  type Sessao = {
    id: string;
    aparelho: string;
    tipo?: 'computador' | 'celular' | 'tablet';
    criada: number;
    ultimo_uso: number;
    atual: boolean;
    mesmo_aparelho?: boolean;
  };
  const ICONES: Record<string, string> = {
    computador: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
    celular: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
    tablet: '<rect x="4.5" y="2.5" width="15" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  };
  const icone = (tipo = 'computador') => {
    const span = document.createElement('span');
    span.className = 'ap-icone';
    span.setAttribute('aria-hidden', 'true');
    span.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONES[tipo] ?? ICONES.computador}</svg>`;
    return span;
  };
  const haQuanto = (seg: number) => {
    const min = Math.max(0, Math.round((Date.now() / 1000 - seg) / 60));
    if (min < 2) return 'agora há pouco';
    if (min < 60) return `há ${min} minutos`;
    const h = Math.round(min / 60);
    if (h < 24) return h === 1 ? 'há 1 hora' : `há ${h} horas`;
    const d = Math.round(h / 24);
    return d === 1 ? 'ontem' : d < 30 ? `há ${d} dias` : `em ${dataHora(seg).slice(0, 10)}`;
  };
  function linhaSessao(s: Sessao) {
    const info = document.createElement('div');
    info.className = 'ap-info';
    const nome = document.createElement('span');
    nome.className = 'ap-nome';
    nome.textContent = s.aparelho || 'Navegador';
    info.append(nome);
    if (s.mesmo_aparelho) {
      const tag = document.createElement('span');
      tag.className = 'ap-tag';
      tag.textContent = 'Mesmo navegador que este';
      tag.title = 'Provavelmente um login antigo neste mesmo aparelho.';
      info.append(tag);
    }
    const quando = document.createElement('p');
    quando.className = 'small mute ap-quando';
    quando.textContent = s.atual
      ? `Conectado agora · entrou em ${dataHora(s.criada)}`
      : `Último uso ${haQuanto(s.ultimo_uso || s.criada)} · entrou em ${dataHora(s.criada)}`;
    info.append(quando);
    return info;
  }
  async function carregarAparelhos() {
    if (!billing) return;
    const lista = $('[data-aparelhos]');
    try {
      const r = await call(authEndpoint, '/sessoes');
      if (!r.ok) return;
      const sessoes = (await r.json()) as Sessao[];
      const atual = sessoes.find((s) => s.atual);
      const outros = sessoes.filter((s) => !s.atual);

      const caixa = $('[data-ap-atual]');
      caixa.replaceChildren();
      if (atual) {
        const selo = document.createElement('span');
        selo.className = 'ap-este';
        selo.textContent = 'Você está usando este';
        caixa.append(icone(atual.tipo), linhaSessao(atual), selo);
      }

      const renderOutros = () => {
        const restantes = lista.children.length;
        $('[data-ap-outros-t]').hidden = restantes === 0;
        lista.hidden = restantes === 0;
        $('[data-ap-vazio]').hidden = restantes > 0;
        $('[data-sair-outros]').hidden = restantes === 0;
      };
      lista.replaceChildren(
        ...outros.map((s) => {
          const li = document.createElement('li');
          if (s.mesmo_aparelho) li.classList.add('is-mesmo');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'btn-alt';
          b.textContent = 'Sair deste aparelho';
          b.setAttribute('aria-label', `Sair do aparelho ${s.aparelho || 'Navegador'}`);
          b.addEventListener('click', async () => {
            b.disabled = true;
            const r2 = await call(authEndpoint, `/sessoes/${s.id}`, 'DELETE').catch(() => null);
            if (r2?.ok || r2?.status === 404) {
              li.remove();
              renderOutros();
            } else b.disabled = false;
          });
          li.append(icone(s.tipo), linhaSessao(s), b);
          return li;
        }),
      );
      renderOutros();
    } catch {
      /* lista fica vazia; os botões continuam funcionando */
    }
  }
  $('[data-sair-outros]').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const msg = $('[data-ap-msg]');
    b.disabled = true;
    const r = await call(authEndpoint, '/sair-dos-outros', 'POST').catch(() => null);
    b.disabled = false;
    if (r?.ok) {
      msg.textContent = 'Pronto: os outros aparelhos saíram da conta. Este continua conectado.';
      carregarAparelhos();
    } else msg.textContent = 'Não deu para sair dos outros aparelhos agora. Tente de novo.';
  });
  $('[data-sair-todos]').addEventListener('click', async () => {
    await call(authEndpoint, '/sair-de-todos', 'POST').catch(() => null);
    try {
      sessionStorage.removeItem('orbita:sessao');
    } catch {}
    location.href = '/entrar';
  });

  // Preferências de e-mail (salvam ao marcar)
  const prefs = $<HTMLFormElement>('[data-prefs]');
  async function carregarPrefs() {
    if (!billing) return;
    const r = await call(authEndpoint, '/preferencias').catch(() => null);
    if (!r?.ok) return;
    const p = await r.json();
    (prefs.elements.namedItem('novidades') as HTMLInputElement).checked = p.novidades;
    (prefs.elements.namedItem('resumo_semanal') as HTMLInputElement).checked = p.resumo_semanal;
  }
  prefs.addEventListener('change', async () => {
    const msg = $('[data-prefs-msg]');
    const corpo = {
      novidades: (prefs.elements.namedItem('novidades') as HTMLInputElement).checked,
      resumo_semanal: (prefs.elements.namedItem('resumo_semanal') as HTMLInputElement).checked,
    };
    const r = await call(authEndpoint, '/preferencias', 'PUT', corpo).catch(() => null);
    msg.textContent = r?.ok ? 'Preferências salvas.' : SEM_SERVIDOR;
  });

  // Dados da nota fiscal
  async function carregarNota() {
    if (!billing) return;
    const r = await call(billing, '/nota').catch(() => null);
    const n = r?.ok ? await r.json() : null;
    $('[data-nota-vazia]').hidden = !!n;
    $('[data-nota-form]').hidden = !n;
    if (n) {
      $<HTMLInputElement>('#nota-nome').value = n.nome ?? '';
      $<HTMLInputElement>('#nota-doc').value = n.cpf_cnpj ?? '';
      $<HTMLInputElement>('#nota-end').value = n.endereco ?? '';
    }
  }
  $<HTMLFormElement>('[data-nota-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-nota-msg]');
    const corpo = {
      nome: $<HTMLInputElement>('#nota-nome').value,
      cpf_cnpj: $<HTMLInputElement>('#nota-doc').value,
      endereco: $<HTMLInputElement>('#nota-end').value,
    };
    try {
      const r = await call(billing, '/nota', 'PUT', corpo);
      msg.textContent = r.ok ? 'Dados da nota salvos. Valem para as próximas notas.' : await erroDe(r, 'Não conseguimos salvar agora.');
    } catch {
      msg.textContent = SEM_SERVIDOR;
    }
  });

  aoCarregar((ctx) => {
    // Resumo semanal é do Ouro: nos outros planos, a opção aparece desativada.
    const resumo = $<HTMLElement>('[data-pref-resumo]');
    const input = resumo.querySelector<HTMLInputElement>('input')!;
    input.disabled = !ctx.ouro;
    resumo.classList.toggle('mute', !ctx.ouro);
  });
  carregarAparelhos();
  carregarPrefs();
  carregarNota();

  const confirmar = $<HTMLInputElement>('#confirmar');
  const excluir = $<HTMLButtonElement>('[data-excluir]');
  confirmar.addEventListener('input', () => (excluir.disabled = confirmar.value.trim().toUpperCase() !== 'EXCLUIR'));
  excluir.addEventListener('click', async () => {
    const msg = $('[data-excluir-msg]');
    msg.textContent = '';
    if (billing) {
      try {
        const r = await call(authEndpoint, '/conta', 'DELETE');
        if (!r.ok) {
          const d = await r.json().catch(() => ({}));
          return void (msg.textContent = d.detail?.mensagem ?? d.descricao ?? 'Não conseguimos excluir agora. Tente de novo em instantes.');
        }
      } catch {
        return void (msg.textContent = 'Não conseguimos falar com o servidor. Tente de novo em instantes.');
      }
    }
    saveSub(null);
    try {
      sessionStorage.removeItem('of-demo-email');
      sessionStorage.removeItem('orbita:sessao');
      localStorage.removeItem('of-demo-instalacao');
    } catch {}
    $('[data-conta]').hidden = true;
    const fim = $('[data-excluida]');
    fim.hidden = false;
    fim.querySelector<HTMLElement>('a')?.focus();
  });
</script>
