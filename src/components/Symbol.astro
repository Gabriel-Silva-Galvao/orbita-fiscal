---
/**
 * Símbolo atômico (Li-7): dois anéis a −28°, três elétrons, núcleo de sete esferas.
 * `on` diz o fundo, para o miolo dos elétrons e o contorno do núcleo usarem a mesma cor.
 * `orbit` liga a órbita dos elétrons (motor em scripts/orbit.ts):
 *   sozinha, os elétrons giram devagar e o núcleo respira;
 *   com o mouse em cima (do símbolo ou do link que o contém), aceleram e os anéis se inclinam.
 */
interface Props {
  on?: 'bg' | 'soft' | 'surface';
  orbit?: boolean;
  label?: string;
  class?: string;
  /** Multiplica a velocidade de repouso. */
  pace?: number;
}
const { on = 'bg', orbit = true, label, class: cls, pace = 1 } = Astro.props;
const gap = `var(--${on})`;

const electrons = [
  { ring: 'in', phase: Math.PI, x: 23 },
  { ring: 'in', phase: 0, x: 77 },
  { ring: 'out', phase: 0, x: 93 },
];
---

<svg
  class:list={['symbol', cls]}
  viewBox="6 14 88 72"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-orbit={orbit ? '' : undefined}
  data-pace={pace}
  style={`--gap:${gap}`}
>
  <g class="sym-rings" transform="rotate(-28 50 50)">
    <ellipse cx="50" cy="50" rx="43" ry="28" fill="none" stroke="var(--brand)" stroke-width="2.6"></ellipse>
    <ellipse cx="50" cy="50" rx="27" ry="17" fill="none" stroke="var(--brand)" stroke-width="2.6"></ellipse>
    {
      electrons.map((e) => (
        <g class="sym-e" data-ring={e.ring} data-phase={e.phase.toFixed(4)} transform={`translate(${e.x} 50)`}>
          <circle r="3.4" fill="var(--gap)" stroke="var(--ink)" stroke-width="2" />
        </g>
      ))
    }
  </g>
  <g class="sym-nucleus">
    <circle cx="57.2" cy="50" r="4.4" fill="var(--brand)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="46.4" cy="56.236" r="4.4" fill="var(--brand)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="46.4" cy="43.764" r="4.4" fill="var(--brand)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="53.6" cy="56.236" r="4.4" fill="var(--nucleus)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="42.8" cy="50" r="4.4" fill="var(--nucleus)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="53.6" cy="43.764" r="4.4" fill="var(--nucleus)" stroke="var(--gap)" stroke-width=".7"></circle>
    <circle cx="50" cy="50" r="4.4" fill="var(--nucleus)" stroke="var(--gap)" stroke-width=".7"></circle>
  </g>
</svg>

<style>
  .symbol {
    overflow: visible;
  }
  /* O núcleo respira sozinho; com o mouse em cima, pulsa mais forte. */
  .sym-nucleus {
    transform-box: view-box;
    transform-origin: 50px 50px;
  }
  :global(.anim) .symbol[data-orbit] .sym-nucleus {
    animation: sym-breathe 4.8s ease-in-out infinite;
  }
  :global(.anim) .symbol.is-hot .sym-nucleus {
    animation: sym-pulse 0.9s ease-in-out infinite;
  }
  @keyframes sym-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }
  @keyframes sym-pulse {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.12) rotate(18deg);
    }
  }
</style>
