# Copie para .env e preencha quando cada integração existir.
# Sem estas variáveis, as páginas rodam em modo de demonstração.

# Autenticação (Entrar): POST JSON {modo, nome, email, plano}; 409 = e-mail já tem conta.
# O botão do Google vai para PUBLIC_AUTH_ENDPOINT/google?next=<rota>.
PUBLIC_AUTH_ENDPOINT=

# Pagamento (Checkout): nome do provedor escolhido. Com ele definido, o Checkout sai da demonstração
# e precisa ser ligado aos campos seguros e à API do provedor (ver src/pages/assinar/[plano].astro).
PUBLIC_PAYMENT_PROVIDER=

# Formulário de contato: POST JSON {nome, email, assunto, mensagem, consentimento}.
# Sem ele, o envio abre o e-mail da pessoa com a mensagem pronta.
PUBLIC_CONTACT_ENDPOINT=
