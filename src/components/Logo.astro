---
import Symbol from './Symbol.astro';

interface Props {
  href?: string;
  size?: 'md' | 'lg';
}
const { href = '/', size = 'md' } = Astro.props;
---

<a class:list={['logo', `logo-${size}`]} href={href} aria-label="Órbita, página inicial">
  <span class="logo-mark-wrap">
    <Symbol class="logo-mark" pace={1.2} />
  </span>
  <span class="logo-word" aria-hidden="true">
    <span class="logo-name">Órbita</span>
  </span>
</a>

<style>
  .logo {
    --mark: 64px;
    --name: 32px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    border-radius: var(--radius-sm);
  }
  .logo-lg {
    --mark: 84px;
    --name: 42px;
    gap: 16px;
  }
  .logo-mark-wrap {
    display: grid;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border-radius: var(--radius-round);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .logo :global(.logo-mark) {
    width: 88%;
    height: auto;
  }
  .logo-word {
    display: grid;
    gap: 4px;
  }
  .logo-name {
    font-family: var(--font-display);
    font-size: var(--name);
    line-height: 1;
  }
  /* Mouse em cima: o símbolo respira, sem disco nem cor nova. */
  @media (hover: hover) and (pointer: fine) {
    .logo:hover .logo-mark-wrap {
      transform: scale(1.08) rotate(-6deg);
    }
  }
  @media (max-width: 480px) {
    .logo {
      --mark: 50px;
      --name: 23px;
    }
  }
  /* Tela bem pequena: só o símbolo. O nome continua no aria-label do link. */
  @media (max-width: 400px) {
    .logo-word {
      display: none;
    }
    .logo {
      --mark: 48px;
    }
  }
</style>
