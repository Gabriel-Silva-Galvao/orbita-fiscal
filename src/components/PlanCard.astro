---
import Button from './Button.astro';
import Pending from './Pending.astro';

export interface PlanItem {
  text: string;
  pending?: 'definir' | 'confirmar';
}
interface Props {
  name: string;
  price: string;
  /** Valor numérico para a contagem animada. */
  count?: number;
  items: PlanItem[];
  href: string;
  cta: string;
  featured?: boolean;
  badge?: string;
}
const { name, price, count, items, href, cta, featured = false, badge } = Astro.props;
---

<article class:list={['plan', { 'plan-featured': featured }]} aria-labelledby={`plan-${name}`}>
  <header class="plan-head">
    <h3 class="plan-name" id={`plan-${name}`}>{name}</h3>
    {badge && <span class="plan-badge">{badge}</span>}
  </header>
  <p class="plan-price">
    <span class="plan-value">{price}</span>
    <span class="plan-per">por mês</span>
  </p>
  <ul class="plan-items">
    {
      items.map((it) => (
        <li>
          <span>
            {it.text}
            {it.pending && <Pending kind={it.pending} />}
          </span>
        </li>
      ))
    }
  </ul>
  <Button href={href} variant={featured ? 'primary' : 'secondary'} block aria-label={`${cta}, ${price} por mês`}>
    {cta}
  </Button>
</article>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    transition: border-color 280ms ease-out;
    will-change: transform;
  }
  @media (min-width: 768px) {
    .plan {
      padding: var(--space-6) var(--space-6) var(--space-6);
    }
  }
  .plan-featured {
    background: var(--soft);
    border-color: var(--brand);
  }
  .plan:hover {
    border-color: var(--brand);
  }
  /* O Max chama atenção uma vez, quando os planos entram. */
  :global(.anim) :global(.is-in) .plan-featured .plan-badge {
    animation: badge 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 500ms both;
  }
  @keyframes badge {
    0% {
      transform: scale(0.4) rotate(-12deg);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  .plan-value {
    font-variant-numeric: tabular-nums;
  }
  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .plan-name {
    font: var(--text-display-md);
    font-size: 24px;
  }
  .plan-badge {
    background: var(--brand);
    color: var(--on-brand);
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .plan-value {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 48px;
    letter-spacing: -0.01em;
  }
  .plan-per {
    font: var(--text-small);
    color: var(--mute);
  }
  .plan-featured .plan-per {
    color: var(--ink);
  }
  .plan-items {
    display: grid;
    gap: var(--space-3);
    flex: 1;
    margin-bottom: var(--space-2);
  }
  .plan-items li {
    position: relative;
    padding-left: 22px;
    font: var(--text-small);
    font-size: 15px;
    line-height: 23px;
  }
  .plan-items li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 8px;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-round);
    background: var(--brand);
  }
  .plan-featured .plan-items li::before {
    background: var(--ink);
  }
  /* Sobre soft, o texto do rótulo vai em ink para manter 4,5:1 nos dois temas. */
  .plan-featured :global(.pending) {
    color: var(--ink);
  }
</style>
