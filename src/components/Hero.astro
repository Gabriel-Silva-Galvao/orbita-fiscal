---
import Symbol from './Symbol.astro';
import Button from './Button.astro';

const title = 'Pesquise o direito brasileiro e prepare suas peças na IA que você já usa.';
const words = title.split(' ');

// Citações que orbitam o símbolo: as mesmas do exemplo, para a pessoa reconhecer depois.
const chips = [
  { text: 'Súmula 314 · STJ', kind: 'Súmula', pos: 'c1', depth: 1.6 },
  { text: 'CTN, art. 174', kind: 'Norma', pos: 'c2', depth: 2.2 },
  { text: 'Lei 6.830/1980', kind: 'Norma', pos: 'c3', depth: 1.2 },
  { text: 'Tema 566 · STJ', kind: 'Precedente', pos: 'c4', depth: 2.6 },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- Fundo: órbitas largas que atravessam a página, com um ponto viajando. -->
  <svg class="hero-bg" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-depth="-0.4">
    <g transform="rotate(-28 980 380)" fill="none" stroke="var(--line)" stroke-width="1.2">
      <ellipse cx="980" cy="380" rx="760" ry="300"></ellipse>
      <ellipse cx="980" cy="380" rx="520" ry="200" stroke-dasharray="2 10"></ellipse>
      <ellipse id="hero-path" cx="980" cy="380" rx="980" ry="420"></ellipse>
    </g>
    <g transform="rotate(-28 980 380)">
      <circle r="5" fill="var(--brand)" class="hero-traveler">
        <animateMotion dur="26s" repeatCount="indefinite" path="M 1740 380 A 760 300 0 1 1 220 380 A 760 300 0 1 1 1740 380"></animateMotion>
      </circle>
      <circle r="3.5" fill="var(--brand)" opacity=".6" class="hero-traveler">
        <animateMotion dur="40s" repeatCount="indefinite" path="M 460 380 A 520 200 0 1 0 1500 380 A 520 200 0 1 0 460 380"></animateMotion>
      </circle>
    </g>
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="overline" data-hero-in>Plugin para Claude</p>
      <h1 id="hero-title" class="display-xl hero-title">
        <span class="sr-only">{title}</span>
        <span aria-hidden="true">{
          words.map((w, i) => (
            <>
              <span class="hw">
                <span>{w}</span>
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }</span>
      </h1>
      <p class="lead" data-hero-in="copy">
        O plugin da Órbita Fiscal conecta a base jurídica ao seu Claude. Você pergunta como sempre perguntou e
        recebe o fundamento para conferir.
      </p>
      <div class="hero-actions" data-hero-in="copy">
        <Button href="#planos">Ver planos</Button>
        <Button href="#exemplo" variant="secondary">Ver um exemplo</Button>
      </div>
      <p class="small mute" data-hero-in="copy">A partir de R$ 50 por mês.</p>
    </div>

    <div class="hero-art" aria-hidden="false">
      <div class="hero-ring hero-ring-1" data-hero-in data-depth="0.5"></div>
      <div class="hero-ring hero-ring-2" data-hero-in data-depth="0.8"></div>
      <div class="hero-disc" data-hero-in data-depth="0.9" data-orbit-host>
        <Symbol on="soft" pace={0.8} label="Símbolo da Órbita Fiscal: um átomo com elétrons em órbita" />
      </div>
      {
        chips.map((c, i) => (
          <span class:list={['chip-pos', c.pos]} data-depth={c.depth} data-hero-in aria-hidden="true">
            <span class="chip" style={`--r:${i % 2 ? 4 : -5}deg; --d:${5 + i * 1.3}s`}>
              <span class="chip-kind">{c.kind}</span>
              <span class="chip-text">{c.text}</span>
            </span>
          </span>
        ))
      }
    </div>
  </div>

  <a class="hero-cue" href="#a-base" data-hero-in>
    <span>Role para conhecer</span>
    <span class="hero-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-8) var(--space-9);
      min-height: min(860px, calc(100svh - 84px));
      display: grid;
      align-content: center;
    }
  }
  .hero-bg {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    pointer-events: none;
    opacity: 0.9;
  }
  :global(html:not(.anim)) .hero-traveler {
    display: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hero-title {
    max-width: 620px;
    text-wrap: balance;
  }
  /* Cada palavra sobe de dentro de uma máscara. */
  .hw {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hw > span {
    display: inline-block;
  }
  :global(.anim) .hw > span {
    visibility: hidden;
  }
  .hero-copy .lead {
    max-width: 540px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Arte: disco, dois anéis tracejados girando e citações em órbita. */
  .hero-art {
    position: relative;
    order: -1;
    justify-self: center;
    width: min(300px, 74vw);
    aspect-ratio: 1;
    margin-block: var(--space-4);
  }
  .hero-disc {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-round);
    background: var(--soft);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .hero-disc :global(.symbol) {
    width: 80%;
  }
  .hero-ring {
    position: absolute;
    pointer-events: none;
  }
  .hero-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-round);
    border: 1.5px dashed var(--line-strong);
  }
  .hero-ring-1 {
    inset: -9%;
    opacity: 0.7;
  }
  .hero-ring-2 {
    inset: -20%;
    opacity: 0.4;
  }
  .hero-ring-2::before {
    border-style: dotted;
    border-color: var(--brand);
  }
  :global(.anim) .hero-ring-1::before {
    animation: spin 60s linear infinite;
  }
  :global(.anim) .hero-ring-2::before {
    animation: spin 90s linear infinite reverse;
  }

  .chip-pos {
    position: absolute;
    z-index: 2;
  }
  .c1 {
    top: -2%;
    left: -10%;
  }
  .c2 {
    top: 18%;
    right: -12%;
  }
  .c3 {
    bottom: 6%;
    left: -10%;
  }
  .c4 {
    bottom: -6%;
    right: -2%;
  }
  .chip {
    display: grid;
    gap: 3px;
    padding: 9px 14px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    white-space: nowrap;
    transform: rotate(var(--r));
  }
  :global(.anim) .chip {
    animation: float-a var(--d) ease-in-out infinite;
  }
  :global(.anim) .chip-pos:nth-of-type(2n) .chip {
    animation-name: float-b;
  }
  .chip-kind {
    font: var(--text-label);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .chip-text {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 18px;
    color: var(--ink);
  }
  @media (max-width: 899px) {
    .c1 {
      left: -8%;
    }
    .c2 {
      right: -12%;
    }
    .c3 {
      left: -12%;
    }
    .c4,
    .hero-ring-2 {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .chip-text {
      font-size: 13px;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
    .hero-art {
      order: 0;
      justify-self: center;
      width: min(400px, 90%);
    }
  }

  /* Convite para rolar. */
  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
    text-decoration: none;
  }
  .hero-cue-line {
    width: 1.5px;
    height: 40px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform: translateY(-100%);
  }
  :global(.anim) .hero-cue-line::after {
    animation: cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (min-width: 900px) and (min-height: 760px) {
    .hero-cue {
      display: flex;
    }
  }
</style>
