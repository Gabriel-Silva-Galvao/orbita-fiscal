---
import Symbol from './Symbol.astro';
import Button from './Button.astro';
import { citacoes } from '../data/citacoes';

// Título de venda (etapa 10f-1, plano da landing): nomeia o resultado que o advogado quer.
const title = 'A lei e o julgado certos, com a fonte, na IA que você já usa.';

// Quatro citações fixas em volta do símbolo (as quatro primeiras de src/data/citacoes.ts).
// Desde a etapa 10c não se revezam no topo; o revezamento segue nos livros e em Brasília.
const slots = [
  { pos: 'c1', depth: 1.6 },
  { pos: 'c2', depth: 2.2 },
  { pos: 'c3', depth: 1.2 },
  { pos: 'c4', depth: 2.6 },
];
const chips = slots.map((s, i) => ({ ...s, ...citacoes[i], i }));
---

<!-- Etapa 10c: o topo fica parado (sem entrada animada, profundidade com o mouse, órbita girando nem cartões em revezamento). -->
<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- Fundo: órbitas largas que atravessam a página, com um ponto viajando. -->
  <svg class="hero-bg" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g transform="rotate(-28 980 380)" fill="none" stroke="var(--line)" stroke-width="1.2">
      <ellipse cx="980" cy="380" rx="760" ry="300"></ellipse>
      <ellipse cx="980" cy="380" rx="520" ry="200" stroke-dasharray="2 10"></ellipse>
      <ellipse id="hero-path" cx="980" cy="380" rx="980" ry="420"></ellipse>
    </g>
    <g transform="rotate(-28 980 380)">
      <circle r="5" fill="var(--brand)" class="hero-traveler">
        <animateMotion dur="26s" repeatCount="indefinite" path="M 1740 380 A 760 300 0 1 1 220 380 A 760 300 0 1 1 1740 380"></animateMotion>
      </circle>
      <circle r="3.5" fill="var(--brand)" opacity=".6" class="hero-traveler">
        <animateMotion dur="40s" repeatCount="indefinite" path="M 460 380 A 520 200 0 1 0 1500 380 A 520 200 0 1 0 460 380"></animateMotion>
      </circle>
    </g>
  </svg>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="overline">Plugin para Claude</p>
      <!-- SEO (etapa 8d): o título é o maior elemento da primeira tela (LCP). Aparece já pintado, sem entrada animada. -->
      <h1 id="hero-title" class="display-xl hero-title">
        {title}
      </h1>
      <p class="lead">
        Pergunte no Claude como sempre. A Órbita busca na base de legislação e jurisprudência brasileira e
        devolve a resposta com a norma, a súmula ou o julgado para você conferir.
      </p>
      <div class="hero-actions">
        <Button href="#planos">Assinar a partir de R$ 50/mês</Button>
        <Button href="#exemplo" variant="secondary">Ver com e sem a Órbita</Button>
      </div>
      <p class="small mute">Cartão, Pix ou boleto · cancele quando quiser · funciona no Claude</p>
    </div>

    <div class="hero-art" aria-hidden="false">
      <div class="hero-ring hero-ring-1"></div>
      <div class="hero-ring hero-ring-2"></div>
      <div class="hero-disc">
        <Symbol on="bg" orbit={false} label="Símbolo da Órbita: um átomo com elétrons em órbita" />
      </div>
      {
        chips.map((c, i) => (
          <span class:list={['chip-pos', c.pos]} aria-hidden="true">
            <span class="chip-swap" data-chip data-chip-i={c.i}>
              <span class="chip" style={`--r:${i % 2 ? 4 : -5}deg; --d:${5 + i * 1.3}s`}>
                <span class="chip-kind" data-chip-kind>{c.kind}</span>
                <span class="chip-text" data-chip-text>{c.text}</span>
              </span>
            </span>
          </span>
        ))
      }
    </div>
  </div>

  <a class="hero-cue" href="#a-base">
    <span>Role para conhecer</span>
    <span class="hero-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-8) var(--space-9);
      min-height: min(860px, calc(100svh - 84px));
      display: grid;
      align-content: center;
    }
  }
  .hero-bg {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    pointer-events: none;
    opacity: 0.9;
  }
  :global(html:not(.anim)) .hero-traveler {
    display: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .hero-title {
    max-width: 620px;
    text-wrap: balance;
  }
  .hero-copy .lead {
    max-width: 540px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Arte: disco, dois anéis tracejados girando e citações em órbita. */
  .hero-art {
    position: relative;
    order: -1;
    justify-self: center;
    width: min(300px, 74vw);
    aspect-ratio: 1;
    margin-block: var(--space-4);
  }
  .hero-disc {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-round);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .hero-disc :global(.symbol) {
    width: 80%;
  }
  .hero-ring {
    position: absolute;
    pointer-events: none;
  }
  .hero-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-round);
    border: 1.5px dashed var(--line-strong);
  }
  .hero-ring-1 {
    inset: -9%;
    opacity: 0.7;
  }
  .hero-ring-2 {
    inset: -20%;
    opacity: 0.4;
  }
  .hero-ring-2::before {
    border-style: dotted;
    border-color: var(--brand);
  }

  .chip-pos {
    position: absolute;
    z-index: 2;
  }
  .c1 {
    top: -2%;
    left: -10%;
  }
  .c2 {
    top: 18%;
    right: -12%;
  }
  .c3 {
    bottom: 6%;
    left: -10%;
  }
  .c4 {
    bottom: -6%;
    right: -2%;
  }
  .chip {
    display: grid;
    gap: 3px;
    padding: 9px 14px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    white-space: nowrap;
    transform: rotate(var(--r));
  }
  /* Camada só do motor de troca: o GSAP mexe aqui sem brigar com a flutuação do .chip. */
  .chip-swap {
    display: block;
    perspective: 600px;
  }
  .chip-kind {
    font: var(--text-label);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .chip-text {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 18px;
    color: var(--ink);
  }
  @media (max-width: 899px) {
    .c1 {
      left: -8%;
    }
    .c2 {
      right: -12%;
    }
    .c3 {
      left: -12%;
    }
    .c4,
    .hero-ring-2 {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .chip-text {
      font-size: 13px;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
    .hero-art {
      order: 0;
      justify-self: center;
      width: min(400px, 90%);
    }
  }

  /* Convite para rolar. */
  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
    text-decoration: none;
  }
  .hero-cue-line {
    width: 1.5px;
    height: 40px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    transform: translateY(-100%);
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }
  @media (min-width: 900px) and (min-height: 760px) {
    .hero-cue {
      display: flex;
    }
  }
</style>
