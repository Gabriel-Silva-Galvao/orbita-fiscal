---
/**
 * Cena 1, “A base”: foto real de lombadas em verde (duotone com a cor da marca).
 */
import Photo from './Photo.astro';
import { citacoes } from '../data/citacoes';

// Cartões que se revezam (virando como página; no hover, como placa): scripts/hero-chips.ts.
const inicio = (text: string) => citacoes.findIndex((c) => c.text === text);
const cites = [
  { i: inicio('Lei 6.830/1980, art. 40'), pos: 'q1', speed: 0.6 },
  { i: inicio('Súmula 360 · STJ'), pos: 'q2', speed: 0.9 },
  { i: inicio('Tema 444 · STJ'), pos: 'q3', speed: 0.45 },
].map((c) => ({ ...c, ...citacoes[c.i] }));
---

<section id="a-base" class="scene" data-parallax aria-labelledby="base-title">
  <div class="scene-stage" data-chips={JSON.stringify(citacoes)} data-chips-mode="pagina">
    <div class="lens-layer" data-speed="-0.3">
      <div class="lens-base">
        <Photo name="lombadas" sizes="100vw" />
      </div>
    </div>

    {
      cites.map((c, i) => (
        <div class:list={['cite-pos', c.pos]} data-speed={c.speed} aria-hidden="true">
          <div class="cite-swap" data-chip data-chip-i={c.i}>
            <div class="cite" style={`--d:${6 + i * 1.4}s; --r:${i % 2 ? 3 : -4}deg`}>
              <span class="cite-k" data-chip-kind>{c.kind}</span>
              <span class="cite-t" data-chip-text>{c.text}</span>
              <span class="cite-bar" />
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="wrap scene-copy">
    <div class="scene-card" data-reveal>
      <h2 id="base-title" class="display-lg" data-split>Códigos, súmulas e julgados a uma pergunta de distância.</h2>
      <p class="lead">
        O plugin consulta a base jurídica por você e devolve cada resposta com a referência ao lado, para você
        conferir antes de usar.
      </p>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .scene-stage {
    position: relative;
    height: clamp(340px, 52vw, 620px);
    overflow: hidden;
    background: var(--ink);
  }
  .lens-layer {
    position: absolute;
    left: 0;
    width: 100%;
    top: -12%;
    height: 124%;
    will-change: transform;
  }
  .lens-base {
    position: absolute;
    inset: 0;
  }
  .lens-layer :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Duotone da marca: foto em cinza tingida de brand. */
  .lens-base :global(.photo) {
    filter: grayscale(1) contrast(1.08) brightness(0.92);
  }
  .lens-base::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand);
    mix-blend-mode: color;
    opacity: 0.9;
  }

  .cite-pos {
    position: absolute;
    z-index: 2;
  }
  /* Camada só do motor de troca: o GSAP mexe aqui sem brigar com a flutuação do .cite. */
  .cite-swap {
    perspective: 700px;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.anim) .cite-swap {
      cursor: pointer;
    }
  }
  .q1 {
    left: 4%;
    top: 12%;
  }
  .q2 {
    right: 5%;
    bottom: 12%;
  }
  .q3 {
    right: 26%;
    top: 7%;
  }
  .cite {
    display: grid;
    gap: 4px;
    min-width: 190px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transform: rotate(var(--r));
  }
  .cite-k {
    font: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .cite-t {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 21px;
    color: var(--ink);
  }
  .cite-bar {
    display: block;
    height: 8px;
    width: 70%;
    margin-top: 4px;
    border-radius: 3px;
    background: var(--soft);
  }
  @media (max-width: 899px) {
    .q3 {
      display: none;
    }
    .cite {
      min-width: 0;
      padding: 8px 10px;
    }
    .cite-t {
      font-size: 14px;
      line-height: 18px;
    }
  }

  .scene-copy {
    position: relative;
    margin-top: calc(-1 * var(--space-6));
    padding-bottom: var(--space-8);
  }
  .scene-card {
    position: relative;
    z-index: 3;
    max-width: 720px;
    margin-inline: auto;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    text-align: center;
    justify-items: center;
  }
  .scene-card h2 {
    text-wrap: balance;
  }
  @media (min-width: 900px) {
    .scene-copy {
      margin-top: -120px;
    }
    .scene-card {
      padding: var(--space-7);
    }
  }
</style>
