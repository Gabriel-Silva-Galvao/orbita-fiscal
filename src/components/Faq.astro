---
/** Perguntas em <details>, uma aberta por vez; a primeira começa aberta. Abre e fecha deslizando. */
interface Props {
  name?: string;
}
const { name = 'faq' } = Astro.props;
---

<div class="faq" data-faq={name}>
  <slot />
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  .faq :global(details) {
    border-bottom: 1px solid var(--line);
  }
  .faq :global(summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 22px 0;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 26px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition: color 280ms ease-out;
  }
  .faq :global(summary:hover) {
    color: var(--brand);
  }
  .faq :global(summary::-webkit-details-marker) {
    display: none;
  }
  .faq :global(summary::after) {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-round);
    border: 1px solid var(--line-strong);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1;
    font-weight: 400;
    color: var(--brand);
    transition:
      transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 300ms ease-out,
      color 300ms ease-out;
  }
  .faq :global(details[open] summary::after) {
    transform: rotate(135deg);
    background: var(--brand);
    color: var(--on-brand);
    border-color: var(--brand);
  }
  .faq :global(.faq-a) {
    overflow: hidden;
  }
  .faq :global(.faq-a p) {
    padding: 0 0 22px;
    max-width: 720px;
    font: var(--text-body);
    font-size: 15px;
    line-height: 24px;
    color: var(--mute);
  }
  .faq :global(.faq-a a) {
    color: var(--brand);
  }
</style>

<script>
  // Uma pergunta aberta por vez, com altura animada (sem animação se a pessoa pediu movimento reduzido).
  const animate = document.documentElement.classList.contains('anim');
  const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';

  const close = (d: HTMLDetailsElement) => {
    const body = d.querySelector<HTMLElement>('.faq-a');
    if (!animate || !body) return void (d.open = false);
    const h = body.offsetHeight;
    body.animate([{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }], { duration: 220, easing: EASE }).onfinish =
      () => (d.open = false);
  };
  const open = (d: HTMLDetailsElement) => {
    d.open = true;
    const body = d.querySelector<HTMLElement>('.faq-a');
    if (!animate || !body) return;
    const h = body.offsetHeight;
    body.animate(
      [
        { height: '0px', opacity: 0 },
        { height: `${h}px`, opacity: 1 },
      ],
      { duration: 300, easing: EASE },
    );
  };

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('details'));
    items.forEach((d) => {
      d.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (d.open) close(d);
        else {
          items.forEach((o) => o !== d && o.open && close(o));
          open(d);
        }
      });
    });
  });
</script>
