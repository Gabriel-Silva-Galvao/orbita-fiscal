---
/** Entrar da equipe (docs/suporte-e-admin.md, seção 2): login separado do cliente. Estrutura para discussão. */
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
export const prerender = false;
---

<Base title="Entrar · Equipe Órbita" description="Acesso da equipe (estrutura para discussão)." noindex>
  <main class="ent">
    <div class="ent-cx">
      <div class="ent-logo"><Logo /><span>Equipe</span></div>
      <p class="ent-aviso">Estrutura para discussão: este formulário não envia nada.</p>
      <form method="post" class="ent-form" data-demo>
        <h1>Acesso da equipe</h1>
        <ol class="ent-passos">
          <li class="on">E-mail e senha</li>
          <li>Segundo fator: app autenticador ou chave física</li>
        </ol>
        <label for="e-email">E-mail da equipe</label>
        <input id="e-email" type="email" autocomplete="username" />
        <label for="e-senha">Senha</label>
        <input id="e-senha" type="password" autocomplete="current-password" />
        <button type="submit" disabled>Continuar</button>
        <p class="ent-nota">
          Sem "lembrar de mim". Sessão de 30 minutos sem uso e no máximo 8 horas. Esta conta não abre o Portal do cliente, e a do
          cliente não abre esta.
        </p>
      </form>
      <a class="ent-link" href="/equipe">Ver as telas (demonstração)</a>
    </div>
  </main>
</Base>

<script>
  document.querySelectorAll('form[data-demo]').forEach((f) => f.addEventListener('submit', (e) => e.preventDefault()));
</script>

<style>
  .ent {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px max(16px, 4vw);
    background: var(--bg);
  }
  .ent-cx {
    width: min(420px, 100%);
    display: grid;
    gap: 16px;
  }
  .ent-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ent-logo span {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .ent-aviso {
    margin: 0;
    padding: 8px 12px;
    border: 1px dashed var(--line-strong, var(--line));
    border-radius: 10px;
    font-size: 0.8125rem;
    color: var(--mute);
  }
  .ent-form {
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .ent-form h1 {
    margin: 0 0 6px;
    font-family: var(--font-display, inherit);
    font-weight: 400;
    font-size: 1.6rem;
  }
  .ent-passos {
    margin: 0 0 8px;
    padding-left: 1.2em;
    color: var(--mute);
    font-size: 0.875rem;
  }
  .ent-passos .on {
    color: var(--ink);
    font-weight: 600;
  }
  .ent-form label {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ent-form input {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
  }
  .ent-form button {
    margin-top: 8px;
    font: inherit;
    font-weight: 600;
    padding: 11px;
    border: 0;
    border-radius: 10px;
    background: var(--brand);
    color: var(--on-brand, var(--bg));
    cursor: not-allowed;
  }
  .ent-nota {
    margin: 6px 0 0;
    font-size: 0.8125rem;
    color: var(--mute);
  }
  .ent-link {
    justify-self: center;
    color: var(--mute);
    font-size: 0.875rem;
  }
</style>
