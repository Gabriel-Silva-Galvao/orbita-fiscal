# Copie para api/.env. Sem este arquivo, a API usa os valores padrão abaixo.

# Use 127.0.0.1, não localhost: no Windows, localhost tenta o IPv6 antes e cada chamada atrasa ~2 s.
# Endereço do Asaas. Enquanto não houver conta (sem CNPJ), aponta para a simulação que roda
# dentro desta própria API. Sandbox real: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=http://127.0.0.1:8000/asaas-sim/v3

# Chave da API do Asaas (header access_token). Sandbox começa com $aact_hmlg_, produção com $aact_prod_.
# A simulação aceita só esta chave fixa.
ASAAS_API_KEY=$aact_hmlg_simulacao_orbita

# Liga a simulação do Asaas em /asaas-sim/v3. Desligue em produção.
ASAAS_SIM_ENABLED=true

# Token que o Asaas envia no cabeçalho asaas-access-token de cada webhook (32 a 255 caracteres).
# Em produção, gere um valor secreto e use o mesmo no cadastro do webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=orbita-simulacao-token-do-webhook-0001

# Endereço público desta API (o webhook é cadastrado em {API_PUBLIC_URL}/webhooks/asaas).
API_PUBLIC_URL=http://127.0.0.1:8000

# Banco SQLite com assinantes, assinaturas e eventos recebidos.
DATABASE_PATH=orbita.db

# Conta e login (etapa 7a).
# Endereço do site, liberado no CORS com cookies.
SITE_URL=http://localhost:4321
# Cookies só por HTTPS. Em produção: true.
COOKIE_SECURE=false
# Só em desenvolvimento: devolve o código de 6 dígitos na resposta, já que ainda não há envio de e-mail.
# Em produção: false (o código só pode chegar pelo e-mail).
AUTH_CODIGO_NA_RESPOSTA=true

# Envio do código de verificação (2FA) por e-mail, via SMTP do provedor (Gmail/Workspace, Microsoft 365,
# SendGrid, Amazon SES, Brevo...). Sem SMTP_HOST, o código vai só para o log da API.
# Porta 587 com STARTTLS (SMTP_SSL=false) ou 465 com SSL (SMTP_SSL=true). A senha fica só aqui, nunca no código.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Órbita <nao-responda@orbitafiscal.com.br>
